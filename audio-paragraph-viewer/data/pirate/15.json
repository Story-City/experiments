ragraphs":[{"i":0,"text":"You throw your doubts overboard and embrace her in a big hug. Welcome to the crew!","isAppLine":false,"small":{"start":0.192,"end":6.24,"frac":1.0,"status":"ok","matched":16,"words":16},"large":{"start":0.192,"end":5.728,"frac":1.0,"status":"ok","matched":16,"words":16},"differ":true},{"i":1,"text":"“Glad to be of service! I’ll meet you at the ship, but first things first, I should make sure this rum is well…supervised”.","isAppLine":false,"small":{"start":6.656,"end":13.34,"frac":0.958,"status":"ok","matched":23,"words":24},"large":{"start":6.656,"end":12.52,"frac":1.0,"status":"ok","matched":24,"words":24},"differ":true},{"i":2,"text":"Like father, like daughter. It’s enough to bring a tear to your glass eye.","isAppLine":false,"small":{"start":13.44,"end":18.88,"frac":1.0,"status":"ok","matched":14,"words":14},"large":{"start":13.44,"end":18.84,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":false},{"i":3,"text":"But there’s no time to weep like a baby! Neckbeard is still out there recruiting his own pirates. If you're going to beat him to the treasure you'll need to set sail on the next tide.","isAppLine":false,"small":{"start":19.232,"end":27.52,"frac":0.944,"status":"ok","matched":34,"words":36},"large":{"start":19.232,"end":27.4,"frac":1.0,"status":"ok","matched":36,"words":36},"differ":false},{"i":4,"text":"There are two scurvy dogs you've worked with in the past. But you'll only have time to acquire one of these pirates. There's a navigator, and a quartermaster.","isAppLine":false,"small":{"start":28.32,"end":36.544,"frac":1.0,"status":"ok","matched":28,"words":28},"large":{"start":28.32,"end":36.544,"frac":1.0,"status":"ok","matched":28,"words":28},"differ":false},{"i":5,"text":"Who is more essential?","isAppLine":true,"small":{"start":38.112,"end":39.648,"frac":1.0,"status":"ok","matched":4,"words":4},"large":{"start":38.112,"end":39.648,"frac":1.0,"status":"ok","matched":4,"words":4},"differ":false},{"i":6,"text":"Look for the navigator, a man of science, who will help plot your course.","isAppLine":true,"small":{"start":40.224,"end":44.416,"frac":1.0,"status":"ok","matched":14,"words":14},"large":{"start":40.224,"end":44.416,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":false},{"i":7,"text":"Or","isAppLine":true,"small":{"start":44.832,"end":45.2,"frac":1.0,"status":"ok","matched":1,"words":1},"large":{"start":44.832,"end":45.0,"frac":1.0,"status":"ok","matched":1,"words":1},"differ":false},{"i":8,"text":"Look for the quartermaster, a fearsome fighter, who will help steer the ship.","isAppLine":true,"small":{"start":45.824,"end":50.304,"frac":1.0,"status":"ok","matched":13,"words":13},"large":{"start":45.824,"end":50.304,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/68fbf30d9cca7_JM5.jpg"}