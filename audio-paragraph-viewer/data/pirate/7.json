0.003,0.002,0.001,0.001,0.001,0.001,0.001,0.001,0.001,0.001,0.001,0.001,0.005],"paragraphs":[{"i":0,"text":"A conjunction of librarians barrels towards you, staple guns and rulers in hand.","isAppLine":false,"small":{"start":0.352,"end":5.184,"frac":1.0,"status":"ok","matched":13,"words":13},"large":{"start":0.352,"end":5.184,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false},{"i":1,"text":"You quickly fall to your knees and shout up to the Kraken to take mercy upon you and save you from librarian law. After all, they have no regard for the sea, and you are its humble acolyte.","isAppLine":false,"small":{"start":5.76,"end":17.38,"frac":1.0,"status":"ok","matched":38,"words":38},"large":{"start":5.76,"end":17.34,"frac":1.0,"status":"ok","matched":38,"words":38},"differ":false},{"i":2,"text":"For a moment, you’re not sure if it heard you, as the librarians race across the street–mere feet away from you. But as you wince, expecting stapler-filled pain, a portal opens up and swallows the entire group of book jockeys whole.","isAppLine":false,"small":{"start":17.728,"end":31.808,"frac":0.977,"status":"ok","matched":42,"words":43},"large":{"start":17.728,"end":31.808,"frac":1.0,"status":"ok","matched":43,"words":43},"differ":false},{"i":3,"text":"Praise be the Kraken’s feeling merciful.","isAppLine":false,"small":{"start":32.544,"end":35.68,"frac":1.0,"status":"ok","matched":6,"words":6},"large":{"start":32.544,"end":35.68,"frac":1.0,"status":"ok","matched":6,"words":6},"differ":false},{"i":4,"text":"You take a quick photo with the portal to add to your pirate coat of arms before it snaps shut. This will show all your future enemies what they can expect if they try to mess with you again!","isAppLine":false,"small":{"start":36.256,"end":47.04,"frac":1.0,"status":"ok","matched":39,"words":39},"large":{"start":36.256,"end":47.04,"frac":1.0,"status":"ok","matched":39,"words":39},"differ":false},{"i":5,"text":"Open your Pirate Captain App to take your photo!","isAppLine":true,"small":{"start":47.904,"end":50.784,"frac":1.0,"status":"ok","matched":9,"words":9},"large":{"start":47.904,"end":50.784,"frac":1.0,"status":"ok","matched":9,"words":9},"differ":false},{"i":6,"text":"⚠️ Don't forget, download each photo right after you take it, or risk losing that masterpiece to the digital deep.","isAppLine":true,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":19},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":19},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/68f929b5bdcbd_PC%20JM3.png"}