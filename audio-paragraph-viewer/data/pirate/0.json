76,0.018,0.022,0.017,0.008,0.021,0.007,0.001,0.001,0.0,0.0,0.001,0.0,0.0,0.0],"paragraphs":[{"i":0,"text":"You borrowed the treasure map in your hand from this building in the same sense that you \"borrow\" money from people you rob at swordpoint. You’re a pirate Captain, you don’t bother with things like asking .","isAppLine":false,"small":{"start":0.32,"end":13.14,"frac":0.972,"status":"ok","matched":35,"words":36},"large":{"start":0.32,"end":12.98,"frac":1.0,"status":"ok","matched":36,"words":36},"differ":false},{"i":1,"text":"Your ship The Sea Cat is docked on the largest waterfront this city has to offer - your sea-warping conk shell makes that easy, you can just jump between any body of water you want by blowing the horn and opening a portal. But you’ll need more than your portals to chase this particular treasure. You need supplies, and you need crew.","isAppLine":false,"small":{"start":13.792,"end":34.912,"frac":0.935,"status":"ok","matched":58,"words":62},"large":{"start":13.792,"end":34.912,"frac":0.968,"status":"ok","matched":60,"words":62},"differ":false},{"i":2,"text":"As part of your recruitment, you also need a pirate coat of arms that strikes fear into the hearts of your enemies and rallies your rag tag gang under one banner.","isAppLine":false,"small":{"start":35.68,"end":44.256,"frac":0.935,"status":"ok","matched":29,"words":31},"large":{"start":35.68,"end":44.22,"frac":0.935,"status":"ok","matched":29,"words":31},"differ":false},{"i":3,"text":"You’ve got the design, now all that’s needed is to fill the 4 empty quadrants with images that show off the type of ship you keep and crew you’ll harbor.","isAppLine":false,"small":{"start":44.576,"end":53.8,"frac":0.967,"status":"ok","matched":29,"words":30},"large":{"start":44.576,"end":53.96,"frac":0.967,"status":"ok","matched":29,"words":30},"differ":false},{"i":4,"text":"You open your Pirate Captain App and take your first photo. Set the mood for what your crew can expect from your leadership.","isAppLine":false,"small":{"start":54.56,"end":62.08,"frac":0.957,"status":"ok","matched":22,"words":23},"large":{"start":54.56,"end":62.08,"frac":0.957,"status":"ok","matched":22,"words":23},"differ":false},{"i":5,"text":"When you hear this ping, make sure to check your Pirate Captain app to complete an activity or make a choice!","isAppLine":true,"small":{"start":63.232,"end":70.432,"frac":0.952,"status":"ok","matched":20,"words":21},"large":{"start":63.232,"end":70.432,"frac":0.952,"status":"ok","matched":20,"words":21},"differ":false},{"i":6,"text":"⚠️ Download each photo right after you take it, or risk losing that masterpiece to the digital deep.","isAppLine":true,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":17},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":17},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/69015164ae482_PC%20JM1_map.png"}