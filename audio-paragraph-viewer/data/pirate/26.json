.0,0.0,0.001,0.001,0.001],"paragraphs":[{"i":0,"text":"No one said your pirate coat of arms can’t strike fear AND hunger into the hearts of your enemies.","isAppLine":false,"small":{"start":0.256,"end":5.984,"frac":1.0,"status":"ok","matched":19,"words":19},"large":{"start":0.256,"end":5.92,"frac":1.0,"status":"ok","matched":19,"words":19},"differ":false},{"i":1,"text":"You’re basically out of time but there are librarians still hunting you, and Neckbeard's out there rounding up his own crew and gear.","isAppLine":false,"small":{"start":6.368,"end":13.536,"frac":1.0,"status":"ok","matched":23,"words":23},"large":{"start":6.368,"end":13.536,"frac":1.0,"status":"ok","matched":23,"words":23},"differ":false},{"i":2,"text":"Open your checklist. Do you think you have enough to set sail?","isAppLine":true,"small":{"start":15.2,"end":18.624,"frac":1.0,"status":"ok","matched":12,"words":12},"large":{"start":15.2,"end":18.624,"frac":1.0,"status":"ok","matched":12,"words":12},"differ":false},{"i":3,"text":"Yes, head to The Sea Cat to get ready to depart? No more faffing about, the tide is almost upon you!","isAppLine":true,"small":{"start":19.072,"end":25.96,"frac":0.952,"status":"ok","matched":20,"words":21},"large":{"start":19.072,"end":25.82,"frac":1.0,"status":"ok","matched":21,"words":21},"differ":false},{"i":4,"text":"Or","isAppLine":true,"small":{"start":26.56,"end":26.78,"frac":1.0,"status":"ok","matched":1,"words":1},"large":{"start":26.56,"end":26.56,"frac":1.0,"status":"ok","matched":1,"words":1},"differ":false},{"i":5,"text":"No, you’re willing to cut it fine to get one final edge over Neckbeard in the weapons department. Look for one final pirate for your crew – one of the most bloodthirsty pirates you know.","isAppLine":true,"small":{"start":27.584,"end":39.04,"frac":1.0,"status":"ok","matched":34,"words":34},"large":{"start":27.584,"end":39.04,"frac":1.0,"status":"ok","matched":34,"words":34},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https:/