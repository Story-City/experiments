0.001],"paragraphs":[{"i":0,"text":"Feeling satisfied at the acquisition of Ellie-Marie, you turn to leave and almost collide with Captain Neckbeard. The skeletal pirate accompanying him is grinning; Neckbeard is not. You quickly shout up to Ellie-Marie, “Verbal contracts are binding!” Then you doff your hat to Neckbeard and get out of there.","isAppLine":false,"small":{"start":0.288,"end":18.304,"frac":0.961,"status":"ok","matched":49,"words":51},"large":{"start":0.288,"end":18.304,"frac":1.0,"status":"ok","matched":51,"words":51},"differ":false},{"i":1,"text":"Choose your next destination quickly, before Neckbeard decides to send Boney Pete after you.","isAppLine":false,"small":{"start":18.816,"end":23.808,"frac":1.0,"status":"ok","matched":14,"words":14},"large":{"start":18.816,"end":23.808,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":false},{"i":2,"text":"Where to next? Look at your checklist and make your decision.","isAppLine":true,"small":{"start":25.28,"end":28.96,"frac":1.0,"status":"ok","matched":11,"words":11},"large":{"start":25.28,"end":28.96,"frac":1.0,"status":"ok","matched":11,"words":11},"differ":false},{"i":3,"text":"Make a beeline for the head cook. Nabbing him would annoy Neckbeard and few things please you more than rustling his jimmies.","isAppLine":true,"small":{"start":29.664,"end":37.664,"frac":0.955,"status":"ok","matched":21,"words":22},"large":{"start":29.664,"end":37.664,"frac":1.0,"status":"ok","matched":22,"words":22},"differ":false},{"i":4,"text":"Or","isAppLine":true,"small":{"start":38.08,"end":38.42,"frac":1.0,"status":"ok","matched":1,"words":1},"large":{"start":38.08,"end":38.24,"frac":1.0,"status":"ok","matched":1,"words":1},"differ":false},{"i":5,"text":"Look for the quartermaster, a fearsome fighter, who will help steer the ship.","isAppLine":true,"small":{"start":48.64,"end":52.832,"frac":1.0,"status":"ok","matched":13,"words":13},"large":{"start":48.64,"end":52.832,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false}],"unassigned":{"small":[{"start":38.78,"end":48.02,"words":27,"text":"head to the local liquor establishment where you can order that shipment of rum to make doubly sure your crew perks are more attractive than neckbeards or"}],"large":[{"start":38.24,"end":48.18,"words":27,"text":"head to the local liquor establishment where you can order that shipment of rum to make doubly sure your crew perks are more attractive than neckbeards or"}]},"image":"https://creator.storycity.app/media/68fbf2cbe9211_JM4.jpg"}