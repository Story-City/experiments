18,0.001,0.001,0.001,0.0,0.001,0.001,0.001,0.0],"paragraphs":[{"i":0,"text":"\"Are they… legal?\"","isAppLine":false,"small":{"start":0.32,"end":1.56,"frac":1.0,"status":"ok","matched":3,"words":3},"large":{"start":0.32,"end":1.5,"frac":1.0,"status":"ok","matched":3,"words":3},"differ":false},{"i":1,"text":"You just wink. She looks up exchange rates on her phone, raises her eyebrows, and seals the deal.","isAppLine":false,"small":{"start":2.464,"end":9.088,"frac":1.0,"status":"ok","matched":18,"words":18},"large":{"start":2.464,"end":9.06,"frac":1.0,"status":"ok","matched":18,"words":18},"differ":false},{"i":2,"text":"You text your first mate and tell her to expect a delivery of new rope. She responds saying the few crew you do have are getting rowdy. We’re gonna need rum to keep em in line sooner rather than later, the good stuff tho .","isAppLine":false,"small":{"start":9.376,"end":22.016,"frac":0.955,"status":"ok","matched":42,"words":44},"large":{"start":9.376,"end":22.016,"frac":0.955,"status":"ok","matched":42,"words":44},"differ":false},{"i":3,"text":"Before you can add rum to your checklist the familiar voice of Captain Neckbeard has you hiding again. Neckbeard is angrily berating one of his undead crewmates, a skeleton named Boney Pete for being a rubbish lookout, which is pretty harsh, considering poor Petey has no eyes.","isAppLine":false,"small":{"start":22.496,"end":39.616,"frac":1.0,"status":"ok","matched":47,"words":47},"large":{"start":22.496,"end":39.616,"frac":1.0,"status":"ok","matched":47,"words":47},"differ":false},{"i":4,"text":"Neckbeard’s looking for a lookout - you can’t let him beat you to the best. But if the few crew you do currently have start a mutiny, then you're cooked before you’ve even gotten started.","isAppLine":false,"small":{"start":39.968,"end":52.192,"frac":0.971,"status":"ok","matched":33,"words":34},"large":{"start":39.968,"end":52.192,"frac":1.0,"status":"ok","matched":34,"words":34},"differ":false},{"i":5,"text":"Do you:","isAppLine":true,"small":{"start":53.536,"end":54.02,"frac":1.0,"status":"ok","matched":2,"words":2},"large":{"start":53.536,"end":54.18,"frac":1.0,"status":"ok","matched":2,"words":2},"differ":false},{"i":6,"text":"Race to one of the high points of the area, to nab the city’s best lookout before Neckbeard?","isAppLine":true,"small":{"start":54.656,"end":59.62,"frac":1.0,"status":"ok","matched":18,"words":18},"large":{"start":54.656,"end":59.58,"frac":1.0,"status":"ok","matched":18,"words":18},"differ":false},{"i":7,"text":"Or","isAppLine":true,"small":{"start":59.936,"end":60.2,"frac":1.0,"status":"ok","matched":1,"words":1},"large":{"start":59.936,"end":60.06,"frac":1.0,"status":"ok","matched":1,"words":1},"differ":false},{"i":8,"text":"Head to the best liquor establishment in town, where you can organize a shipment of rum that might lure your potential crew away from Neckbeard with a quality drop?","isAppLine":true,"small":{"start":60.896,"end":69.504,"frac":1.0,"status":"ok","matched":29,"words":29},"large":{"start":60.896,"end":69.504,"frac":1.0,"status":"ok","matched":29,"words":29},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/68fbeed81a9e7_JM2.jpg"}