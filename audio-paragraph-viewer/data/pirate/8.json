001,0.001,0.001,0.001,0.001,0.001,0.001,0.001,0.001,0.005],"paragraphs":[{"i":0,"text":"A conjunction of librarians barrels towards you, staple guns and rulers in hand.","isAppLine":false,"small":{"start":0.32,"end":5.376,"frac":0.923,"status":"ok","matched":12,"words":13},"large":{"start":0.32,"end":5.32,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false},{"i":1,"text":"You call up to the Kraken, reminding it you’ll never see your family again because it decided to trap you in the future. The least it could do is stop you from suffering librarian law.","isAppLine":false,"small":{"start":5.536,"end":15.744,"frac":1.0,"status":"ok","matched":35,"words":35},"large":{"start":5.536,"end":15.744,"frac":1.0,"status":"ok","matched":35,"words":35},"differ":false},{"i":2,"text":"For a moment, you’re not sure if it heard you, as the librarians race across the street–mere feet away from you. But as you wince, expecting stapler-filled pain, a portal opens up and swallows the entire group of book jockeys whole.","isAppLine":false,"small":{"start":16.48,"end":29.0,"frac":0.977,"status":"ok","matched":42,"words":43},"large":{"start":16.48,"end":29.12,"frac":1.0,"status":"ok","matched":43,"words":43},"differ":false},{"i":3,"text":"Is that a tinge of guilt in the Demigod’s eyes?","isAppLine":false,"small":{"start":29.76,"end":32.992,"frac":0.9,"status":"ok","matched":9,"words":10},"large":{"start":29.76,"end":32.98,"frac":1.0,"status":"ok","matched":10,"words":10},"differ":false},{"i":4,"text":"You take a quick photo with the portal to add to your pirate coat of arms before it snaps shut. This will show all your future enemies what they can expect if they try to mess with you again!","isAppLine":false,"small":{"start":33.504,"end":44.256,"frac":1.0,"status":"ok","matched":39,"words":39},"large":{"start":33.504,"end":44.256,"frac":1.0,"status":"ok","matched":39,"words":39},"differ":false},{"i":5,"text":"Open your Pirate Captain App to take your photo!","isAppLine":true,"small":{"start":45.152,"end":48.0,"frac":1.0,"status":"ok","matched":9,"words":9},"large":{"start":45.152,"end":48.0,"frac":1.0,"status":"ok","matched":9,"words":9},"differ":false},{"i":6,"text":"⚠️ Don't forget, download each photo right after you take it, or risk losing that masterpiece to the digital deep.","isAppLine":true,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":19},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":19},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/68f929c38d49c_PC%20JM3.png"}