],"paragraphs":[{"i":0,"text":"As you step back out into the fresh air a young woman in striped pants is waiting for you. She looks familiar. \"Paying your respects to Dad?\"","isAppLine":false,"small":{"start":0.256,"end":8.992,"frac":1.0,"status":"ok","matched":27,"words":27},"large":{"start":0.256,"end":8.992,"frac":1.0,"status":"ok","matched":27,"words":27},"differ":false},{"i":1,"text":"Now you remember. This is Mick's daughter. You mumble something apologetic.","isAppLine":false,"small":{"start":9.376,"end":14.016,"frac":1.0,"status":"ok","matched":11,"words":11},"large":{"start":9.376,"end":14.016,"frac":1.0,"status":"ok","matched":11,"words":11},"differ":false},{"i":2,"text":"\"You've nothing to apologize for. Dad always said you were a good captain. Which is why I want to join your crew.\"","isAppLine":false,"small":{"start":14.464,"end":21.28,"frac":1.0,"status":"ok","matched":22,"words":22},"large":{"start":14.464,"end":21.28,"frac":1.0,"status":"ok","matched":22,"words":22},"differ":false},{"i":3,"text":"Oh this is awkward, on one hand you could use the help, but being a pirate is dangerous, and Mick’s daughter could end up just like her dad.","isAppLine":false,"small":{"start":21.888,"end":31.232,"frac":1.0,"status":"ok","matched":28,"words":28},"large":{"start":21.888,"end":31.232,"frac":1.0,"status":"ok","matched":28,"words":28},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/68f92a6b246f0_PC%20JM5.png"}