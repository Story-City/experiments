.19,0.178,0.19,0.16,0.159,0.163,0.146,0.145,0.188,0.187,0.141,0.198,0.176,0.141,0.132,0.125,0.102,0.09,0.066,0.043,0.037,0.028,0.021,0.016,0.012,0.009,0.005,0.003,0.001],"paragraphs":[{"i":0,"text":"Welcome to Tales from the Incident.","isAppLine":false,"small":{"start":0.768,"end":2.976,"frac":1.0,"status":"ok","matched":6,"words":6},"large":{"start":0.768,"end":2.976,"frac":1.0,"status":"ok","matched":6,"words":6},"differ":false},{"i":1,"text":"Every street has a story. Most people just walk past them. You won’t.","isAppLine":false,"small":{"start":3.808,"end":9.024,"frac":1.0,"status":"ok","matched":13,"words":13},"large":{"start":3.808,"end":9.024,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false},{"i":2,"text":"There’s more than one way to follow a story like this.","isAppLine":false,"small":{"start":10.016,"end":12.864,"frac":1.0,"status":"ok","matched":11,"words":11},"large":{"start":10.016,"end":12.864,"frac":1.0,"status":"ok","matched":11,"words":11},"differ":false},{"i":3,"text":"By default, it’s tied to the city. You’ll move from place to place, unlocking each moment where it happened. We call this, Location Mode.","isAppLine":false,"small":{"start":13.536,"end":22.08,"frac":1.0,"status":"ok","matched":24,"words":24},"large":{"start":13.536,"end":22.08,"frac":1.0,"status":"ok","matched":24,"words":24},"differ":false},{"i":4,"text":"When you hear [ SFX walking alert ], it’s time to head to the next location. Check the map in the Story City app to see where the story goes next.","isAppLine":false,"small":{"start":22.688,"end":30.4,"frac":0.897,"status":"ok","matched":26,"words":29},"large":{"start":22.688,"end":30.4,"frac":0.897,"status":"ok","matched":26,"words":29},"differ":false},{"i":5,"text":"If you’d rather not follow the route, there’s another option.","isAppLine":false,"small":{"start":31.104,"end":34.08,"frac":1.0,"status":"ok","matched":10,"words":10},"large":{"start":31.104,"end":34.08,"frac":1.0,"status":"ok","matched":10,"words":10},"differ":false},{"i":6,"text":"Step Count Mode lets you walk anywhere. The story moves with your steps, not your location.","isAppLine":false,"small":{"start":34.688,"end":40.544,"frac":1.0,"status":"ok","matched":16,"words":16},"large":{"start":34.688,"end":40.54,"frac":1.0,"status":"ok","matched":16,"words":16},"differ":false},{"i":7,"text":"To switch between modes, tap the blue link on your screen for instructions, otherwise the story will use the mode you selected when you first opened the app.","isAppLine":false,"small":{"start":41.184,"end":49.42,"frac":1.0,"status":"ok","matched":28,"words":28},"large":{"start":41.184,"end":49.376,"frac":1.0,"status":"ok","matched":28,"words":28},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/6ab6d67bab537_Ep5_Intro-1.jpg"}