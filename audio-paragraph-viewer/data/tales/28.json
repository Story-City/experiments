.46,"end":40.608,"frac":0.889,"status":"ok","matched":8,"words":9},"large":{"start":38.06,"end":40.608,"frac":0.889,"status":"ok","matched":8,"words":9},"differ":false},{"i":6,"text":"LERATO: … You really should cool it on the doom-and-gloom stuff, Fair.","isAppLine":false,"small":{"start":50.752,"end":53.632,"frac":0.846,"status":"ok","matched":11,"words":13},"large":{"start":49.140000000000015,"end":53.46,"frac":0.846,"status":"ok","matched":11,"words":13},"differ":true},{"i":7,"text":"FARRON: Why? That guy deserved it, I’m not gonna ruin my professional integrity for him.","isAppLine":false,"small":{"start":53.952,"end":58.912,"frac":0.867,"status":"ok","matched":13,"words":15},"large":{"start":53.952,"end":58.912,"frac":0.867,"status":"ok","matched":13,"words":15},"differ":false},{"i":8,"text":"LERATO: Says the criminal. He might pay, but he could just as easily join those protestors over there with their anti-seer, anti-fae bullshit. Still holding on to the Severing, like it wasn’t 20-year-old news.","isAppLine":false,"small":{"start":59.328,"end":73.856,"frac":0.921,"status":"ok","matched":35,"words":38},"large":{"start":59.328,"end":73.856,"frac":0.895,"status":"ok","matched":34,"words":38},"differ":false},{"i":9,"text":"FARRON: Not my fault this country can’t handle a little truthtelling.","isAppLine":false,"small":{"start":74.464,"end":77.18,"frac":0.727,"status":"ok","matched":8,"words":11},"large":{"start":74.464,"end":77.12,"frac":0.818,"status":"ok","matched":9,"words":11},"differ":false},{"i":10,"text":"LERATO: I’m serious. You heard, right? An unlicensed seer got thrown off a balcony nearby last week. It’s only going to get worse at the Severing anniversary in a few days.","isAppLine":false,"small":{"start":77.18,"end":88.032,"frac":0.968,"status":"ok","matched":30,"words":31},"large":{"start":77.12,"end":88.032,"frac":0.968,"status":"ok","matched":30,"words":31},"differ":false},{"i":11,"text":"FARRON: I thought that was a suicide…","isAppLine":false,