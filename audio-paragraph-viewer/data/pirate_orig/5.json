597,0.18,0.029,0.024,0.157,0.409,0.396,0.219,0.297,0.1,0.012,0.008,0.009,0.006,0.006,0.003,0.003,0.008],"paragraphs":[{"i":0,"text":"You hear the bosun before you see him. His deep voice echoes up to the whales and down again, singing a sea shanty you recognise called ‘Lowlands Low’. A family with young children walk past, only the kids paying any attention to the old man hollering up at the whales.","isAppLine":false,"small":{"start":0.8,"end":18.816,"frac":0.98,"status":"ok","matched":49,"words":50},"large":{"start":0.8,"end":18.816,"frac":1.0,"status":"ok","matched":50,"words":50},"differ":false},{"i":1,"text":"The song’s a halyard shanty with a rhythm perfect for singing while you haul the sails aloft. Most of a bosun’s job is to supervise the crew on deck, and leading them in song is how Bosun Richards does it.","isAppLine":false,"small":{"start":20.288,"end":35.008,"frac":0.925,"status":"ok","matched":37,"words":40},"large":{"start":20.288,"end":35.008,"frac":1.0,"status":"ok","matched":40,"words":40},"differ":false},{"i":2,"text":"“The monkey wears a soldier’s clothes,","isAppLine":false,"small":{"start":37.696,"end":40.0,"frac":0.833,"status":"ok","matched":5,"words":6},"large":{"start":37.696,"end":39.9,"frac":0.833,"status":"ok","matched":5,"words":6},"differ":false},{"i":3,"text":"Where he got ’em from, God only knows.","isAppLine":false,"small":{"start":40.0,"end":42.36,"frac":0.875,"status":"ok","matched":7,"words":8},"large":{"start":39.9,"end":42.24,"frac":0.875,"status":"ok","matched":7,"words":8},"differ":false},{"i":4,"text":"Our skipper comes from Barbados,","isAppLine":false,"small":{"start":42.36,"end":44.608,"frac":0.8,"status":"ok","matched":4,"words":5},"large":{"start":42.24,"end":44.44,"frac":1.0,"status":"ok","matched":5,"words":5},"differ":false},{"i":5,"text":"He’s got the name of Hammer Toes,","isAppLine":false,"small":{"start":45.248,"end":47.2,"frac":1.0,"status":"ok","matched":7,"words":7},"large":{"start":45.248,"end":47.06,"frac":0.857,"status":"ok","matched":6,"words":7},"differ":false},{"i":6,"text":"He feeds us bread as hard as brass,","isAppLine":false,"small":{"start":47.648,"end":49.696,"frac":0.875,"status":"ok","matched":7,"words":8},"large":{"start":47.06,"end":49.58,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":true},{"i":7,"text":"Tastes salty as a sailor’s –”","isAppLine":false,"small":{"start":50.176,"end":52.032,"frac":1.0,"status":"ok","matched":5,"words":5},"large":{"start":50.176,"end":51.86,"frac":1.0,"status":"ok","matched":5,"words":5},"differ":false},{"i":8,"text":"You choose that moment to interrupt Bosun Richards, and save the passing children from learning a scandalous new phrase to try in the playground.","isAppLine":false,"small":{"start":52.736,"end":61.632,"frac":1.0,"status":"ok","matched":24,"words":24},"large":{"start":52.736,"end":61.632,"frac":1.0,"status":"ok","matched":24,"words":24},"differ":false},{"i":9,"text":"“It’s bad luck to interrupt a sailor while he’s singing,” says Richards, always a superstitious man.","isAppLine":false,"small":{"start":62.592,"end":69.184,"frac":0.938,"status":"ok","matched":15,"words":16},"large":{"start":62.592,"end":69.184,"frac":1.0,"status":"ok","matched":16,"words":16},"differ":false},{"i":10,"text":"“You can hardly be called a sailor while you’re ashore.”","isAppLine":false,"small":{"start":70.432,"end":72.896,"frac":1.0,"status":"ok","matched":10,"words":10},"large":{"start":70.432,"end":72.896,"frac":1.0,"status":"ok","matched":10,"words":10},"differ":false},{"i":11,"text":"“That’s true enough,” he says. “Here I’m just a crusty old man who knows a lot of crusty old songs. Do you know ‘Good Ship Venus’? I’ll sing it for you, if you like.”","isAppLine":false,"small":{"start":73.792,"end":85.152,"frac":1.0,"status":"ok","matched":34,"words":34},"large":{"start":73.792,"end":85.152,"frac":1.0,"status":"ok","matched":34,"words":34},"differ":false},{"i":12,"text":"You think of a word that rhymes with “Venus” and decide against it. “I’m considering setting sail soon. Possibly.”","isAppLine":false,"small":{"start":86.592,"end":93.98,"frac":1.0,"status":"ok","matched":19,"words":19},"large":{"start":86.592,"end":93.98,"frac":1.0,"status":"ok","matched":19,"words":19},"differ":false},{"i":13,"text":"“It would be bad luck to sail without a bosun,” says Richards. “Especially a bosun who knows sea shanties.”","isAppLine":false,"small":{"start":95.776,"end":103.008,"frac":0.842,"status":"ok","matched":16,"words":19},"large":{"start":95.776,"end":103.008,"frac":1.0,"status":"ok","matched":19,"words":19},"differ":false},{"i":14,"text":"“Are they valuable though? I don’t think so, I thought they were a bunch of rhymes to keep the crew’s minds occupied while they work.”","isAppLine":false,"small":{"start":104.736,"end":112.8,"frac":1.0,"status":"ok","matched":25,"words":25},"large":{"start":104.736,"end":112.8,"frac":1.0,"status":"ok","matched":25,"words":25},"differ":false},{"i":15,"text":"“Not valuable? Shanties are full of wisdom! If it weren’t for ‘What Do We Do With A Drunken Sailor’ how would anyone know what to do with a drunken sailor?”","isAppLine":false,"small":{"start":115.264,"end":126.24,"frac":1.0,"status":"ok","matched":30,"words":30},"large":{"start":115.264,"end":126.24,"frac":1.0,"status":"ok","matched":30,"words":30},"differ":false},{"i":16,"text":"You concede the point. “There’s room for a bosun fine as Richards on The Sea Cat any time…”","isAppLine":false,"small":{"start":127.872,"end":134.208,"frac":0.944,"status":"ok","matched":17,"words":18},"large":{"start":127.872,"end":134.04,"frac":0.944,"status":"ok","matched":17,"words":18},"differ":false},{"i":17,"text":"“Is there? Well, I could be interested… Hypothetically speaking. Possibly.”","isAppLine":false,"small":{"start":135.296,"end":141.76,"frac":0.9,"status":"ok","matched":9,"words":10},"large":{"start":135.296,"end":141.46,"frac":1.0,"status":"ok","matched":10,"words":10},"differ":false},{"i":18,"text":"Then he raises his voice and hollers a final verse:","isAppLine":false,"small":{"start":143.488,"end":146.4,"frac":1.0,"status":"ok","matched":10,"words":10},"large":{"start":141.46,"end":146.4,"frac":1.0,"status":"ok","matched":10,"words":10},"differ":true},{"i":19,"text":"“It’s up aloft that yard must go,","isAppLine":false,"small":{"start":147.552,"end":149.82,"frac":0.857,"status":"ok","matched":6,"words":7},"large":{"start":147.552,"end":149.34,"frac":0.571,"status":"ok","matched":4,"words":7},"differ":false},{"i":20,"text":"Up aloft from down below.","isAppLine":false,"small":{"start":149.82,"end":152.9,"frac":0.8,"status":"ok","matched":4,"words":5},"large":{"start":149.34,"end":152.68,"frac":0.8,"status":"ok","matched":4,"words":5},"differ":false},{"i":21,"text":"Lowlands, me boys, and up she goes,","isAppLine":false,"small":{"start":152.9,"end":155.616,"frac":0.857,"status":"ok","matched":6,"words":7},"large":{"start":152.68,"end":155.616,"frac":0.857,"status":"ok","matched":6,"words":7},"differ":false},{"i":22,"text":"Get changed, me boys, for your sailing clothes.”","isAppLine":false,"small":{"start":156.16,"end":159.616,"frac":0.875,"status":"ok","matched":7,"words":8},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":8},"differ":true},{"i":23,"text":"You breathe a sigh of relief, thank the Kraken that’s settled and Neckbeard missed Bosun Richard’s hollering. You’re one step closer to setting sail. Across the bridge in the city you’ll find more crew and equipment, but best be quick. There might be more librarians hunting for you, and Neckbeard’s out there rounding up his own crew and gear.","isAppLine":false,"small":{"start":161.504,"end":183.296,"frac":0.983,"status":"ok","matched":58,"words":59},"large":{"start":161.504,"end":183.296,"frac":1.0,"status":"ok","matched":59,"words":59},"differ":false},{"i":24,"text":"Do you:","isAppLine":true,"small":{"start":184.608,"end":184.96,"frac":1.0,"status":"ok","matched":2,"words":2},"large":{"start":184.608,"end":184.74,"frac":1.0,"status":"ok","matched":2,"words":2},"differ":false},{"i":25,"text":"Magistrates Court: Cross Kurilpa Bridge to Magistrates Court on George Street? Pirates may not like courtrooms most of the time, but they’re a fine place to find scoundrels who’ve been dragged there for trial and may be amenable to the idea of a quick trip far away. You bet you’ll get better scoundrels for your crew there than Neckbeard the sea pig!","isAppLine":false,"small":{"start":185.856,"end":208.48,"frac":0.935,"status":"ok","matched":58,"words":62},"large":{"start":185.856,"end":208.48,"frac":0.952,"status":"ok","matched":59,"words":62},"differ":false},{"i":26,"text":"Or","isAppLine":true,"small":{"start":210.24,"end":210.36,"frac":1.0,"status":"ok","matched":1,"words":1},"large":{"start":210.24,"end":210.74,"frac":1.0,"status":"ok","matched":1,"words":1},"differ":false},{"i":27,"text":"The White Store: Cross Kurilpa Bridge to The White Store on George Street, where you can get a spare set of sails you’re likely to need for the journey in case anything happens to the ones you’ve got? Neckbeard is notorious for shooting cannon balls through those vital pieces of fabric, you need to be prepared.","isAppLine":false,"small":{"start":211.36,"end":229.696,"frac":0.839,"status":"ok","matched":47,"words":56},"large":{"start":211.36,"end":229.696,"frac":0.875,"status":"ok","matched":49,"words":56},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/wp-content/uploads/2014/07/JM10comp.jpg"}