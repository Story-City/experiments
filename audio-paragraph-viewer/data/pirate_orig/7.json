0.389,0.337,0.433,0.323,0.291,0.149,0.357,0.583,0.124,0.528,0.284,0.354,0.454,0.652,0.235,0.22,0.257,0.378,0.323,0.024,0.0,0.0],"paragraphs":[{"i":0,"text":"The Courier statue at the top of Charlotte Street looks like a rolled-up newspaper cast in stainless steel to most, but look with a pirate’s eyes and it might be a spyglass.","isAppLine":false,"small":{"start":0.288,"end":11.872,"frac":1.0,"status":"ok","matched":33,"words":33},"large":{"start":0.288,"end":11.872,"frac":1.0,"status":"ok","matched":33,"words":33},"differ":false},{"i":1,"text":"Mr Thacker, the navigator, certainly sees it that way. He’s an old-fashioned man in many respects, one who still believes in sailing by dead reckoning – starting with a fixed position and then estimating further positions based on speed and trajectory rather than, say, turning on the GPS.","isAppLine":false,"small":{"start":12.48,"end":33.056,"frac":1.0,"status":"ok","matched":48,"words":48},"large":{"start":12.48,"end":33.056,"frac":1.0,"status":"ok","matched":48,"words":48},"differ":false},{"i":2,"text":"You see Mr Thacker’s wigged head peering through one of the holes in the Courier when you cross the street towards him. You cough into your hand to attract his attention and he peers over his shoulder at you, adjusting a pair of half-moon glasses on his nose.","isAppLine":false,"small":{"start":33.76,"end":48.32,"frac":1.0,"status":"ok","matched":49,"words":49},"large":{"start":33.76,"end":48.32,"frac":1.0,"status":"ok","matched":49,"words":49},"differ":false},{"i":3,"text":"“Not interested,” he says, then returns to looking through the tiny glass porthole.","isAppLine":false,"small":{"start":48.896,"end":54.14,"frac":1.0,"status":"ok","matched":13,"words":13},"large":{"start":48.896,"end":54.176,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false},{"i":4,"text":"“Let me tell you what I’m up to, at least. I’ll make it quick. I don’t have much time anyway.”","isAppLine":false,"small":{"start":55.072,"end":60.78,"frac":1.0,"status":"ok","matched":20,"words":20},"large":{"start":55.072,"end":61.056,"frac":1.0,"status":"ok","matched":20,"words":20},"differ":false},{"i":5,"text":"“Don’t care,” he says. “Not interested in sailing any more. Even pirates like you use chronometers and your bloody smartphones for everything. No challenge in it. Harder to find your way around Brisbane than the bloody Pacific Ocean now.”","isAppLine":false,"small":{"start":61.824,"end":77.48,"frac":0.949,"status":"ok","matched":37,"words":39},"large":{"start":61.824,"end":77.6,"frac":0.974,"status":"ok","matched":38,"words":39},"differ":false},{"i":6,"text":"You take out the tiny, precious treasure map and hold it up to him. He turns from The Courier again, moving his glasses back up his nose.","isAppLine":false,"small":{"start":78.528,"end":87.712,"frac":1.0,"status":"ok","matched":27,"words":27},"large":{"start":78.528,"end":87.712,"frac":1.0,"status":"ok","matched":27,"words":27},"differ":false},{"i":7,"text":"“What’s this? That’s a terrible map. Barely readable. No measurements of longitude. Doesn’t even have a compass rose, just a measure of prevailing winds. You’d be mad trying to follow this.”","isAppLine":false,"small":{"start":88.448,"end":101.696,"frac":1.0,"status":"ok","matched":31,"words":31},"large":{"start":88.448,"end":101.696,"frac":1.0,"status":"ok","matched":31,"words":31},"differ":false},{"i":8,"text":"“Yes, you would.”","isAppLine":false,"small":{"start":102.048,"end":103.648,"frac":1.0,"status":"ok","matched":3,"words":3},"large":{"start":102.048,"end":103.648,"frac":1.0,"status":"ok","matched":3,"words":3},"differ":false},{"i":9,"text":"“Meet you on the ship,” he says. “I’ll find my own way there.” He has one more look through the glass. “Can’t see a bloody thing in this.”","isAppLine":false,"small":{"start":104.672,"end":115.264,"frac":1.0,"status":"ok","matched":28,"words":28},"large":{"start":104.672,"end":115.264,"frac":1.0,"status":"ok","matched":28,"words":28},"differ":false},{"i":10,"text":"You breathe a sigh of relief. You’re one step closer to setting sail, but best be quick. There are librarians hunting for you, and Neckbeard’s out there rounding up his own crew and gear.","isAppLine":false,"small":{"start":116.064,"end":129.28,"frac":1.0,"status":"ok","matched":34,"words":34},"large":{"start":116.064,"end":129.28,"frac":1.0,"status":"ok","matched":34,"words":34},"differ":false},{"i":11,"text":"Do you:","isAppLine":true,"small":{"start":130.208,"end":130.656,"frac":1.0,"status":"ok","matched":2,"words":2},"large":{"start":130.208,"end":130.656,"frac":1.0,"status":"ok","matched":2,"words":2},"differ":false},{"i":12,"text":"North Quay: Head to North Quay and get The Sea Cat ready to depart? No more faffing about, the tide is almost upon you!","isAppLine":false,"small":{"start":131.296,"end":139.168,"frac":0.875,"status":"ok","matched":21,"words":24},"large":{"start":131.296,"end":139.168,"frac":0.917,"status":"ok","matched":22,"words":24},"differ":false},{"i":13,"text":"Or","isAppLine":true,"small":{"start":140.288,"end":140.54,"frac":1.0,"status":"ok","matched":1,"words":1},"large":{"start":140.288,"end":140.42,"frac":1.0,"status":"ok","matched":1,"words":1},"differ":false},{"i":14,"text":"Queens Park: Decide you’re willing to cut it fine to get one final edge over Neckbeard? Head to Queens Park behind the Treasury Casino, where you can add one final pirate to your crew – one of the most bloodthirsty pirates you know.","isAppLine":false,"small":{"start":141.312,"end":157.344,"frac":0.929,"status":"ok","matched":39,"words":42},"large":{"start":141.312,"end":157.344,"frac":0.905,"status":"ok","matched":38,"words":42},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/wp-content/uploads/2014/07/JM15comp.jpg"}