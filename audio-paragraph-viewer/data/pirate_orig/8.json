451,0.406,0.122,0.021,0.409,0.505,0.494,0.281,0.541,0.36,0.47,0.458,0.35,0.342,0.319,0.388,0.06,0.003,0.0],"paragraphs":[{"i":0,"text":"In the old days rounding up a crew was easy. You’d just go to a few dockside taverns and press-gang them. Get sailors drunk enough and when they wake up on a ship in the morning they’ll believe they signed on for it.","isAppLine":false,"small":{"start":0.608,"end":13.04,"frac":1.0,"status":"ok","matched":44,"words":44},"large":{"start":0.608,"end":12.992,"frac":1.0,"status":"ok","matched":44,"words":44},"differ":false},{"i":1,"text":"But those were the bad old days and the bad old days are over. Now if you need to find someone desperate enough to join you for several months at sea in a leaky boat you need to be more subtle.","isAppLine":false,"small":{"start":14.048,"end":26.912,"frac":1.0,"status":"ok","matched":41,"words":41},"large":{"start":14.048,"end":26.912,"frac":1.0,"status":"ok","matched":41,"words":41},"differ":false},{"i":2,"text":"You lean against the distinctive sculpture of a wave made from grey toffee outside the Magistrates Court and keep your ears open. Barristers bustle past on their way in and out of the court, wearing wigs that make them look like British naval officers. (Fortunately, they don’t smell like British naval officers.) You’re hoping to hear a few key words about their clients. Theft, robbery, assault. All promising elements in the CV of a pirate.","isAppLine":false,"small":{"start":28.928,"end":61.632,"frac":0.987,"status":"ok","matched":74,"words":75},"large":{"start":28.928,"end":61.632,"frac":1.0,"status":"ok","matched":75,"words":75},"differ":false},{"i":3,"text":"It’s not long before you hear a barrister on her way to a break with a container of sushi complaining to her colleague. “He’s clearly a pirate,” she says.","isAppLine":false,"small":{"start":63.968,"end":73.44,"frac":1.0,"status":"ok","matched":29,"words":29},"large":{"start":63.968,"end":73.44,"frac":1.0,"status":"ok","matched":29,"words":29},"differ":false},{"i":4,"text":"This is a stroke of luck.","isAppLine":false,"small":{"start":74.336,"end":76.512,"frac":1.0,"status":"ok","matched":6,"words":6},"large":{"start":74.336,"end":76.512,"frac":1.0,"status":"ok","matched":6,"words":6},"differ":false},{"i":5,"text":"You see a man who looks suspicious loitering near the entrance. This must be her client. You duck over and give him a nod.","isAppLine":false,"small":{"start":77.536,"end":85.12,"frac":1.0,"status":"ok","matched":24,"words":24},"large":{"start":77.536,"end":85.12,"frac":1.0,"status":"ok","matched":24,"words":24},"differ":false},{"i":6,"text":"But when you ask what experience he’s got in piracy his answer is confusing.","isAppLine":false,"small":{"start":86.4,"end":91.104,"frac":1.0,"status":"ok","matched":14,"words":14},"large":{"start":86.4,"end":91.104,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":false},{"i":7,"text":"“I just couldn’t wait till January for season four,” he says. “The internet’s already spoilt half of it.”","isAppLine":false,"small":{"start":92.064,"end":98.592,"frac":1.0,"status":"ok","matched":18,"words":18},"large":{"start":92.064,"end":98.592,"frac":1.0,"status":"ok","matched":18,"words":18},"differ":false},{"i":8,"text":"This modern age is a confusing time, you think, at a loss for what to do.","isAppLine":false,"small":{"start":100.128,"end":105.696,"frac":1.0,"status":"ok","matched":16,"words":16},"large":{"start":100.128,"end":105.696,"frac":0.938,"status":"ok","matched":15,"words":16},"differ":false},{"i":9,"text":"Unbeknownst to you, while you’ve been chatting the librarians have set up an ambush. They’re very quiet, librarians. Famous for it. This modern day pirate seems to have been a decoy as well as useless.","isAppLine":false,"small":{"start":107.136,"end":122.56,"frac":1.0,"status":"ok","matched":35,"words":35},"large":{"start":107.136,"end":122.56,"frac":1.0,"status":"ok","matched":35,"words":35},"differ":false},{"i":10,"text":"The librarians corner you in a classic pincer movement. One group pours out of the court while another spills from a bus on George Street. They attack with a battle cry of “355 to 356! Military science, infantry forces and warfare!” Then a dozen of them are upon you with rulers, compasses, and weaponised bookmarks. You draw your cutlass and lay about you, but the blade’s immediately snapped shut between the pages of a copy of Paradoxes of Defence (George Silver, 1599) and then wrenched out of your grasp.","isAppLine":false,"small":{"start":123.616,"end":159.904,"frac":0.989,"status":"ok","matched":88,"words":89},"large":{"start":123.616,"end":159.904,"frac":0.989,"status":"ok","matched":88,"words":89},"differ":false},{"i":11,"text":"You’re left unarmed as grimacing librarians brandish safety scissors on all sides. Slowly, you raise your hands in surrender.","isAppLine":false,"small":{"start":160.64,"end":169.184,"frac":0.947,"status":"ok","matched":18,"words":19},"large":{"start":160.64,"end":169.184,"frac":0.947,"status":"ok","matched":18,"words":19},"differ":false},{"i":12,"text":"You’re marched to the library and down to its hidden sub-basement dungeon where you are locked away for the rest of your days.","isAppLine":false,"small":{"start":170.304,"end":177.408,"frac":1.0,"status":"ok","matched":24,"words":24},"large":{"start":170.304,"end":177.408,"frac":1.0,"status":"ok","matched":24,"words":24},"differ":false},{"i":13,"text":"The treasure map is returned to its rightful place and The Sea Cat never sails under you again. Your story ends here.","isAppLine":false,"small":{"start":178.816,"end":192.84,"frac":0.5,"status":"ok","matched":11,"words":22},"large":{"start":178.816,"end":187.872,"frac":1.0,"status":"ok","matched":22,"words":22},"differ":true},{"i":14,"text":"Or does it?","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":3},"large":{"start":189.408,"end":190.88,"frac":1.0,"status":"ok","matched":3,"words":3},"differ":true},{"i":15,"text":"You’re sitting in your cell and feeling sorry for yourself when you hear a rattling and see Mr Boots, the monkey, approach with the keys on a chain.","isAppLine":false,"small":{"start":192.84,"end":200.544,"frac":0.857,"status":"ok","matched":24,"words":28},"large":{"start":192.16,"end":200.544,"frac":1.0,"status":"ok","matched":28,"words":28},"differ":true},{"i":16,"text":"“Dashed hard to find you,” he says. “They’ve gone and filed you under 910.45 (ocean travel and seafaring adventures) rather than 364.164 (violent offences against property). Still, I’ll have you out in a jiffy.”","isAppLine":false,"small":{"start":201.6,"end":221.1,"frac":0.972,"status":"ok","matched":35,"words":36},"large":{"start":201.6,"end":221.056,"frac":1.0,"status":"ok","matched":36,"words":36},"differ":false},{"i":17,"text":"You make your escape with Mr Boots, promising him a promotion to lieutenant, then on to The Sea Cat to set sail. Adventure awaits","isAppLine":false,"small":{"start":222.56,"end":232.1,"frac":0.917,"status":"ok","matched":22,"words":24},"large":{"start":222.56,"end":231.9,"frac":1.0,"status":"ok","matched":24,"words":24},"differ":false},{"i":18,"text":"All you need is your fearsome pirate flag and you’re set. Remember to take a photo and upload it with the hashtags #storycity and #pirateslife.","isAppLine":false,"small":{"start":233.056,"end":244.288,"frac":0.88,"status":"ok","matched":22,"words":25},"large":{"start":233.056,"end":244.288,"frac":0.88,"status":"ok","matched":22,"words":25},"differ":false},{"i":19,"text":"-END-","isAppLine":true,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":1},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":1},"differ":false},{"i":20,"text":"This is the end of your adventure, thank you for playing Street Reads. Why not go back to the start and do another adventure? Make sure you upload your photographs to Instagram, Facebook or Twitter with the appropriate hashtag.","isAppLine":false,"small":{"start":246.12,"end":259.552,"frac":0.897,"status":"ok","matched":35,"words":39},"large":{"start":246.04,"end":259.552,"frac":0.872,"status":"ok","matched":34,"words":39},"differ":false}],"unassigned":{"small":[{"start":240.42,"end":246.12,"words":9,"text":"hashtag streetreads14 and hashtag pirateslife this is the end"},{"start":260.04,"end":265.06,"words":15,"text":"the more photos you upload the more chances you have to win the grand prize"}],"large":[{"start":242.4,"end":246.04,"words":6,"text":"hashtag pirateslife this is the end"},{"start":259.5,"end":264.86,"words":15,"text":"the more photos you upload the more chances you have to win the grand prize"}]},"image":"https://creator.storycity.app/media/wp-content/uploads/2014/07/JM13comp.jpg"}