221,0.194,0.189,0.163,0.143,0.128,0.111,0.1,0.089,0.079,0.071,0.188,0.201,0.174,0.142,0.052,0.037,0.033,0.03,0.025,0.02,0.016,0.012,0.008,0.006,0.003,0.001],"paragraphs":[{"i":0,"text":"ADDITIONAL TIPS FOR PARENTS","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":4},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":4},"differ":false},{"i":1,"text":"@pet_type s love the treats at the corner store, and they also have a soft spot for the refreshing water bowl left outside. Go to your local store, get a drink… and maybe some answers? Let’s ask it together.","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":40},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":40},"differ":false},{"i":2,"text":"\"Hi! Have you seen Squeaky?\"","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":5},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":5},"differ":false},{"i":3,"text":"\"Right this way, my esteemed guests! Welcome to our store. Pets are free to partake of the refreshments located here at ground level. We trust you’ll find the H20 to your liking and pairs well with any assortment of nourishment you may have had previous to your visit.","isAppLine":false,"small":{"start":1.824,"end":18.592,"frac":0.958,"status":"ok","matched":46,"words":48},"large":{"start":1.824,"end":18.2,"frac":0.958,"status":"ok","matched":46,"words":48},"differ":false},{"i":4,"text":"\"Let us know if there is any way we can be of assistance. Why, yes, of course I remember. I keep a detailed guestbook but also possess an uncanny memory for faces.","isAppLine":false,"small":{"start":19.04,"end":29.824,"frac":1.0,"status":"ok","matched":32,"words":32},"large":{"start":19.04,"end":29.7,"frac":1.0,"status":"ok","matched":32,"words":32},"differ":false},{"i":5,"text":"\"Your pet visited our establishment four hours and thirty-eight minutes ago with a most charming non-animate guest that emitted the most endearing squeak. We had a delightful conversation about our preferences for various types of water – bottled, rain, tap or hose – and I wished them well on their journey to meet up with some friends for a play date.\"","isAppLine":false,"small":{"start":30.208,"end":51.232,"frac":0.967,"status":"ok","matched":59,"words":61},"large":{"start":30.208,"end":51.22,"frac":0.984,"status":"ok","matched":60,"words":61},"differ":false},{"i":6,"text":"\"They were torn as to which friends to join though I fear. Should they enjoy the refined sport at the ball court, or seek the avian company rustling in the branches of yon tree? I cannot say which they chose.\"","isAppLine":false,"small":{"start":51.616,"end":65.44,"frac":0.95,"status":"ok","matched":38,"words":40},"large":{"start":51.616,"end":65.44,"frac":1.0,"status":"ok","matched":40,"words":40},"differ":false}],"unassigned":{"small":[],"large":[]},"image":null}