279,0.179,0.175,0.08,0.058,0.007,0.004,0.002,0.52,0.419,0.362,0.244,0.238,0.213,0.192,0.17,0.142,0.119,0.107,0.09,0.078,0.07,0.19,0.2,0.147,0.057,0.037,0.032,0.027,0.022,0.015,0.01,0.007,0.004,0.002],"paragraphs":[{"i":0,"text":"ADDITIONAL TIPS FOR PARENTS","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":4},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":4},"differ":false},{"i":1,"text":"@pet_name loves getting mail! Go to your local mailbox and see what it knows about Squeaky. Let’s ask it together.","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":21},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":21},"differ":false},{"i":2,"text":"\"Hi! Have you seen Squeaky?\"","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":5},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":5},"differ":false},{"i":3,"text":"\"I’m sorry, do I know you? It’s been so long since anyone’s visited. No one sends letters anymore. I just hold bills and notices for jury duty no one wants. Or flyers. Junk mail, they call it.","isAppLine":false,"small":{"start":0.48,"end":16.58,"frac":1.0,"status":"ok","matched":37,"words":37},"large":{"start":0.48,"end":16.576,"frac":1.0,"status":"ok","matched":37,"words":37},"differ":false},{"i":4,"text":"\"Well, guess that makes me a junk box . I mean, I was never the ice cream truck but still, back in the day, I got regular visits, you know? Now it’s the odd package. Or cheeky kids. Or those snoopy whatchamacallits? Pets.","isAppLine":false,"small":{"start":17.376,"end":37.76,"frac":0.976,"status":"ok","matched":41,"words":42},"large":{"start":17.376,"end":37.54,"frac":0.952,"status":"ok","matched":40,"words":42},"differ":false},{"i":5,"text":"\"Wait, I remember you – you used to be smaller, didn’t you? Ya, and that pet whatsitsname is yours.","isAppLine":false,"small":{"start":40.544,"end":48.544,"frac":0.833,"status":"ok","matched":15,"words":18},"large":{"start":40.544,"end":48.544,"frac":0.833,"status":"ok","matched":15,"words":18},"differ":false},{"i":6,"text":"\"Yeah, it came around here before with that noisy toy in its mouth. Disrespectful, if you ask me. We used to be a quiet neighborhood, once upon a time.","isAppLine":false,"small":{"start":49.408,"end":60.288,"frac":0.966,"status":"ok","matched":28,"words":29},"large":{"start":49.408,"end":60.288,"frac":1.0,"status":"ok","matched":29,"words":29},"differ":false},{"i":7,"text":"\"It looked kinda nervous to be going wherever it was headed. It could only be one of two places, the Creepy House or the Noisy Garage door.\"","isAppLine":false,"small":{"start":62.656,"end":76.16,"frac":1.0,"status":"ok","matched":27,"words":27},"large":{"start":62.656,"end":75.968,"frac":1.0,"status":"ok","matched":27,"words":27},"differ":false}],"unassigned":{"small":[{"start":77.08,"end":82.58,"words":16,"text":"where to next open the story city app to follow the map to your selected destination"}],"large":[{"start":76.88,"end":82.22,"words":16,"text":"where to next open the story city app to follow the map to your selected destination"}]},"image":null}