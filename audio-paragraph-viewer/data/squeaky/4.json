,0.011,0.01,0.008,0.007,0.007,0.006,0.555,0.415,0.298,0.251,0.234,0.203,0.197,0.164,0.146,0.123,0.11,0.094,0.081,0.073,0.2,0.227,0.148,0.072,0.039,0.035,0.03,0.025,0.019,0.014,0.01,0.006,0.004,0.002],"paragraphs":[{"i":0,"text":"ADDITIONAL TIPS FOR PARENTS","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":4},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":4},"differ":false},{"i":1,"text":"@pet_name is a big fan of slides, whether going up or down or just circling around. Go to your local playground and ask the slide for Squeaky’s whereabouts. Let’s ask it together.","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":33},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":33},"differ":false},{"i":2,"text":"\"Hi! Have you seen Squeaky?\"","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":5},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":5},"differ":false},{"i":3,"text":"\"Well, well, well, what brings a unicorn like you to the whitewater rapids? Slide? Not sure what you mean. There’s no slide here.","isAppLine":false,"small":{"start":2.24,"end":11.968,"frac":1.0,"status":"ok","matched":23,"words":23},"large":{"start":2.24,"end":11.36,"frac":1.0,"status":"ok","matched":23,"words":23},"differ":true},{"i":4,"text":"\"But have a splash, ride the waves! Get ready for a wet and twisty ride! Watch out for the marshmallow rocks and root beer foam – they’re delicious but so sweet they’ll rot your boat and your teeth.","isAppLine":false,"small":{"start":12.992,"end":26.432,"frac":0.946,"status":"ok","matched":35,"words":37},"large":{"start":11.36,"end":25.78,"frac":1.0,"status":"ok","matched":37,"words":37},"differ":true},{"i":5,"text":"\"I’m sorry, what’s that? You have questions? Last time I checked, unicorns don’t talk so I doubt that. Talking slide? Moi ? Oh, you’re mistaken.","isAppLine":false,"small":{"start":27.936,"end":41.78,"frac":0.917,"status":"ok","matched":22,"words":24},"large":{"start":25.78,"end":41.54,"frac":0.917,"status":"ok","matched":22,"words":24},"differ":true},{"i":6,"text":"\"I’m a downhill slope and the powder’s fresh. Whoosh your way down. I bet a wombat like you is a whiz on skis.","isAppLine":false,"small":{"start":42.88,"end":52.416,"frac":0.913,"status":"ok","matched":21,"words":23},"large":{"start":42.88,"end":53.64,"frac":0.783,"status":"ok","matched":18,"words":23},"differ":true},{"i":7,"text":"\"Pets with toys? Oh, they make so much noise. [Gasp] I’m a poet! Did I know it? [Chuckle]","isAppLine":false,"small":{"start":53.792,"end":63.52,"frac":0.889,"status":"ok","matched":16,"words":18},"large":{"start":53.792,"end":63.52,"frac":0.833,"status":"ok","matched":15,"words":18},"differ":false},{"i":8,"text":"\"They jingled past real fast. Perhaps it was coins? You could check the bend, where you spend. Or maybe it was chains at the seat, where you push with your feet.","isAppLine":false,"small":{"start":63.904,"end":74.304,"frac":0.968,"status":"ok","matched":30,"words":31},"large":{"start":62.912,"end":74.304,"frac":0.968,"status":"ok","matched":30,"words":31},"differ":true},{"i":9,"text":"Make sure to save your picture before you move on!","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":10},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":10},"differ":false}],"unassigned":{"small":[],"large":[]},"image":null}