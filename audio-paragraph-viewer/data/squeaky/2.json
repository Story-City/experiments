e},{"i":6,"text":"\" [SFX: Honk, honk!] What was that you were asking about again? Are you selling insurance? No? Oh, right – you’re the one looking for a lost pet.","isAppLine":false,"small":{"start":14.624,"end":24.94,"frac":0.731,"status":"ok","matched":19,"words":26},"large":{"start":14.624,"end":24.64,"frac":0.808,"status":"ok","matched":21,"words":26},"differ":false},{"i":7,"text":"\" [SFX: Honk, honk!] Coming through! Right, no. Not a lost pet, a lost pet toy . Right, right…","isAppLine":false,"small":{"start":24.94,"end":31.68,"frac":0.824,"status":"ok","matched":14,"words":17},"large":{"start":24.64,"end":31.46,"frac":0.824,"status":"ok","matched":14,"words":17},"differ":false},{"i":8,"text":"\" [SFX: Buzz, Garage door closing] DOOR DOWN! Sorry, gotta keep the noise inside or else the neighbors will complain again.","isAppLine":false,"small":{"start":31.68,"end":37.6,"frac":0.75,"status":"ok","matched":15,"words":20},"large":{"start":31.46,"end":37.6,"frac":0.75,"status":"ok","matched":15,"words":20},"differ":false},{"i":9,"text":"\"You here to change tires? Oh, right, the toy. Yeah, it had this, uh, distinct squeak. I remember hearing the sound echo against something metallic down the street after your pet left. Whoa –","isAppLine":false,"small":{"start":38.432,"end":51.36,"frac":0.909,"status":"ok","matched":30,"words":33},"large":{"start":38.432,"end":51.04,"frac":0.939,"status":"ok","matched":31,"words":33},"differ":false},{"i":10,"text":"\" [SFX: Buzz, Garage door opening] DOOR UP! Boss is back again. Probably forgot the grocery list or something. One time it was shoes. Imagine driving barefoot!\"","isAppLine":false,"small":{"start":51.36,"end":59.84,"frac":0.731,"status":"ok","matched":19,"words":26},"large":{"start":51.04,"end":59.84,"frac":0.808,"status":"ok","matched":21,"words":26},"differ":false},{"i":11,"text":"Make sure to save your picture before you move on!","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","