08,0.05,0.055,0.09,0.04,0.04,0.052,0.044,0.018,0.027,0.036,0.007,0.019,0.012,0.005,0.003,0.004,0.001,0.001,0.0],"paragraphs":[{"i":0,"text":"“Quick!” you shout as you enter the square, holding the time machine at arm’s length.","isAppLine":false,"small":{"start":1.376,"end":5.664,"frac":1.0,"status":"ok","matched":15,"words":15},"large":{"start":1.376,"end":5.664,"frac":1.0,"status":"ok","matched":15,"words":15},"differ":false},{"i":1,"text":"There is a blurring flash of light, and you discover yourself standing in a crowd of women in long black dresses, which are all swirling in the gust of wind that accompanied your arrival.","isAppLine":false,"small":{"start":6.592,"end":16.448,"frac":0.971,"status":"ok","matched":33,"words":34},"large":{"start":6.592,"end":16.448,"frac":0.971,"status":"ok","matched":33,"words":34},"differ":false},{"i":2,"text":"One small woman with white hair, standing on a small platform in front of the crowd, looks sternly at you.","isAppLine":false,"small":{"start":16.768,"end":22.44,"frac":1.0,"status":"ok","matched":20,"words":20},"large":{"start":16.768,"end":22.36,"frac":1.0,"status":"ok","matched":20,"words":20},"differ":false},{"i":3,"text":"“Excuse me,” she says in a thick Scottish accent, “I am in the middle of a speech.”","isAppLine":false,"small":{"start":22.44,"end":27.264,"frac":1.0,"status":"ok","matched":17,"words":17},"large":{"start":22.36,"end":27.264,"frac":1.0,"status":"ok","matched":17,"words":17},"differ":false},{"i":4,"text":"“Oh—,“ begins the Professor, but she cuts him off.","isAppLine":false,"small":{"start":27.84,"end":30.62,"frac":0.889,"status":"ok","matched":8,"words":9},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":9},"differ":true},{"i":5,"text":"“And I will not be interrupted by any man! I will not be silenced!”","isAppLine":false,"small":{"start":30.62,"end":34.98,"frac":1.0,"status":"ok","matched":14,"words":14},"large":{"start":29.824,"end":36.128,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":true},{"i":6,"text":"You stare at her. She looks so familiar.","isAppLine":false,"small":{"start":34.98,"end":37.16,"frac":0.875,"status":"ok","matched":7,"words":8},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":8},"differ":true},{"i":7,"text":"“For there is nothing a woman like me cannot do!” she continues. “I am Catherine Helen Spence. I am an author, a teacher, a journalist. I am the first woman in Australia to run for political office. I have spent my life fighting for the rights of women, and for the rights of minorities! One day they will build statues of me!”","isAppLine":false,"small":{"start":37.728,"end":56.78,"frac":0.968,"status":"ok","matched":60,"words":62},"large":{"start":36.48,"end":56.86,"frac":0.935,"status":"ok","matched":58,"words":62},"differ":true},{"i":8,"text":"“And they’ll put you on the money!” you shout, remembering.","isAppLine":false,"small":{"start":56.78,"end":59.46,"frac":0.9,"status":"ok","matched":9,"words":10},"large":{"start":56.86,"end":59.7,"frac":1.0,"status":"ok","matched":10,"words":10},"differ":false},{"i":9,"text":"She thinks about this.","isAppLine":false,"small":{"start":60.16,"end":60.92,"frac":1.0,"status":"ok","matched":4,"words":4},"large":{"start":60.16,"end":61.056,"frac":1.0,"status":"ok","matched":4,"words":4},"differ":false},{"i":10,"text":"“No, probably not that,” she concedes.","isAppLine":false,"small":{"start":61.408,"end":63.84,"frac":1.0,"status":"ok","matched":6,"words":6},"large":{"start":61.408,"end":63.92,"frac":1.0,"status":"ok","matched":6,"words":6},"differ":false},{"i":11,"text":"The Professor reaches into his pocket and pulls out a five-dollar note.","isAppLine":false,"small":{"start":63.84,"end":67.2,"frac":1.0,"status":"ok","matched":13,"words":13},"large":{"start":63.92,"end":67.264,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false},{"i":12,"text":"“Yes, you’re on the money, look!” he says, and shows it to her.","isAppLine":false,"small":{"start":67.648,"end":71.98,"frac":1.0,"status":"ok","matched":13,"words":13},"large":{"start":67.648,"end":72.0,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false},{"i":13,"text":"She frowns, staring at her own face on the note.","isAppLine":false,"small":{"start":72.224,"end":76.192,"frac":1.0,"status":"ok","matched":10,"words":10},"large":{"start":72.224,"end":76.192,"frac":1.0,"status":"ok","matched":10,"words":10},"differ":false},{"i":14,"text":"“Why is it pink? Because I’m a woman?”","isAppLine":false,"small":{"start":76.384,"end":78.66,"frac":0.75,"status":"ok","matched":6,"words":8},"large":{"start":76.384,"end":78.848,"frac":0.75,"status":"ok","matched":6,"words":8},"differ":false},{"i":15,"text":"“Um, no, I don’t think so…” you begin, but she is off again.","isAppLine":false,"small":{"start":79.296,"end":83.264,"frac":0.769,"status":"ok","matched":10,"words":13},"large":{"start":79.296,"end":83.26,"frac":0.769,"status":"ok","matched":10,"words":13},"differ":false},{"i":16,"text":"“Why, a woman could be on any colour banknote, blue, green, yellow and purple polka-dot… and why the five dollar note? Why not the ten? The fifty? Why not the ninety-seven dollar note?”","isAppLine":false,"small":{"start":83.424,"end":94.84,"frac":0.971,"status":"ok","matched":34,"words":35},"large":{"start":83.424,"end":94.6,"frac":0.714,"status":"ok","matched":25,"words":35},"differ":false},{"i":17,"text":"“I think you’re missing the point!” you interrupt, as the Professor takes the machine across the grass to where construction workers are pulling down a crumbling sandstone cross, to make way for a new red granite column in memory of Colonel Light. “You’re a hero, an example for women throughout history… uh… I mean, the future! Because of women like you, women in all across the world will be able to vote and become politicians! Women Mayors, women Governors, women Prime Ministers!”","isAppLine":false,"small":{"start":94.84,"end":120.62,"frac":0.976,"status":"ok","matched":80,"words":82},"large":{"start":94.6,"end":120.64,"frac":0.976,"status":"ok","matched":80,"words":82},"differ":false},{"i":18,"text":"“How do you know that?” she asks, suspiciously.","isAppLine":false,"small":{"start":120.896,"end":123.616,"frac":0.875,"status":"ok","matched":7,"words":8},"large":{"start":120.896,"end":123.616,"frac":0.875,"status":"ok","matched":7,"words":8},"differ":false},{"i":19,"text":"“Trust me,” you say.","isAppLine":false,"small":{"start":124.512,"end":125.62,"frac":1.0,"status":"ok","matched":4,"words":4},"large":{"start":124.512,"end":125.76,"frac":1.0,"status":"ok","matched":4,"words":4},"differ":false},{"i":20,"text":"A gust of wind begins to whirl around the square. You turn to see the Professor carrying the car antenna that he got from the Queen’s Theatre as he clambers up the monolith at the northern end.","isAppLine":false,"small":{"start":126.24,"end":135.2,"frac":1.0,"status":"ok","matched":37,"words":37},"large":{"start":126.24,"end":135.328,"frac":1.0,"status":"ok","matched":37,"words":37},"differ":false},{"i":21,"text":"“Hold on!” he calls out.","isAppLine":false,"small":{"start":135.616,"end":137.46,"frac":1.0,"status":"ok","matched":5,"words":5},"large":{"start":135.616,"end":137.36,"frac":1.0,"status":"ok","matched":5,"words":5},"differ":false},{"i":22,"text":"There is a flash of light… and you’re back! Cars are driving around the square, familiar buildings tower in every direction, and Catherine Helen Spence has vanished, replaced by her statue standing proudly.","isAppLine":false,"small":{"start":137.76,"end":154.176,"frac":1.0,"status":"ok","matched":33,"words":33},"large":{"start":137.76,"end":154.04,"frac":1.0,"status":"ok","matched":33,"words":33},"differ":false},{"i":23,"text":"The Professor approaches and puts his hand on your shoulder as you admire the statue.","isAppLine":false,"small":{"start":154.496,"end":157.86,"frac":1.0,"status":"ok","matched":15,"words":15},"large":{"start":154.496,"end":157.98,"frac":1.0,"status":"ok","matched":15,"words":15},"differ":false},{"i":24,"text":"After a moment, he sighs. “She still has my five dollars.”","isAppLine":false,"small":{"start":158.4,"end":163.424,"frac":1.0,"status":"ok","matched":11,"words":11},"large":{"start":158.4,"end":163.424,"frac":1.0,"status":"ok","matched":11,"words":11},"differ":false},{"i":25,"text":"~END~","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":1},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":1},"differ":false},{"i":26,"text":"Congratulations! You made it back. Don’t forget to upload a pic of you on your adventure to Facebook, Instagram or Twitter with the hashtags #StoryCity #TimeCaper","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":26},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":26},"differ":false},{"i":27,"text":"This is the end of your adventure but you can head back to the starting point to explore a different story path, or you can try the other Story City: Adelaide adventure, Ready or Not: Hide & Seek Alien Style.","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":39},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":39},"differ":false}],"unassigned":{"small":[{"start":74.92,"end":77.34,"words":11,"text":"why is it could i ask that the north is pink"},{"start":202.6,"end":204.0,"words":14,"text":"thank you very much for watching and ill see you in the next one"}],"large":[{"start":75.04,"end":77.24,"words":11,"text":"why is it can i ask that the note is pink"}]},"image":"https://creator.storycity.app/media/61de1aa29ecbb_BC12_final.jpg"}