1,0.114,0.103,0.052,0.033,0.087,0.065,0.042,0.053,0.055,0.021,0.018,0.031,0.015,0.006,0.019,0.012,0.006,0.003,0.004,0.001,0.001,0.0],"paragraphs":[{"i":0,"text":"The machine sparks and whines as you reach the square, and then… SPLAT! Something wet and sticky hits you on the back of the neck.","isAppLine":false,"small":{"start":6.272,"end":13.632,"frac":1.0,"status":"ok","matched":25,"words":25},"large":{"start":6.272,"end":13.48,"frac":1.0,"status":"ok","matched":25,"words":25},"differ":false},{"i":1,"text":"“Ewww!”","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":1},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":1},"differ":false},{"i":2,"text":"You turn to see a giant glassy eye staring at you: it belongs to a camel. It snorts, blinking its long lashes, and pokes its tongue out.","isAppLine":false,"small":{"start":14.016,"end":23.104,"frac":1.0,"status":"ok","matched":27,"words":27},"large":{"start":14.016,"end":22.94,"frac":1.0,"status":"ok","matched":27,"words":27},"differ":false},{"i":3,"text":"“Salam!” says a voice from behind the camel.","isAppLine":false,"small":{"start":23.392,"end":25.792,"frac":0.875,"status":"ok","matched":7,"words":8},"large":{"start":23.392,"end":25.52,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":false},{"i":4,"text":"A bearded man in a neatly folded red turban beams at you as he approaches, and takes the camel by its reins.","isAppLine":false,"small":{"start":26.08,"end":31.968,"frac":0.955,"status":"ok","matched":21,"words":22},"large":{"start":26.08,"end":31.9,"frac":0.955,"status":"ok","matched":21,"words":22},"differ":false},{"i":5,"text":"“I see you have met my friend! My name is Merban, of Tarin, but where might you be from in such… unusual clothes? Are you lost?”","isAppLine":false,"small":{"start":32.16,"end":40.608,"frac":0.962,"status":"ok","matched":25,"words":26},"large":{"start":32.16,"end":40.608,"frac":0.962,"status":"ok","matched":25,"words":26},"differ":false},{"i":6,"text":"“Sort of,” you say, looking at the battered time machine in the Professor’s arms.","isAppLine":false,"small":{"start":41.024,"end":45.28,"frac":1.0,"status":"ok","matched":14,"words":14},"large":{"start":41.024,"end":45.28,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":false},{"i":7,"text":"“Ah!” says Merban, following your gaze. “You are engineers? I know something of this!”","isAppLine":false,"small":{"start":45.536,"end":50.944,"frac":0.786,"status":"ok","matched":11,"words":14},"large":{"start":45.536,"end":50.86,"frac":0.929,"status":"ok","matched":13,"words":14},"differ":false},{"i":8,"text":"“What kind of engineer needs a camel?” asks the Professor.","isAppLine":false,"small":{"start":51.232,"end":54.144,"frac":1.0,"status":"ok","matched":10,"words":10},"large":{"start":51.232,"end":54.144,"frac":1.0,"status":"ok","matched":10,"words":10},"differ":false},{"i":9,"text":"Merban laughs. “One who needs to build telegraph lines through the desert! I led a whole team of camelmen to build the Overland Telegraph Line—a wire that stretches two thousand miles, all the way from Adelaide to Darwin, and beyond, beneath the sea, to Indonesia! We came from all around: Afghanistan, Baluchistan, India… and we brought our camels with us! Much better than horses for the deserts of this land.”","isAppLine":false,"small":{"start":54.336,"end":82.688,"frac":0.944,"status":"ok","matched":67,"words":71},"large":{"start":54.336,"end":82.688,"frac":0.944,"status":"ok","matched":67,"words":71},"differ":false},{"i":10,"text":"The camel snorts again, smugly.","isAppLine":false,"small":{"start":83.936,"end":86.14,"frac":1.0,"status":"ok","matched":5,"words":5},"large":{"start":83.936,"end":86.02,"frac":1.0,"status":"ok","matched":5,"words":5},"differ":false},{"i":11,"text":"Suddenly, you have an idea.","isAppLine":false,"small":{"start":86.72,"end":87.808,"frac":1.0,"status":"ok","matched":5,"words":5},"large":{"start":86.72,"end":87.808,"frac":1.0,"status":"ok","matched":5,"words":5},"differ":false},{"i":12,"text":"“Hey, if you know about telegraph lines, do you think you could help us make an antenna for our machine?”","isAppLine":false,"small":{"start":88.256,"end":93.056,"frac":1.0,"status":"ok","matched":20,"words":20},"large":{"start":88.256,"end":93.056,"frac":1.0,"status":"ok","matched":20,"words":20},"differ":false},{"i":13,"text":"Merban smiles. “Of course! Why, even now I am overseeing construction of the first Mosque in Adelaide, with minarets that will reach to the sky! It’s just around the corner, on Little Gilbert Street.”","isAppLine":false,"small":{"start":93.984,"end":105.952,"frac":0.971,"status":"ok","matched":33,"words":34},"large":{"start":93.984,"end":105.94,"frac":0.971,"status":"ok","matched":33,"words":34},"differ":false},{"i":14,"text":"He puts two fingers in his mouth and whistles, loudly.","isAppLine":false,"small":{"start":106.24,"end":108.64,"frac":0.9,"status":"ok","matched":9,"words":10},"large":{"start":106.24,"end":108.8,"frac":0.9,"status":"ok","matched":9,"words":10},"differ":false},{"i":15,"text":"Within moments, the square is filled with camels and men in turbans, hoisting poles and pulling cables. The Professor twists a cable into the machine, and turns the dials.","isAppLine":false,"small":{"start":108.64,"end":118.54,"frac":0.966,"status":"ok","matched":28,"words":29},"large":{"start":109.088,"end":118.432,"frac":1.0,"status":"ok","matched":29,"words":29},"differ":false},{"i":16,"text":"Merban waves as the machine starts to whir.","isAppLine":false,"small":{"start":118.816,"end":121.152,"frac":0.875,"status":"ok","matched":7,"words":8},"large":{"start":118.816,"end":121.152,"frac":0.875,"status":"ok","matched":7,"words":8},"differ":false},{"i":17,"text":"“Khodahafez, my friends,” he says. “Safe travels!”","isAppLine":false,"small":{"start":121.472,"end":124.84,"frac":0.714,"status":"ok","matched":5,"words":7},"large":{"start":121.472,"end":125.16,"frac":0.857,"status":"ok","matched":6,"words":7},"differ":false},{"i":18,"text":"A gust of wind blows around the square, so strong you have to close your eyes.","isAppLine":false,"small":{"start":125.48,"end":129.98,"frac":1.0,"status":"ok","matched":16,"words":16},"large":{"start":125.16,"end":129.7,"frac":1.0,"status":"ok","matched":16,"words":16},"differ":false},{"i":19,"text":"When you open them, Merban is gone, and so are the camels. The drone of car engines rumble, and you find yourself staring at the sweeping curve of the Voyagers sculpture. It’s like a dune of sand, frozen in the middle of the city.","isAppLine":false,"small":{"start":129.98,"end":142.272,"frac":0.977,"status":"ok","matched":43,"words":44},"large":{"start":129.7,"end":142.272,"frac":0.977,"status":"ok","matched":43,"words":44},"differ":false},{"i":20,"text":"For a moment it makes you think about your own voyage, and the people you’ve met along the way. Who knew it took so many different groups of people to make a city? And how many more stories are buried in the past, waiting to be discovered? Or the future, for that matter?","isAppLine":false,"small":{"start":142.592,"end":155.648,"frac":0.981,"status":"ok","matched":52,"words":53},"large":{"start":142.592,"end":155.48,"frac":0.981,"status":"ok","matched":52,"words":53},"differ":false},{"i":21,"text":"You turn to see the Professor tinkering with the machine, and you realise: only time will tell!","isAppLine":false,"small":{"start":156.032,"end":161.088,"frac":1.0,"status":"ok","matched":17,"words":17},"large":{"start":156.032,"end":161.088,"frac":1.0,"status":"ok","matched":17,"words":17},"differ":false},{"i":22,"text":"~END~","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":1},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":1},"differ":false},{"i":23,"text":"Congratulations! You made it back. Don’t forget to upload a pic of you on your adventure to Facebook, Instagram or Twitter with the hashtags #StoryCity #TimeCaper","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":26},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":26},"differ":false},{"i":24,"text":"This is the end of your adventure but you can head back to the starting point to explore a different story path, or you can try the other Story City: Adelaide adventure, Ready or Not: Hide & Seek Alien Style.","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":39},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":39},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/61de1b83de6cc_BC14_final.jpg"}