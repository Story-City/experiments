0.013,0.024,0.017,0.012,0.006,0.01,0.007,0.005,0.005,0.005,0.003,0.002,0.002,0.001,0.001,0.0,0.001,0.0,0.0,0.0,0.0],"paragraphs":[{"i":0,"text":"You slip through the crowd as the air crackles around you.","isAppLine":false,"small":{"start":4.416,"end":8.280000000000001,"frac":1.0,"status":"ok","matched":11,"words":11},"large":{"start":4.416,"end":7.6,"frac":1.0,"status":"ok","matched":11,"words":11},"differ":true},{"i":1,"text":"“What in the world?” says the Professor. You follow his gaze, looking up at the curiously turreted building on the corner. Then you notice the giant bee, perched on the dome. “That wasn’t there in 1866! We’ve travelled forward, at least thirty-five years! But that means the machine must be broken, it’s activating without my control! Uh oh!”","isAppLine":false,"small":{"start":8.280000000000001,"end":31.968,"frac":0.949,"status":"ok","matched":56,"words":59},"large":{"start":7.6,"end":31.968,"frac":0.949,"status":"ok","matched":56,"words":59},"differ":true},{"i":2,"text":"“HUT, TWO, THREE, FOUR!”","isAppLine":false,"small":{"start":32.384,"end":34.44,"frac":1.0,"status":"ok","matched":4,"words":4},"large":{"start":32.384,"end":34.14,"frac":1.0,"status":"ok","matched":4,"words":4},"differ":false},{"i":3,"text":"The crowd around you cheers, and a marching band crashes its way up King William Street, followed by rows upon rows of men in dark brown jackets and hats.","isAppLine":false,"small":{"start":34.44,"end":43.552,"frac":1.0,"status":"ok","matched":29,"words":29},"large":{"start":34.14,"end":43.552,"frac":1.0,"status":"ok","matched":29,"words":29},"differ":false},{"i":4,"text":"“Excuse me,” says a man angrily, waving you aside.","isAppLine":false,"small":{"start":43.744,"end":47.488,"frac":1.0,"status":"ok","matched":9,"words":9},"large":{"start":43.744,"end":47.3,"frac":1.0,"status":"ok","matched":9,"words":9},"differ":false},{"i":5,"text":"He is cranking a handle attached to a wooden box, standing on a wooden tripod.","isAppLine":false,"small":{"start":47.712,"end":51.648,"frac":0.867,"status":"ok","matched":13,"words":15},"large":{"start":47.712,"end":51.648,"frac":0.867,"status":"ok","matched":13,"words":15},"differ":false},{"i":6,"text":"“What are you doing?”","isAppLine":false,"small":{"start":52.032,"end":52.98,"frac":1.0,"status":"ok","matched":4,"words":4},"large":{"start":52.032,"end":52.72,"frac":1.0,"status":"ok","matched":4,"words":4},"differ":false},{"i":7,"text":"“It’s the latest thing! A cinematograph, a moving picture camera, and now you’re going to be in the shot!”","isAppLine":false,"small":{"start":52.98,"end":59.424,"frac":1.0,"status":"ok","matched":19,"words":19},"large":{"start":52.72,"end":59.424,"frac":1.0,"status":"ok","matched":19,"words":19},"differ":false},{"i":8,"text":"“You’re filming the parade?”","isAppLine":false,"small":{"start":59.776,"end":61.344,"frac":1.0,"status":"ok","matched":4,"words":4},"large":{"start":59.776,"end":61.2,"frac":1.0,"status":"ok","matched":4,"words":4},"differ":false},{"i":9,"text":"He stares at you. “Parade? Why, it’s our brave troops, off to fight the war in Africa!”","isAppLine":false,"small":{"start":61.632,"end":66.62,"frac":1.0,"status":"ok","matched":17,"words":17},"large":{"start":61.632,"end":66.62,"frac":1.0,"status":"ok","matched":17,"words":17},"differ":false},{"i":10,"text":"What war in Africa?","isAppLine":false,"small":{"start":67.04,"end":68.064,"frac":1.0,"status":"ok","matched":4,"words":4},"large":{"start":67.04,"end":68.064,"frac":1.0,"status":"ok","matched":4,"words":4},"differ":false},{"i":11,"text":"“Of course, the Boer war,” shouts the Professor over the din. “Every state in Australia sent troops to help the British in South Africa.”","isAppLine":false,"small":{"start":68.352,"end":77.18,"frac":1.0,"status":"ok","matched":24,"words":24},"large":{"start":68.352,"end":77.54,"frac":0.917,"status":"ok","matched":22,"words":24},"differ":false},{"i":12,"text":"“Why do they look so happy?”","isAppLine":false,"small":{"start":77.18,"end":79.16,"frac":1.0,"status":"ok","matched":6,"words":6},"large":{"start":77.54,"end":79.14,"frac":1.0,"status":"ok","matched":6,"words":6},"differ":false},{"i":13,"text":"“They don’t know what they’re getting into. This is the first war any South Australian has ever fought in. Come on, we’d better move before…”","isAppLine":false,"small":{"start":79.16,"end":87.14,"frac":0.96,"status":"ok","matched":24,"words":25},"large":{"start":79.14,"end":86.976,"frac":1.0,"status":"ok","matched":25,"words":25},"differ":false},{"i":14,"text":"“YOU THERE!”","isAppLine":false,"small":{"start":87.168,"end":88.0,"frac":1.0,"status":"ok","matched":2,"words":2},"large":{"start":87.168,"end":87.9,"frac":1.0,"status":"ok","matched":2,"words":2},"differ":false},{"i":15,"text":"A hand clamps down on your shoulder, hard.","isAppLine":false,"small":{"start":88.192,"end":90.62,"frac":1.0,"status":"ok","matched":8,"words":8},"large":{"start":88.192,"end":90.52,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":false},{"i":16,"text":"You turn to face the biggest and woolliest moustache you’ve ever seen. It belongs to a red-faced Sergeant-Major, and it waggles underneath his wobbling helmet as he barks at you.","isAppLine":false,"small":{"start":91.104,"end":100.576,"frac":1.0,"status":"ok","matched":32,"words":32},"large":{"start":91.104,"end":100.576,"frac":1.0,"status":"ok","matched":32,"words":32},"differ":false},{"i":17,"text":"“WHAT ARE YOU DOING OUT OF LINE?”","isAppLine":false,"small":{"start":100.768,"end":102.42,"frac":1.0,"status":"ok","matched":7,"words":7},"large":{"start":100.768,"end":102.16,"frac":1.0,"status":"ok","matched":7,"words":7},"differ":false},{"i":18,"text":"He looks you up and down.","isAppLine":false,"small":{"start":102.42,"end":103.424,"frac":1.0,"status":"ok","matched":6,"words":6},"large":{"start":102.16,"end":103.424,"frac":1.0,"status":"ok","matched":6,"words":6},"differ":false},{"i":19,"text":"“AND WHAT ARE YOU WEARING? SOME KIND OF NEW UNIFORM IS IT? IT’S HORRIBLE. AND SO IS THAT HAIRCUT!”","isAppLine":false,"small":{"start":103.584,"end":108.9,"frac":0.947,"status":"ok","matched":18,"words":19},"large":{"start":103.584,"end":108.25999999999999,"frac":0.737,"status":"ok","matched":14,"words":19},"differ":true},{"i":20,"text":"You try to explain, but the Professor has already jumped to join the troops, glancing back at you with a worried look.","isAppLine":false,"small":{"start":108.9,"end":114.06,"frac":1.0,"status":"ok","matched":22,"words":22},"large":{"start":108.25999999999999,"end":114.24,"frac":1.0,"status":"ok","matched":22,"words":22},"differ":true},{"i":21,"text":"“BACK IN LINE!”","isAppLine":false,"small":{"start":114.56,"end":115.08,"frac":1.0,"status":"ok","matched":3,"words":3},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":3},"differ":true},{"i":22,"text":"The Sergeant-Major shoves you into the end of a row of privates, his moustache twitching so violently it looks like it’s about to fly off his face.","isAppLine":false,"small":{"start":115.08,"end":122.54,"frac":0.964,"status":"ok","matched":27,"words":28},"large":{"start":114.56,"end":123.9,"frac":0.964,"status":"ok","matched":27,"words":28},"differ":true},{"i":23,"text":"“YOU DON’T WANT TO FIND OUT WHAT WE DO WITH DESERTERS!”","isAppLine":false,"small":{"start":122.54,"end":125.76,"frac":0.818,"status":"ok","matched":9,"words":11},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":11},"differ":true},{"i":24,"text":"You find yourself marching in step with the soldiers alongside you. This isn’t good. You glance over at the Professor, and at the machine in his hands. It’s starting to spark again. You’ll need to make a run for it, but which way?","isAppLine":false,"small":{"start":126.208,"end":137.184,"frac":0.977,"status":"ok","matched":42,"words":43},"large":{"start":126.208,"end":137.184,"frac":0.977,"status":"ok","matched":42,"words":43},"differ":false},{"i":25,"text":"Do you:","isAppLine":false,"small":{"start":138.848,"end":139.328,"frac":1.0,"status":"ok","matched":2,"words":2},"large":{"start":138.848,"end":139.328,"frac":1.0,"status":"ok","matched":2,"words":2},"differ":false},{"i":26,"text":"Regent Arcade (1901->1925): Bowl over the Sergeant-Major, grab the Professor and run east up Rundle Mall, towards Regent Arcade.","isAppLine":false,"small":{"start":139.776,"end":146.08,"frac":0.81,"status":"ok","matched":17,"words":21},"large":{"start":139.776,"end":146.08,"frac":0.81,"status":"ok","matched":17,"words":21},"differ":false},{"i":27,"text":"Or","isAppLine":false,"small":{"start":146.496,"end":146.72,"frac":1.0,"status":"ok","matched":1,"words":1},"large":{"start":146.496,"end":146.6,"frac":1.0,"status":"ok","matched":1,"words":1},"differ":false},{"i":28,"text":"Buffalo’s Head (1925->1838): Sneak away from the Sergeant-Major, out the other side of the parade, catching the Professor’s eye as you sidle past. Cross the street to the west, head up Hindley Street, and stop at the Berkeley Hotel/Black Bull Pub.","isAppLine":false,"small":{"start":147.36,"end":158.976,"frac":0.909,"status":"ok","matched":40,"words":44},"large":{"start":147.36,"end":158.976,"frac":0.909,"status":"ok","matched":40,"words":44},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/61de1a208ed39_BC2_final.jpg"}