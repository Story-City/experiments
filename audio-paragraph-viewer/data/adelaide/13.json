74,0.038,0.033,0.041,0.034,0.021,0.033,0.033,0.024,0.016,0.015,0.006,0.008,0.004,0.002,0.003,0.001,0.001,0.001,0.001,0.0,0.0,0.0],"paragraphs":[{"i":0,"text":"You arrive at the Queen’s Theatre to bright flashes of light shining out of the entrance, and screams and squeals from inside. Darling must have tried to use the machine!","isAppLine":false,"small":{"start":2.304,"end":11.968,"frac":1.0,"status":"ok","matched":30,"words":30},"large":{"start":2.304,"end":11.94,"frac":1.0,"status":"ok","matched":30,"words":30},"differ":false},{"i":1,"text":"All manner of characters come running out: men in long black cloaks and powdered wigs, a crowd of screaming nuns, a blacksmith with his hammer still in hand, a horse and finally a very confused-looking old lady driving a Suzuki Swift. As the vehicle vanishes her car antenna snaps off, tinkling to the ground.","isAppLine":false,"small":{"start":12.192,"end":33.568,"frac":1.0,"status":"ok","matched":55,"words":55},"large":{"start":12.192,"end":33.54,"frac":1.0,"status":"ok","matched":55,"words":55},"differ":false},{"i":2,"text":"The Professor picks it up and points at the big, heavy, freshly-painted doors of the building.","isAppLine":false,"small":{"start":33.792,"end":38.016,"frac":1.0,"status":"ok","matched":17,"words":17},"large":{"start":33.792,"end":38.016,"frac":1.0,"status":"ok","matched":17,"words":17},"differ":false},{"i":3,"text":"“It’s the time machine, it’s gone haywire, sending people back and forth through time! This place must have been all sorts of things over time, a theatre, a courthouse, a market bazaar… even a carpark!”","isAppLine":false,"small":{"start":38.816,"end":51.84,"frac":0.971,"status":"ok","matched":34,"words":35},"large":{"start":38.816,"end":51.56,"frac":1.0,"status":"ok","matched":35,"words":35},"differ":false},{"i":4,"text":"A strange man with curly hair and a white beard, his face covered in black soot, staggers out from inside the theatre.","isAppLine":false,"small":{"start":52.448,"end":58.816,"frac":1.0,"status":"ok","matched":22,"words":22},"large":{"start":52.448,"end":58.56,"frac":1.0,"status":"ok","matched":22,"words":22},"differ":false},{"i":5,"text":"“Ruined, ruined!” he moans, and throws his head back, theatrically.","isAppLine":false,"small":{"start":59.296,"end":63.968,"frac":1.0,"status":"ok","matched":10,"words":10},"large":{"start":59.296,"end":63.64,"frac":1.0,"status":"ok","matched":10,"words":10},"differ":false},{"i":6,"text":"“What happened to your face?” you ask. “Did something explode?”","isAppLine":false,"small":{"start":64.224,"end":67.36,"frac":1.0,"status":"ok","matched":10,"words":10},"large":{"start":64.224,"end":67.08,"frac":1.0,"status":"ok","matched":10,"words":10},"differ":false},{"i":7,"text":"“What? No!” he says, irritably. “This is make-up, darling, I am Othello!”","isAppLine":false,"small":{"start":67.648,"end":73.248,"frac":0.923,"status":"ok","matched":12,"words":13},"large":{"start":67.648,"end":72.84,"frac":0.923,"status":"ok","matched":12,"words":13},"differ":false},{"i":8,"text":"“Oh, hello Othello,” says the Professor.","isAppLine":false,"small":{"start":73.664,"end":76.28,"frac":1.0,"status":"ok","matched":6,"words":6},"large":{"start":73.664,"end":76.22,"frac":1.0,"status":"ok","matched":6,"words":6},"differ":false},{"i":9,"text":"The man slaps his brow. “No, no, no, my name is John, John Lazar, I’m just playing Othello. Or at least I was, until that infernal machine ruined my opening night.”","isAppLine":false,"small":{"start":76.736,"end":86.592,"frac":0.806,"status":"ok","matched":25,"words":31},"large":{"start":76.736,"end":86.592,"frac":0.839,"status":"ok","matched":26,"words":31},"differ":false},{"i":10,"text":"He points, to where the horse is now sniffing something in the dirt at the base of the column to the right of the theatre doors: the time machine!","isAppLine":false,"small":{"start":86.816,"end":93.696,"frac":0.931,"status":"ok","matched":27,"words":29},"large":{"start":86.816,"end":93.46,"frac":0.931,"status":"ok","matched":27,"words":29},"differ":false},{"i":11,"text":"The Professor rushes to inspect it, as John Lazar moans and staggers about.","isAppLine":false,"small":{"start":93.952,"end":98.176,"frac":1.0,"status":"ok","matched":13,"words":13},"large":{"start":93.952,"end":98.176,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false},{"i":12,"text":"“I was a fool, a fool to think that Adelaide was the place for theatre! I should have known there was a reason no one had tried it here, why no one had tried it in Australia even!”","isAppLine":false,"small":{"start":98.4,"end":108.6,"frac":0.895,"status":"ok","matched":34,"words":38},"large":{"start":98.4,"end":108.7,"frac":0.868,"status":"ok","matched":33,"words":38},"differ":false},{"i":13,"text":"He stares out at the township: it can’t be more than a few years since the founding of Adelaide, it looks more like a ramshackle village in a Wild West movie than a city.","isAppLine":false,"small":{"start":109.056,"end":116.72,"frac":0.971,"status":"ok","matched":33,"words":34},"large":{"start":109.056,"end":116.864,"frac":0.971,"status":"ok","matched":33,"words":34},"differ":false},{"i":14,"text":"“They’re all leaving town for the gold rush. I can see it now, a city with no art, no theatre, no festivities. What a waste.”","isAppLine":false,"small":{"start":117.248,"end":125.88,"frac":1.0,"status":"ok","matched":25,"words":25},"large":{"start":117.248,"end":126.08,"frac":1.0,"status":"ok","matched":25,"words":25},"differ":false},{"i":15,"text":"You clear your throat. “Actually, I don’t think you should worry about that. I have a feeling Adelaide will be a great festival city.”","isAppLine":false,"small":{"start":126.368,"end":132.7,"frac":0.958,"status":"ok","matched":23,"words":24},"large":{"start":126.368,"end":132.832,"frac":1.0,"status":"ok","matched":24,"words":24},"differ":false},{"i":16,"text":"His eyes brighten. “You think?”","isAppLine":false,"small":{"start":132.7,"end":135.168,"frac":1.0,"status":"ok","matched":5,"words":5},"large":{"start":133.312,"end":135.168,"frac":1.0,"status":"ok","matched":5,"words":5},"differ":true},{"i":17,"text":"“Oh yeah,” you say. “I’ll bet there’ll be dozens of theatres, and festivals every year, where people come from all around Australia to watch hundreds of shows.”","isAppLine":false,"small":{"start":135.712,"end":143.94,"frac":1.0,"status":"ok","matched":27,"words":27},"large":{"start":135.712,"end":143.84,"frac":1.0,"status":"ok","matched":27,"words":27},"differ":false},{"i":18,"text":"Lazar grins at the thought.","isAppLine":false,"small":{"start":143.94,"end":145.344,"frac":1.0,"status":"ok","matched":5,"words":5},"large":{"start":143.84,"end":145.344,"frac":1.0,"status":"ok","matched":5,"words":5},"differ":false},{"i":19,"text":"“Quick!” hisses the Professor, the machine buzzing in his arms. “I think this thing’s about to go off again, we need to get to open space.”","isAppLine":false,"small":{"start":145.696,"end":153.952,"frac":1.0,"status":"ok","matched":26,"words":26},"large":{"start":145.696,"end":153.952,"frac":1.0,"status":"ok","matched":26,"words":26},"differ":false},{"i":20,"text":"“Hey, I think I just inspired him not to give up on his dream!” you say proudly.","isAppLine":false,"small":{"start":154.368,"end":157.92,"frac":1.0,"status":"ok","matched":17,"words":17},"large":{"start":154.368,"end":157.92,"frac":1.0,"status":"ok","matched":17,"words":17},"differ":false},{"i":21,"text":"“Who, Lazar?” says the Professor, looking back at him. “No, he quits the theatre and goes into politics.”","isAppLine":false,"small":{"start":158.816,"end":165.696,"frac":0.944,"status":"ok","matched":17,"words":18},"large":{"start":158.816,"end":165.696,"frac":0.944,"status":"ok","matched":17,"words":18},"differ":false},{"i":22,"text":"“Oh,” you say, a little disappointed.","isAppLine":false,"small":{"start":166.08,"end":168.38,"frac":1.0,"status":"ok","matched":6,"words":6},"large":{"start":166.08,"end":168.544,"frac":1.0,"status":"ok","matched":6,"words":6},"differ":false},{"i":23,"text":"“Forget that!” he says, trying to connect the car antenna to a wire on the machine.","isAppLine":false,"small":{"start":168.832,"end":172.88,"frac":1.0,"status":"ok","matched":16,"words":16},"large":{"start":168.832,"end":173.02,"frac":1.0,"status":"ok","matched":16,"words":16},"differ":false},{"i":24,"text":"“Where do we take this thing where it’s not going to warp the course of history and blow things up again? Light Square’s closer, but Victoria Square’s bigger. What do you think?”","isAppLine":false,"small":{"start":172.88,"end":184.608,"frac":1.0,"status":"ok","matched":32,"words":32},"large":{"start":173.02,"end":184.608,"frac":0.969,"status":"ok","matched":31,"words":32},"differ":false},{"i":25,"text":"Do you:","isAppLine":false,"small":{"start":186.976,"end":187.4,"frac":1.0,"status":"ok","matched":2,"words":2},"large":{"start":186.976,"end":187.424,"frac":1.0,"status":"ok","matched":2,"words":2},"differ":false},{"i":26,"text":"Light Square (1841->1892): Take it to Light Square, a more immediate yet potentially too small location.","isAppLine":false,"small":{"start":188.096,"end":193.088,"frac":0.765,"status":"ok","matched":13,"words":17},"large":{"start":188.096,"end":193.088,"frac":0.765,"status":"ok","matched":13,"words":17},"differ":false},{"i":27,"text":"Or","isAppLine":false,"small":{"start":193.696,"end":193.92,"frac":1.0,"status":"ok","matched":1,"words":1},"large":{"start":193.696,"end":193.84,"frac":1.0,"status":"ok","matched":1,"words":1},"differ":false},{"i":28,"text":"Reconciliation Plaza/Tarntanyangga (1841->40,000 BC): Take it to Victoria Square, the further, yet potentially safer option. You better hurry then!","isAppLine":false,"small":{"start":194.72,"end":201.184,"frac":0.682,"status":"ok","matched":15,"words":22},"large":{"start":194.72,"end":201.184,"frac":0.682,"status":"ok","matched":15,"words":22},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/61de19d6609d7_BC6_final.jpg"}