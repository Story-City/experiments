206,0.084,0.146,0.147,0.044,0.114,0.1,0.038,0.086,0.067,0.042,0.053,0.028,0.019,0.032,0.012,0.019,0.012,0.005,0.003,0.004,0.001,0.0],"paragraphs":[{"i":0,"text":"A haze of fog blurs the majestic sight of the giant stained-glass circular window at the front of the cathedral, and you feel the giddy feeling in your stomach of time travel once again. The bells of a tram clang in your ears. The Professor points at a lamp post.","isAppLine":false,"small":{"start":6.464,"end":20.8,"frac":0.98,"status":"ok","matched":50,"words":51},"large":{"start":6.464,"end":20.48,"frac":0.922,"status":"ok","matched":47,"words":51},"differ":false},{"i":1,"text":"“Electric lights, electric trams, and look at the cars,” he says as one chugs by, tooting its horn. “It’s the fifties, I’d bet.”","isAppLine":false,"small":{"start":21.056,"end":29.18,"frac":0.957,"status":"ok","matched":22,"words":23},"large":{"start":21.056,"end":29.1,"frac":0.913,"status":"ok","matched":21,"words":23},"differ":false},{"i":2,"text":"He uncoils the copper wire from the market and wastes no time climbing the side of the bell-tower, which looks shorter than you remember, only about the same height of the nave. As he climbs, a priest in a white robe emerges from the entrance and looks up.","isAppLine":false,"small":{"start":29.76,"end":43.104,"frac":0.98,"status":"ok","matched":48,"words":49},"large":{"start":29.1,"end":43.104,"frac":0.98,"status":"ok","matched":48,"words":49},"differ":true},{"i":3,"text":"“Ah, you must be the surveyors for the extension to the bell-tower,” he says.","isAppLine":false,"small":{"start":43.456,"end":47.744,"frac":0.867,"status":"ok","matched":13,"words":15},"large":{"start":43.456,"end":47.62,"frac":0.867,"status":"ok","matched":13,"words":15},"differ":false},{"i":4,"text":"You decide not to worry him, and nod.","isAppLine":false,"small":{"start":47.904,"end":49.696,"frac":1.0,"status":"ok","matched":8,"words":8},"large":{"start":47.904,"end":49.696,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":false},{"i":5,"text":"“I do hope your friend is careful on that stonework, only this is the oldest cathedral in Adelaide, you understand.”","isAppLine":false,"small":{"start":49.92,"end":55.88,"frac":1.0,"status":"ok","matched":20,"words":20},"large":{"start":49.92,"end":56.096,"frac":1.0,"status":"ok","matched":20,"words":20},"differ":false},{"i":6,"text":"“Really?” you say. You smile, trying to make a joke. “Oh well, it is the City of Churches, I’m sure you’ve got spares!”","isAppLine":false,"small":{"start":56.544,"end":63.2,"frac":1.0,"status":"ok","matched":23,"words":23},"large":{"start":56.544,"end":63.2,"frac":1.0,"status":"ok","matched":23,"words":23},"differ":false},{"i":7,"text":"He doesn’t get it. “Well, yes, but each one is different, and important! You see, South Australia was founded as a free state, where settlers were free to bring their beliefs with them from wherever they came from. Religious groups of any denomination were allowed a parcel of land, so most of them used it to build their churches. Now there are churches from every era in our history, and from many different religions, countries and creeds. It just shows what this city stands for: freedom and diversity.”","isAppLine":false,"small":{"start":63.712,"end":93.44,"frac":1.0,"status":"ok","matched":88,"words":88},"large":{"start":63.712,"end":93.44,"frac":1.0,"status":"ok","matched":88,"words":88},"differ":false},{"i":8,"text":"“Ready?” shouts the Professor. “Turn it on!”","isAppLine":false,"small":{"start":94.016,"end":97.58,"frac":0.714,"status":"ok","matched":5,"words":7},"large":{"start":93.696,"end":97.44,"frac":1.0,"status":"ok","matched":7,"words":7},"differ":false},{"i":9,"text":"You turn a dial on the machine, and a low rumbling fills the air. The priest frowns.","isAppLine":false,"small":{"start":98.08,"end":102.752,"frac":1.0,"status":"ok","matched":17,"words":17},"large":{"start":98.08,"end":102.7,"frac":1.0,"status":"ok","matched":17,"words":17},"differ":false},{"i":10,"text":"“What is that?” he asks.","isAppLine":false,"small":{"start":103.008,"end":104.48,"frac":1.0,"status":"ok","matched":5,"words":5},"large":{"start":103.008,"end":104.48,"frac":1.0,"status":"ok","matched":5,"words":5},"differ":false},{"i":11,"text":"“Don’t worry,” you say, “this is normal.”","isAppLine":false,"small":{"start":105.696,"end":107.584,"frac":1.0,"status":"ok","matched":7,"words":7},"large":{"start":105.696,"end":107.5,"frac":1.0,"status":"ok","matched":7,"words":7},"differ":false},{"i":12,"text":"The ground begins to shake, and you notice cracks beginning to form in the gothic brickwork.","isAppLine":false,"small":{"start":107.84,"end":111.78,"frac":1.0,"status":"ok","matched":16,"words":16},"large":{"start":107.84,"end":111.968,"frac":1.0,"status":"ok","matched":16,"words":16},"differ":false},{"i":13,"text":"“But that’s not…”","isAppLine":false,"small":{"start":112.16,"end":113.7,"frac":1.0,"status":"ok","matched":3,"words":3},"large":{"start":112.992,"end":113.64,"frac":1.0,"status":"ok","matched":3,"words":3},"differ":true},{"i":14,"text":"The Professor, clinging to the side of the cathedral spire, hugs the stones nervously.","isAppLine":false,"small":{"start":114.208,"end":118.22,"frac":1.0,"status":"ok","matched":14,"words":14},"large":{"start":114.208,"end":118.304,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":false},{"i":15,"text":"“It’s an earthquake!” he says, as chips of stone crack loose and drop to the ground.","isAppLine":false,"small":{"start":118.592,"end":123.76,"frac":0.938,"status":"ok","matched":15,"words":16},"large":{"start":118.592,"end":123.76,"frac":0.938,"status":"ok","matched":15,"words":16},"differ":false},{"i":16,"text":"The priest ducks and darts aside as they fall. From all around the city, loud cracks like fireworks are echoing as buildings rupture and split.","isAppLine":false,"small":{"start":123.76,"end":132.28,"frac":1.0,"status":"ok","matched":25,"words":25},"large":{"start":123.76,"end":132.48,"frac":1.0,"status":"ok","matched":25,"words":25},"differ":false},{"i":17,"text":"“Maybe someone up there is angry,” says the priest, pointing at the sky.","isAppLine":false,"small":{"start":132.28,"end":136.34,"frac":1.0,"status":"ok","matched":13,"words":13},"large":{"start":132.48,"end":136.44,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false},{"i":18,"text":"The Professor shakes his head, and points downward. “No, it’s more likely to coming from down there! The city’s built on two fault lines, two sides squeezing together, pushing the ground up: that’s why the Adelaide Hills are there!”","isAppLine":false,"small":{"start":136.704,"end":149.504,"frac":1.0,"status":"ok","matched":39,"words":39},"large":{"start":136.704,"end":149.5,"frac":1.0,"status":"ok","matched":39,"words":39},"differ":false},{"i":19,"text":"He ducks as a brick sails past his head, and explodes on the ground by your feet.","isAppLine":false,"small":{"start":149.76,"end":153.6,"frac":1.0,"status":"ok","matched":17,"words":17},"large":{"start":149.76,"end":153.6,"frac":1.0,"status":"ok","matched":17,"words":17},"differ":false},{"i":20,"text":"“Um, maybe we save the lesson until after we’re home!” you shout. “This feels like a big one!”","isAppLine":false,"small":{"start":153.952,"end":159.872,"frac":1.0,"status":"ok","matched":18,"words":18},"large":{"start":153.952,"end":159.8,"frac":1.0,"status":"ok","matched":18,"words":18},"differ":false},{"i":21,"text":"The Professor nods, enthusiastically. “Oh yes, five-point-five on the Richter scale, at least!”","isAppLine":false,"small":{"start":160.192,"end":165.72,"frac":0.8,"status":"ok","matched":12,"words":15},"large":{"start":160.192,"end":165.824,"frac":0.8,"status":"ok","matched":12,"words":15},"differ":false},{"i":22,"text":"You plug the antenna into the time machine, and hit the buttons at random.","isAppLine":false,"small":{"start":166.272,"end":169.44,"frac":1.0,"status":"ok","matched":14,"words":14},"large":{"start":166.272,"end":169.26,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":false},{"i":23,"text":"Just then, there is a loud CRACK and the stones that the Professor is holding break loose.","isAppLine":false,"small":{"start":169.632,"end":174.048,"frac":1.0,"status":"ok","matched":17,"words":17},"large":{"start":169.632,"end":174.048,"frac":1.0,"status":"ok","matched":17,"words":17},"differ":false},{"i":24,"text":"“AAAAAGGHHHH!!!” he shouts as he falls…","isAppLine":false,"small":{"start":176.576,"end":176.992,"frac":0.833,"status":"ok","matched":5,"words":6},"large":{"start":174.4,"end":176.992,"frac":0.833,"status":"ok","matched":5,"words":6},"differ":true},{"i":25,"text":"…time warps…","isAppLine":false,"small":{"start":177.376,"end":178.3,"frac":1.0,"status":"ok","matched":2,"words":2},"large":{"start":177.376,"end":178.22,"frac":1.0,"status":"ok","matched":2,"words":2},"differ":false},{"i":26,"text":"…and the Professor is frozen, surrounded by stones, all hovering a few foot above the ground. You look around: cars, traffic lights, someone talking on a mobile phone.","isAppLine":false,"small":{"start":178.3,"end":188.256,"frac":0.964,"status":"ok","matched":27,"words":28},"large":{"start":178.22,"end":188.256,"frac":0.964,"status":"ok","matched":27,"words":28},"differ":false},{"i":27,"text":"“We made it! We’re back!” you shout.","isAppLine":false,"small":{"start":188.608,"end":191.54,"frac":1.0,"status":"ok","matched":7,"words":7},"large":{"start":188.608,"end":191.56,"frac":1.0,"status":"ok","matched":7,"words":7},"differ":false},{"i":28,"text":"“Oh good!” says the Professor, and falls flat on his face. “Ow.”","isAppLine":false,"small":{"start":192.16,"end":195.744,"frac":0.917,"status":"ok","matched":11,"words":12},"large":{"start":192.16,"end":195.744,"frac":0.917,"status":"ok","matched":11,"words":12},"differ":false},{"i":29,"text":"~END~","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":1},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":1},"differ":false},{"i":30,"text":"Congratulations! You made it back. Don’t forget to upload a pic of you on your adventure to Facebook, Instagram or Twitter with the hashtags #StoryCity #TimeCaper","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":26},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":26},"differ":false},{"i":31,"text":"This is the end of your adventure but you can head back to the starting point to explore a different story path, or you can try the other Story City: Adelaide adventure, Ready or Not: Hide & Seek Alien Style.","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":39},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":39},"differ":false}],"unassigned":{"small":[],"large":[{"start":195.54,"end":232.8,"words":8,"text":"oh oh well be right back thank you"}]},"image":"https://creator.storycity.app/media/61de1b57c228c_BC15_final.jpg"}