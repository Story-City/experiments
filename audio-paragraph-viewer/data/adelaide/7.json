86,0.055,0.146,0.077,0.047,0.113,0.101,0.037,0.059,0.088,0.042,0.053,0.057,0.02,0.026,0.032,0.01,0.006,0.019,0.006,0.003,0.004,0.002,0.001,0.0],"paragraphs":[{"i":0,"text":"“Look out!” shouts the Professor, and the air fills with the roar of an angry crowd. You duck as a brick sails through the air towards you, straight over your head, and… THWACK! Hits a man square between the eyes.","isAppLine":false,"small":{"start":3.008,"end":14.816,"frac":0.975,"status":"ok","matched":39,"words":40},"large":{"start":3.008,"end":14.74,"frac":1.0,"status":"ok","matched":40,"words":40},"differ":false},{"i":1,"text":"You watch him sway for a moment, then he drops backwards like a falling tree.","isAppLine":false,"small":{"start":15.104,"end":18.976,"frac":1.0,"status":"ok","matched":15,"words":15},"large":{"start":15.104,"end":18.976,"frac":1.0,"status":"ok","matched":15,"words":15},"differ":false},{"i":2,"text":"“It’s the 1855 Hindley Street Riot!” shouts the Professor, as you hurry up the street, away from the huge crowd of angry men who are roaring and brandishing bricks. The Austral Stores has not been built yet, instead there is just a row of shack-like shops.","isAppLine":false,"small":{"start":19.2,"end":34.48,"frac":0.957,"status":"ok","matched":45,"words":47},"large":{"start":19.2,"end":34.22,"frac":0.979,"status":"ok","matched":46,"words":47},"differ":false},{"i":3,"text":"You barely get three steps before you are stopped in your tracks by another angry mob, even louder than the first, coming towards you from the other direction.","isAppLine":false,"small":{"start":34.48,"end":42.304,"frac":1.0,"status":"ok","matched":28,"words":28},"large":{"start":34.22,"end":42.26,"frac":1.0,"status":"ok","matched":28,"words":28},"differ":false},{"i":4,"text":"A man in the first crowd shouts to be heard over the din, pointing a finger accusingly at the other crowd. “We saw you in the pub, we know your lot voted for Forster!”","isAppLine":false,"small":{"start":42.56,"end":52.544,"frac":1.0,"status":"ok","matched":34,"words":34},"large":{"start":42.56,"end":52.5,"frac":1.0,"status":"ok","matched":34,"words":34},"differ":false},{"i":5,"text":"You duck as the crowd roars angrily and a hail of bricks and rocks is exchanged. Then a man from the second crowd calls out, shaking his fist at the first mob. “Well we saw you in the pub, we know your lot voted for Fisher!”","isAppLine":false,"small":{"start":52.768,"end":65.6,"frac":1.0,"status":"ok","matched":46,"words":46},"large":{"start":52.768,"end":65.34,"frac":1.0,"status":"ok","matched":46,"words":46},"differ":false},{"i":6,"text":"Another barrage of debris, and angry shouts. Then a man staggers from the first crowd towards you, pointing a finger in your face. You wince as the alcohol on his breath stings your eyes.","isAppLine":false,"small":{"start":65.6,"end":75.616,"frac":1.0,"status":"ok","matched":34,"words":34},"large":{"start":65.34,"end":75.616,"frac":1.0,"status":"ok","matched":34,"words":34},"differ":false},{"i":7,"text":"“You,” he says, suspiciously. “Who are you going to vote for, Fisher or Forster?”","isAppLine":false,"small":{"start":75.904,"end":81.408,"frac":1.0,"status":"ok","matched":14,"words":14},"large":{"start":75.904,"end":81.408,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":false},{"i":8,"text":"“Um,” you say, looking back and forth at the two crowds. “Maybe it’s better if nobody knows who I vote for?”","isAppLine":false,"small":{"start":82.016,"end":89.088,"frac":0.952,"status":"ok","matched":20,"words":21},"large":{"start":82.016,"end":89.0,"frac":0.952,"status":"ok","matched":20,"words":21},"differ":false},{"i":9,"text":"The crowd falls silent for a moment. Somewhere up the street, there is the tinkle of broken glass falling out of a smashed window.","isAppLine":false,"small":{"start":89.344,"end":95.36,"frac":0.917,"status":"ok","matched":22,"words":24},"large":{"start":89.344,"end":95.36,"frac":0.917,"status":"ok","matched":22,"words":24},"differ":false},{"i":10,"text":"“What, you mean, vote in secret?”","isAppLine":false,"small":{"start":95.52,"end":98.4,"frac":1.0,"status":"ok","matched":6,"words":6},"large":{"start":95.52,"end":98.4,"frac":1.0,"status":"ok","matched":6,"words":6},"differ":false},{"i":11,"text":"“Um, yeah? I mean, it might stop this kind of thing happening?”","isAppLine":false,"small":{"start":100.032,"end":102.624,"frac":1.0,"status":"ok","matched":12,"words":12},"large":{"start":98.944,"end":102.5,"frac":1.0,"status":"ok","matched":12,"words":12},"differ":true},{"i":12,"text":"A few heads begin to nod.","isAppLine":false,"small":{"start":102.912,"end":104.384,"frac":1.0,"status":"ok","matched":6,"words":6},"large":{"start":102.912,"end":104.36,"frac":1.0,"status":"ok","matched":6,"words":6},"differ":false},{"i":13,"text":"“And maybe it’d be better not to vote in the pub?” you suggest.","isAppLine":false,"small":{"start":105.76,"end":108.576,"frac":0.923,"status":"ok","matched":12,"words":13},"large":{"start":104.64,"end":108.48,"frac":0.923,"status":"ok","matched":12,"words":13},"differ":true},{"i":14,"text":"You duck as a brick sails past your head, and both crowds start to roar again, even louder than before.","isAppLine":false,"small":{"start":108.768,"end":114.14,"frac":1.0,"status":"ok","matched":20,"words":20},"large":{"start":108.768,"end":114.16,"frac":1.0,"status":"ok","matched":20,"words":20},"differ":false},{"i":15,"text":"The Professor grabs your arm.","isAppLine":false,"small":{"start":114.14,"end":115.872,"frac":1.0,"status":"ok","matched":5,"words":5},"large":{"start":114.16,"end":115.872,"frac":1.0,"status":"ok","matched":5,"words":5},"differ":false},{"i":16,"text":"“I think we’d better get out of here!”","isAppLine":false,"small":{"start":116.032,"end":117.68,"frac":1.0,"status":"ok","matched":8,"words":8},"large":{"start":116.032,"end":117.664,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":false},{"i":17,"text":"He fires up the machine, as a hail of stones is launched at you. You clench your eyes shut…","isAppLine":false,"small":{"start":118.176,"end":127.456,"frac":1.0,"status":"ok","matched":19,"words":19},"large":{"start":118.176,"end":127.4,"frac":1.0,"status":"ok","matched":19,"words":19},"differ":false},{"i":18,"text":"…but nothing hits you.","isAppLine":false,"small":{"start":127.968,"end":128.768,"frac":1.0,"status":"ok","matched":4,"words":4},"large":{"start":127.968,"end":128.72,"frac":1.0,"status":"ok","matched":4,"words":4},"differ":false},{"i":19,"text":"You open your eyes. The Austral stores, Byzantine and carnivalesque with their arches and turrets, stand calmly over the street—a monument to the calmer times when coffee palaces took over from the taverns. A modern car drones by. “Are we back?” you ask.","isAppLine":false,"small":{"start":128.992,"end":144.8,"frac":0.955,"status":"ok","matched":42,"words":44},"large":{"start":128.992,"end":144.56,"frac":1.0,"status":"ok","matched":44,"words":44},"differ":false},{"i":20,"text":"The Professor scans the street. “Well, nobody’s trying to arrest or kill us, so I think so. It’s funny what you said to the rioters back there—you know, the secret ballot was adopted in Australia just after that riot! You don’t think… maybe…?”","isAppLine":false,"small":{"start":144.992,"end":160.38,"frac":1.0,"status":"ok","matched":44,"words":44},"large":{"start":144.992,"end":160.7,"frac":1.0,"status":"ok","matched":44,"words":44},"differ":false},{"i":21,"text":"He lets the thought linger. You watch the people in the street, wondering if they have any idea what kind of adventures took place right here, in the past. For that matter, what kind of adventures will happen here in the future?","isAppLine":false,"small":{"start":161.376,"end":173.76,"frac":1.0,"status":"ok","matched":42,"words":42},"large":{"start":161.376,"end":173.76,"frac":1.0,"status":"ok","matched":42,"words":42},"differ":false},{"i":22,"text":"~END~","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":1},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":1},"differ":false},{"i":23,"text":"Congratulations! You made it back. Don’t forget to upload a pic of you on your adventure to Facebook, Instagram or Twitter with the hashtags #StoryCity #TimeCaper","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":26},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":26},"differ":false},{"i":24,"text":"This is the end of your adventure but you can head back to the starting point to explore a different story path, or you can try the other Story City: Adelaide adventure, Ready or Not: Hide & Seek Alien Style.","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":39},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":39},"differ":false}],"unassigned":{"small":[],"large":[{"start":184.48,"end":207.62,"words":6,"text":"well be right back thank you"}]},"image":"https://creator.storycity.app/media/61de1ab87f9cf_BC11_final.jpg"}