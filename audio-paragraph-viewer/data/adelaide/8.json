{"story":"adelaide","order":8,"name":"[9] Elder Hall (1925 -> 1908)","audio":"https://sc-web-client-prod.s3-us-west-2.amazonaws.com/media/wp-content/uploads/2015/09/BC_8.mp3?_=8","audioFile":"BC_8.mp3","duration":221.256,"peaks":[0.09,0.179,0.226,0.248,0.219,0.376,0.474,0.485,0.662,0.766,0.382,0.809,0.799,0.966,0.917,0.915,0.62,0.027,0.916,0.912,0.925,0.62,0.765,0.648,0.839,0.896,0.66,0.073,0.228,0.836,0.965,0.884,0.924,0.903,0.929,0.922,0.31,0.052,0.909,0.93,0.859,0.846,0.776,0.843,0.95,0.587,0.83,0.725,0.051,0.272,0.893,0.757,0.927,0.969,0.524,0.948,0.89,0.634,0.899,0.895,0.927,0.863,0.772,0.019,0.874,0.76,0.802,0.099,0.874,0.893,0.809,0.941,0.886,0.938,0.854,0.658,0.649,0.302,0.839,0.735,0.651,0.84,0.886,0.917,0.889,0.95,0.942,0.976,0.649,0.468,0.058,0.937,0.89,0.91,0.865,0.895,0.972,0.887,0.781,0.921,0.758,0.95,0.877,0.78,0.678,0.071,0.882,0.881,0.95,0.958,0.876,0.855,0.89,0.898,0.909,0.904,0.819,0.484,0.861,0.888,0.541,0.941,0.827,0.767,0.761,0.934,0.933,0.473,0.811,0.692,0.172,0.037,0.056,0.694,0.783,0.697,0.128,0.751,0.79,0.205,0.022,0.484,0.499,0.373,0.163,0.479,0.498,0.476,0.455,0.221,0.089,0.166,0.455,0.442,0.481,0.515,0.451,0.351,0.471,0.325,0.635,0.525,0.53,0.564,0.354,0.62,0.542,0.556,0.586,0.761,0.571,0.733,0.495,0.683,0.194,0.696,0.588,0.603,0.86,0.792,0.838,0.541,0.715,0.722,0.38,0.565,0.897,0.736,0.878,0.682,0.856,0.583,0.334,0.135,0.681,0.715,0.399,0.849,0.75,0.756,0.668,0.7,0.768,0.712,0.608,0.781,0.814,0.763,0.773,0.786,0.884,0.739,0.963,0.802,0.801,0.693,0.683,0.861,0.897,0.609,0.678,0.82,0.7,0.796,0.847,0.728,0.779,0.733,0.779,0.754,0.779,0.506,0.024,0.019,0.9,0.704,0.897,0.83,0.743,0.395,0.033,0.854,0.728,0.63,0.894,0.851,0.94,0.873,0.608,0.513,0.457,0.788,0.769,0.795,0.242,0.95,0.844,0.837,0.926,0.492,0.241,0.829,0.77,0.779,0.581,0.112,0.212,0.724,0.704,0.521,0.769,0.806,0.209,0.649,0.689,0.625,0.508,0.528,0.656,0.115,0.002,0.836,0.804,0.787,0.125,0.898,0.778,0.726,0.599,0.121,0.491,0.847,0.403,0.974,0.882,0.727,0.398,0.76,0.489,0.574,0.195,0