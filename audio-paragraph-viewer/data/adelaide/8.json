1,0.109,0.077,0.036,0.088,0.058,0.044,0.052,0.044,0.018,0.032,0.019,0.006,0.02,0.01,0.002,0.004,0.003,0.001,0.0],"paragraphs":[{"i":0,"text":"You reach the university, the time machine clutched under your arms. The Professor didn’t even say goodbye! All this time travel must have done something to his brain.","isAppLine":false,"small":{"start":2.56,"end":10.656,"frac":1.0,"status":"ok","matched":28,"words":28},"large":{"start":2.56,"end":10.656,"frac":1.0,"status":"ok","matched":28,"words":28},"differ":false},{"i":1,"text":"Strains of music drift across the courtyard from Elder Hall. With its turrets, archways, stained glass windows and steeple, it looks more like a church than a university building.","isAppLine":false,"small":{"start":10.976,"end":19.936,"frac":1.0,"status":"ok","matched":29,"words":29},"large":{"start":10.976,"end":19.936,"frac":1.0,"status":"ok","matched":29,"words":29},"differ":false},{"i":2,"text":"You hear the sound of two bickering voices approaching from behind the hall. A young man and an older man, both in mortarboards and black gowns are gesturing as they argue. They look somehow… familiar.","isAppLine":false,"small":{"start":20.16,"end":30.64,"frac":1.0,"status":"ok","matched":35,"words":35},"large":{"start":20.16,"end":30.46,"frac":1.0,"status":"ok","matched":35,"words":35},"differ":false},{"i":3,"text":"“But if we bounced something off the crystals, something that could reflect their structure…”","isAppLine":false,"small":{"start":31.296,"end":35.68,"frac":1.0,"status":"ok","matched":14,"words":14},"large":{"start":31.296,"end":35.58,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":false},{"i":4,"text":"“No, no, no, boy, it’s nonsense! What are crystals made of?”","isAppLine":false,"small":{"start":35.68,"end":40.16,"frac":1.0,"status":"ok","matched":11,"words":11},"large":{"start":35.58,"end":40.12,"frac":1.0,"status":"ok","matched":11,"words":11},"differ":false},{"i":5,"text":"“Atoms!”","isAppLine":false,"small":{"start":40.16,"end":42.22,"frac":1.0,"status":"ok","matched":1,"words":1},"large":{"start":40.12,"end":40.4,"frac":1.0,"status":"ok","matched":1,"words":1},"differ":true},{"i":6,"text":"“And how big are atoms?”","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":5},"large":{"start":40.4,"end":42.56,"frac":0.8,"status":"ok","matched":4,"words":5},"differ":true},{"i":7,"text":"“Tiny!”","isAppLine":false,"small":{"start":43.0,"end":43.3,"frac":1.0,"status":"ok","matched":1,"words":1},"large":{"start":42.56,"end":43.0,"frac":1.0,"status":"ok","matched":1,"words":1},"differ":false},{"i":8,"text":"“So it would take some kind of high-energy radiation! I mean, the kind of rays that pass right through soft matter and bounces off dense matter!”","isAppLine":false,"small":{"start":43.3,"end":51.1,"frac":0.926,"status":"ok","matched":25,"words":27},"large":{"start":43.0,"end":51.0,"frac":0.926,"status":"ok","matched":25,"words":27},"differ":false},{"i":9,"text":"That sounds familiar to you. “Oh, like x-rays!” you say.","isAppLine":false,"small":{"start":52.0,"end":55.264,"frac":1.0,"status":"ok","matched":11,"words":11},"large":{"start":52.0,"end":55.264,"frac":1.0,"status":"ok","matched":11,"words":11},"differ":false},{"i":10,"text":"“Exactly,” says the older man, grumpily, “like x-rays.”","isAppLine":false,"small":{"start":55.488,"end":58.848,"frac":1.0,"status":"ok","matched":9,"words":9},"large":{"start":55.488,"end":58.7,"frac":1.0,"status":"ok","matched":9,"words":9},"differ":false},{"i":11,"text":"The two men look at each other, their expressions changing.","isAppLine":false,"small":{"start":59.072,"end":61.792,"frac":1.0,"status":"ok","matched":10,"words":10},"large":{"start":59.072,"end":61.792,"frac":1.0,"status":"ok","matched":10,"words":10},"differ":false},{"i":12,"text":"“X-rays! Of course! Why x-rays could be the secret to the whole nature of crystallography! Oh, ho, my boy, I could win a Nobel Prize for this!”","isAppLine":false,"small":{"start":62.24,"end":72.32,"frac":0.966,"status":"ok","matched":28,"words":29},"large":{"start":62.24,"end":72.3,"frac":0.966,"status":"ok","matched":28,"words":29},"differ":false},{"i":13,"text":"“What do you mean you could win a Nobel Prize?”","isAppLine":false,"small":{"start":72.48,"end":74.944,"frac":1.0,"status":"ok","matched":10,"words":10},"large":{"start":72.48,"end":74.944,"frac":1.0,"status":"ok","matched":10,"words":10},"differ":false},{"i":14,"text":"And the bickering starts again. Then you realise why you recognise their faces: they look like the Professor! They must be his distant ancestors!","isAppLine":false,"small":{"start":75.232,"end":82.56,"frac":1.0,"status":"ok","matched":24,"words":24},"large":{"start":75.232,"end":82.56,"frac":1.0,"status":"ok","matched":24,"words":24},"differ":false},{"i":15,"text":"“Are either of your names… Bragg?”","isAppLine":false,"small":{"start":82.88,"end":84.576,"frac":1.0,"status":"ok","matched":6,"words":6},"large":{"start":82.88,"end":84.48,"frac":1.0,"status":"ok","matched":6,"words":6},"differ":false},{"i":16,"text":"“Yes!” they both exclaim, turning to look at you. Then the younger Bragg catches sight of the machine under your arm.","isAppLine":false,"small":{"start":84.768,"end":90.368,"frac":1.0,"status":"ok","matched":21,"words":21},"large":{"start":84.768,"end":90.368,"frac":1.0,"status":"ok","matched":21,"words":21},"differ":false},{"i":17,"text":"“Dad, look at this!”","isAppLine":false,"small":{"start":90.592,"end":91.904,"frac":1.0,"status":"ok","matched":4,"words":4},"large":{"start":90.592,"end":91.84,"frac":1.0,"status":"ok","matched":4,"words":4},"differ":false},{"i":18,"text":"He snatches the machine from your hands and turns it over, admiringly.","isAppLine":false,"small":{"start":92.096,"end":95.584,"frac":1.0,"status":"ok","matched":12,"words":12},"large":{"start":92.096,"end":95.584,"frac":1.0,"status":"ok","matched":12,"words":12},"differ":false},{"i":19,"text":"“Well, well, well, son, if I didn’t know any better I’d say it’s a portable-trans-temporal-teleportation device.”","isAppLine":false,"small":{"start":95.904,"end":102.528,"frac":0.947,"status":"ok","matched":18,"words":19},"large":{"start":95.904,"end":102.528,"frac":0.947,"status":"ok","matched":18,"words":19},"differ":false},{"i":20,"text":"“No,” you say, disappointed, “it’s a time machine.”","isAppLine":false,"small":{"start":103.712,"end":106.528,"frac":1.0,"status":"ok","matched":8,"words":8},"large":{"start":103.712,"end":106.24,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":false},{"i":21,"text":"The older Bragg sniffs and pokes at it. “It’s a bit worse for wear.”","isAppLine":false,"small":{"start":106.88,"end":110.52,"frac":1.0,"status":"ok","matched":14,"words":14},"large":{"start":106.88,"end":110.66,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":false},{"i":22,"text":"The younger Bragg pulls open a panel and starts picking at the components.","isAppLine":false,"small":{"start":111.072,"end":114.14,"frac":1.0,"status":"ok","matched":13,"words":13},"large":{"start":111.072,"end":114.3,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false},{"i":23,"text":"“Nothing that can’t be fixed. Look, this must create the electromagnetic field.”","isAppLine":false,"small":{"start":114.56,"end":118.88,"frac":1.0,"status":"ok","matched":12,"words":12},"large":{"start":114.56,"end":119.1,"frac":1.0,"status":"ok","matched":12,"words":12},"differ":false},{"i":24,"text":"Now both their faces are buried in the machine, father and son tinkering with its insides.","isAppLine":false,"small":{"start":119.328,"end":124.06,"frac":1.0,"status":"ok","matched":16,"words":16},"large":{"start":119.328,"end":124.224,"frac":1.0,"status":"ok","matched":16,"words":16},"differ":false},{"i":25,"text":"“And here’s some sort of wireless transmission gadget.”","isAppLine":false,"small":{"start":124.512,"end":127.32,"frac":0.75,"status":"ok","matched":6,"words":8},"large":{"start":124.512,"end":127.34,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":false},{"i":26,"text":"“Which means, by my calculation…”","isAppLine":false,"small":{"start":127.32,"end":129.48,"frac":1.0,"status":"ok","matched":5,"words":5},"large":{"start":127.34,"end":129.98,"frac":1.0,"status":"ok","matched":5,"words":5},"differ":false},{"i":27,"text":"The older Bragg twists something inside, and the machine buzzes, fizzes, and whirs into life.","isAppLine":false,"small":{"start":129.48,"end":134.592,"frac":0.933,"status":"ok","matched":14,"words":15},"large":{"start":129.98,"end":134.36,"frac":1.0,"status":"ok","matched":15,"words":15},"differ":false},{"i":28,"text":"“You fixed it!” you cry. But the Braggs are already deep in conversation again.","isAppLine":false,"small":{"start":134.816,"end":138.912,"frac":1.0,"status":"ok","matched":14,"words":14},"large":{"start":134.816,"end":138.88,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":false},{"i":29,"text":"As they walk away, the courtyard twists and blurs for a moment. You feel giddy, then… modern cars, modern clothes, a plane flying overhead: you’re back!","isAppLine":false,"small":{"start":139.232,"end":149.536,"frac":0.923,"status":"ok","matched":24,"words":26},"large":{"start":139.232,"end":149.536,"frac":1.0,"status":"ok","matched":26,"words":26},"differ":false},{"i":30,"text":"“Excuse me,” says a voice behind you. It’s your old friend, the descendant of the Braggs!","isAppLine":false,"small":{"start":150.176,"end":155.04,"frac":1.0,"status":"ok","matched":16,"words":16},"large":{"start":150.176,"end":154.98,"frac":1.0,"status":"ok","matched":16,"words":16},"differ":false},{"i":31,"text":"“Professor!” you say.","isAppLine":false,"small":{"start":155.232,"end":156.416,"frac":1.0,"status":"ok","matched":3,"words":3},"large":{"start":155.232,"end":156.26,"frac":1.0,"status":"ok","matched":3,"words":3},"differ":false},{"i":32,"text":"But he looks at you, blankly. “Yes? Do I know you?”","isAppLin