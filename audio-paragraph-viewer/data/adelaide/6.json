.045,0.035,0.044,0.028,0.014,0.023,0.015,0.012,0.012,0.007,0.006,0.005,0.003,0.002,0.002,0.001,0.001,0.001,0.0,0.0,0.0],"paragraphs":[{"i":0,"text":"Time rolls forward as you arrive to see the Tower arise before your eyes! A second storey pops above the awnings of the street-front, turning the market into the fortress structure you’re familiar with. The sounds of car engines fill the air: time is clearly shifting you closer to home! A group of children roller-skate past you, while a man in flared trousers grooves to a disco beat blaring from his gigantic boom box.","isAppLine":false,"small":{"start":1.184,"end":24.256,"frac":0.987,"status":"ok","matched":75,"words":76},"large":{"start":1.184,"end":24.12,"frac":0.974,"status":"ok","matched":74,"words":76},"differ":false},{"i":1,"text":"“The seventies!” says the Professor excitedly, dancing to the music.","isAppLine":false,"small":{"start":24.64,"end":28.64,"frac":0.8,"status":"ok","matched":8,"words":10},"large":{"start":24.64,"end":28.64,"frac":0.8,"status":"ok","matched":8,"words":10},"differ":false},{"i":2,"text":"“But where is the machine?” you say, staring at the front of the market. It looks like a castle, only with more fruit and vegetables inside.","isAppLine":false,"small":{"start":29.568,"end":36.736,"frac":1.0,"status":"ok","matched":26,"words":26},"large":{"start":29.568,"end":36.736,"frac":1.0,"status":"ok","matched":26,"words":26},"differ":false},{"i":3,"text":"“It must still be here, after seventy years!”","isAppLine":false,"small":{"start":37.152,"end":40.32,"frac":0.875,"status":"ok","matched":7,"words":8},"large":{"start":37.152,"end":40.32,"frac":0.875,"status":"ok","matched":7,"words":8},"differ":false},{"i":4,"text":"“Where am I?!” you hear a voice cry. It’s the clerk, rubbing his spectacles as he stares at a Vietnamese family selling vegetables from a stand. They stare back at him, just as confused. You realise in horror: the clerk has been teleported too!","isAppLine":false,"small":{"start":41.152,"end":54.688,"frac":1.0,"status":"ok","matched":44,"words":44},"large":{"start":41.152,"end":54.68,"frac":1.0,"status":"ok","matched":44,"words":44},"differ":false},{"i":5,"text":"“The machine must have imprinted him,” says the Professor.","isAppLine":false,"small":{"start":55.104,"end":58.02,"frac":1.0,"status":"ok","matched":9,"words":9},"large":{"start":55.104,"end":58.272,"frac":1.0,"status":"ok","matched":9,"words":9},"differ":false},{"i":6,"text":"The clerk points at you. “You! You’re a wizard, you’ve teleported me all the way to the Far East!”","isAppLine":false,"small":{"start":58.592,"end":64.768,"frac":1.0,"status":"ok","matched":19,"words":19},"large":{"start":58.592,"end":64.768,"frac":1.0,"status":"ok","matched":19,"words":19},"differ":false},{"i":7,"text":"“No I haven’t,” you say, slapping his hand away. “You’re still in Adelaide, it’s just the nineteen-seventies.”","isAppLine":false,"small":{"start":65.248,"end":71.456,"frac":0.889,"status":"ok","matched":16,"words":18},"large":{"start":65.248,"end":71.34,"frac":0.889,"status":"ok","matched":16,"words":18},"differ":false},{"i":8,"text":"He picks up a bunch of small red balls from the stall. “Then what do you call these?”","isAppLine":false,"small":{"start":71.776,"end":76.096,"frac":0.944,"status":"ok","matched":17,"words":18},"large":{"start":71.776,"end":76.096,"frac":0.944,"status":"ok","matched":17,"words":18},"differ":false},{"i":9,"text":"“Pomegranates, I think,” you say, staring at them. “Where’s our machine?”","isAppLine":false,"small":{"start":77.248,"end":81.184,"frac":1.0,"status":"ok","matched":11,"words":11},"large":{"start":77.248,"end":80.96,"frac":1.0,"status":"ok","matched":11,"words":11},"differ":false},{"i":10,"text":"But he’s staring at the people and the stalls. The Professor approaches him, putting a hand on his shoulder.","isAppLine":false,"small":{"start":81.408,"end":85.86,"frac":0.842,"status":"ok","matched":16,"words":19},"large":{"start":81.408,"end":86.016,"frac":0.842,"status":"ok","matched":16,"words":19},"differ":false},{"i":11,"text":"“It’s not the nineteenth century any more, there are people from all over the world living here now. Immigrants from Vietnam, China, Korea, Thailand, Malaysia… you name it!”","isAppLine":false,"small":{"start":86.272,"end":97.12,"frac":0.893,"status":"ok","matched":25,"words":28},"large":{"start":86.272,"end":97.12,"frac":0.893,"status":"ok","matched":25,"words":28},"differ":false},{"i":12,"text":"The clerk looks at the Vietnamese family again, then at the pomegranate. He sniffs it, pulls open the skin, and touches his tongue to the seeds inside. His eyes widen. He smiles.","isAppLine":false,"small":{"start":97.504,"end":106.656,"frac":0.969,"status":"ok","matched":31,"words":32},"large":{"start":97.504,"end":106.56,"frac":1.0,"status":"ok","matched":32,"words":32},"differ":false},{"i":13,"text":"You look to the Professor for help, but he is busy buying a stir-fry.","isAppLine":false,"small":{"start":106.88,"end":110.144,"frac":0.8,"status":"ok","matched":12,"words":15},"large":{"start":106.88,"end":110.02,"frac":0.8,"status":"ok","matched":12,"words":15},"differ":false},{"i":14,"text":"“Listen, where did you last see our machine?”","isAppLine":false,"small":{"start":110.368,"end":112.44,"frac":1.0,"status":"ok","matched":8,"words":8},"large":{"start":110.368,"end":112.56,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":false},{"i":15,"text":"The clerk concentrates, looking at the different stalls.","isAppLine":false,"small":{"start":112.96,"end":115.808,"frac":1.0,"status":"ok","matched":8,"words":8},"large":{"start":112.96,"end":115.808,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":false},{"i":16,"text":"“It all looks so different, so much more… colourful!”","isAppLine":false,"small":{"start":116.256,"end":120.56,"frac":1.0,"status":"ok","matched":9,"words":9},"large":{"start":116.256,"end":120.4,"frac":1.0,"status":"ok","matched":9,"words":9},"differ":false},{"i":17,"text":"“Think!” you say. “The box, small, weird, with dials and gears…”","isAppLine":false,"small":{"start":121.088,"end":125.344,"frac":1.0,"status":"ok","matched":11,"words":11},"large":{"start":121.088,"end":125.344,"frac":1.0,"status":"ok","matched":11,"words":11},"differ":false},{"i":18,"text":"“Excuse me,” says a voice. You look around, and see a pair of eyes peering over a pile of cabbages. It is a small girl, the daughter of the Vietnamese grocer.","isAppLine":false,"small":{"start":127.04,"end":134.208,"frac":0.935,"status":"ok","matched":29,"words":31},"large":{"start":127.04,"end":134.208,"frac":0.935,"status":"ok","matched":29,"words":31},"differ":false},{"i":19,"text":"“A box like this?”","isAppLine":false,"small":{"start":134.46,"end":135.24,"frac":1.0,"status":"ok","matched":4,"words":4},"large":{"start":134.28,"end":135.16,"frac":1.0,"status":"ok","matched":4,"words":4},"differ":false},{"i":20,"text":"She lifts up a box of bamboo shoots. Beneath is a pile of old crates and boxes, decades old, holding up the stand’s produce. One of them looks familiar… it’s the time machine!","isAppLine":false,"small":{"start":135.968,"end":145.42,"frac":1.0,"status":"ok","matched":33,"words":33},"large":{"start":135.968,"end":145.52,"frac":1.0,"status":"ok","matched":33,"words":33},"differ":false},{"i":21,"text":"“Professor!” you shout, startling him, and making him spit out a mouthful of lemongrass.","isAppLine":false,"small":{"start":145.824,"end":150.14,"frac":1.0,"status":"ok","matched":14,"words":14},"large":{"start":145.824,"end":150.272,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":false},{"i":22,"text":"With the help of the market traders, the Professor tinkers and oils the machine, pulling out a stray leaf of bok choy, and then…","isAppLine":false,"small":{"start":151.008,"end":156.92,"frac":1.0,"status":"ok","matched":24,"words":24},"large":{"start":151.008,"end":157.48,"frac":1.0,"status":"ok","matched":24,"words":24},"differ":true},{"i":23,"text":"“It’s working! Now all I need is somewhere to mount an antenna.”","isAppLine":false,"small":{"start":157.856,"end":161.32,"frac":0.917,"status":"ok","matched":11,"words":12},"large":{"start":157.856,"end":161.44,"frac":1.0,"status":"ok","matched":12,"words":12},"differ":false},{"i":24,"text":"“There’s tall buildings everywhere,” says the clerk, pointing around in astonishment.","isAppLine":false,"small":{"start":162.048,"end":165.9,"frac":1.0,"status":"ok","matched":11,"words":11},"large":{"start":162.048,"end":165.94,"frac":1.0,"status":"ok","matched":11,"words":11},"differ":false},{"i":25,"text":"“But if it teleports us again,” you say, “there might not be any buildings! Maybe we’re better off with a tree. Whitmore Square is just up the road!”","isAppLine":false,"small":{"start":166.304,"end":172.736,"frac":0.929,"status":"ok","matched":26,"words":28},"large":{"start":166.304,"end":172.736,"frac":0.929,"status":"ok","matched":26,"words":28},"differ":false},{"i":26,"text":"“Nonsense,” says the Professor, inspecting a coil of copper wire on a stand nearby. “What were the tallest buildings in town originally?”","isAppLine":false,"small":{"start":173.12,"end":180.48,"frac":1.0,"status":"ok","matched":22,"words":22},"large":{"start":173.12,"end":180.48,"frac":1.0,"status":"ok","matched":22,"words":22},"differ":false},{"i":27,"text":"You look east, up the street, towards the tall spires of St Francis Xavier Cathedral.","isAppLine":false,"small":{"start":180.736,"end":184.992,"frac":1.0,"status":"ok","matched":15,"words":15},"large":{"start":180.736,"end":184.992,"frac":1.0,"status":"ok","matched":15,"words":15},"differ":false},{"i":28,"text":"“Churches!” he says, happily. “When have I ever led you wrong?”","isAppLine":false,"small":{"start":185.6,"end":188.96,"frac":1.0,"status":"ok","matched":11,"words":11},"large":{"start":185.6,"end":188.96,"frac":1.0,"status":"ok","matched":11,"words":11},"differ":false},{"i":29,"text":"Do you:","isAppLine":false,"small":{"start":191.968,"end":191.22,"frac":1.0,"status":"ok","matched":2,"words":2},"large":{"start":190.34,"end":191.32,"frac":1.0,"status":"ok","matched":2,"words":2},"differ":true},{"i":30,"text":"St Francis Xavier Cathedral (1975->1954): Think the Professor is right, and that the higher antenna will give you a better shot at getting home. Then head to St Francis Xavier Cathedral.","isAppLine":false,"small":{"start":191.968,"end":199.16,"frac":0.812,"status":"ok","matched":26,"words":32},"large":{"start":191.968,"end":199.264,"frac":0.812,"status":"ok","matched":26,"words":32},"differ":false},{"i":31,"text":"Or","isAppLine":false,"small":{"start":200.288,"end":200.5,"frac":1.0,"status":"ok","matched":1,"words":1},"large":{"start":200.288,"end":200.76,"frac":1.0,"status":"ok","matched":1,"words":1},"differ":false},{"i":32,"text":"Whitmore Square/Voyagers Sculpture (1975->1888): If you think it’s safer to keep your feet firmly on the ground, grab the Professor and head to Whitmore Square.","isAppLine":false,"small":{"start":201.184,"end":206.656,"frac":0.778,"status":"ok","matched":21,"words":27},"large":{"start":201.184,"end":206.656,"frac":0.778,"status":"ok","matched":21,"words":27},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/61de1a48726b0_BC7_final2.jpg"}