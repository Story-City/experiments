74,0.042,0.059,0.092,0.031,0.04,0.051,0.056,0.021,0.027,0.028,0.01,0.007,0.019,0.01,0.003,0.003,0.004,0.001,0.001,0.0],"paragraphs":[{"i":0,"text":"As you arrive at the grey granite steps beneath the towering columns of Parliament House, the first thing you see is the crane, lowering a yellow chunk of stone. The next thing you see is the lines of soldiers, in formation, facing the building.","isAppLine":false,"small":{"start":2.88,"end":15.136,"frac":1.0,"status":"ok","matched":44,"words":44},"large":{"start":2.88,"end":15.136,"frac":1.0,"status":"ok","matched":44,"words":44},"differ":false},{"i":1,"text":"The Professor stops and puts the time machine down to the left of the front steps, behind a row of bushes, as the politician scratches his head, confused, staring at the building.","isAppLine":false,"small":{"start":15.456,"end":23.968,"frac":1.0,"status":"ok","matched":32,"words":32},"large":{"start":15.456,"end":23.968,"frac":1.0,"status":"ok","matched":32,"words":32},"differ":false},{"i":2,"text":"“What on earth is this?” he says.","isAppLine":false,"small":{"start":24.352,"end":26.656,"frac":1.0,"status":"ok","matched":7,"words":7},"large":{"start":24.352,"end":26.656,"frac":1.0,"status":"ok","matched":7,"words":7},"differ":false},{"i":3,"text":"“Isn’t this Parliament House?” you ask.","isAppLine":false,"small":{"start":27.072,"end":28.9,"frac":1.0,"status":"ok","matched":6,"words":6},"large":{"start":27.072,"end":28.96,"frac":1.0,"status":"ok","matched":6,"words":6},"differ":false},{"i":4,"text":"“That’s Parliament House,” he says, pointing at the old-looking building further up North Terrace. “This looks more like the Parthenon!”","isAppLine":false,"small":{"start":29.408,"end":35.52,"frac":0.952,"status":"ok","matched":20,"words":21},"large":{"start":29.408,"end":35.46,"frac":0.952,"status":"ok","matched":20,"words":21},"differ":false},{"i":5,"text":"“We’ve gone forward!” says the Professor, rubbing his temples as he tries to think. “New Parliament House was opened in 1939…”","isAppLine":false,"small":{"start":35.744,"end":42.86,"frac":1.0,"status":"ok","matched":21,"words":21},"large":{"start":35.744,"end":42.66,"frac":1.0,"status":"ok","matched":21,"words":21},"differ":false},{"i":6,"text":"The crane swings the stone over your head, and the Professor points.","isAppLine":false,"small":{"start":43.744,"end":46.848,"frac":1.0,"status":"ok","matched":12,"words":12},"large":{"start":43.744,"end":46.848,"frac":1.0,"status":"ok","matched":12,"words":12},"differ":false},{"i":7,"text":"“Yes! Look!”","isAppLine":false,"small":{"start":47.104,"end":47.936,"frac":1.0,"status":"ok","matched":2,"words":2},"large":{"start":47.104,"end":47.9,"frac":1.0,"status":"ok","matched":2,"words":2},"differ":false},{"i":8,"text":"The stone isn’t smooth like the rest of the building, it’s rough on one side, like it’s been chipped away from a bigger sculpture. Looking closer, you realise that it’s a lion standing on its hind legs, a crown on its head.","isAppLine":false,"small":{"start":48.32,"end":59.136,"frac":1.0,"status":"ok","matched":42,"words":42},"large":{"start":48.32,"end":58.86,"frac":0.881,"status":"ok","matched":37,"words":42},"differ":false},{"i":9,"text":"“Not bad, eh?” says one of the crane workers, tugging on a rope. “They were so happy we finished the building after fifty long years of planning, they sent it all the way from London. It’s the one from the Houses of Parliament at Westminster.”","isAppLine":false,"small":{"start":59.52,"end":71.072,"frac":0.956,"status":"ok","matched":43,"words":45},"large":{"start":59.52,"end":71.072,"frac":0.733,"status":"ok","matched":33,"words":45},"differ":false},{"i":10,"text":"“EASY DOES IT!” shouts a familiar voice.","isAppLine":false,"small":{"start":71.584,"end":73.952,"frac":1.0,"status":"ok","matched":7,"words":7},"large":{"start":71.584,"end":73.92,"frac":1.0,"status":"ok","matched":7,"words":7},"differ":false},{"i":11,"text":"You look around to see an old man with an enormous moustache, barking orders at the men working the crane. It’s the Sergeant-Major, the one who chased you all the way back on King William Street! He must be seventy years old!","isAppLine":false,"small":{"start":74.112,"end":85.42,"frac":0.977,"status":"ok","matched":42,"words":43},"large":{"start":74.112,"end":85.5,"frac":0.977,"status":"ok","matched":42,"words":43},"differ":false},{"i":12,"text":"Before you can run, he catches your eye. He frowns, his moustache twitching as his memory stirs.","isAppLine":false,"small":{"start":85.696,"end":91.68,"frac":1.0,"status":"ok","matched":17,"words":17},"large":{"start":85.696,"end":91.52,"frac":1.0,"status":"ok","matched":17,"words":17},"differ":false},{"i":13,"text":"“DON’T I KNOW YOU?” he bellows.","isAppLine":false,"small":{"start":91.872,"end":94.3,"frac":1.0,"status":"ok","matched":6,"words":6},"large":{"start":91.872,"end":94.26,"frac":1.0,"status":"ok","matched":6,"words":6},"differ":false},{"i":14,"text":"You turn to run, and tread straight on the foot of the man holding the rope. He yelps in pain, hopping, and lets go of the rope. You look up.","isAppLine":false,"small":{"start":94.3,"end":100.98,"frac":0.9,"status":"ok","matched":27,"words":30},"large":{"start":94.26,"end":100.96,"frac":1.0,"status":"ok","matched":30,"words":30},"differ":false},{"i":15,"text":"The lion swings through the air and drops.","isAppLine":false,"small":{"start":101.28,"end":103.648,"frac":1.0,"status":"ok","matched":8,"words":8},"large":{"start":101.28,"end":103.648,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":false},{"i":16,"text":"“WATCH IT!”","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":2},"large":{"start":103.84,"end":104.48,"frac":0.5,"status":"ok","matched":1,"words":2},"differ":true},{"i":17,"text":"CRASH! The lion lands heavily behind the bushes to the left of the steps… right on top of the time machine, flattening it completely.","isAppLine":false,"small":{"start":106.592,"end":113.18,"frac":0.958,"status":"ok","matched":23,"words":24},"large":{"start":106.592,"end":113.02,"frac":0.958,"status":"ok","matched":23,"words":24},"differ":false},{"i":18,"text":"The Sergeant-Major clamps his hand on your shoulder.","isAppLine":false,"small":{"start":114.048,"end":116.42,"frac":1.0,"status":"ok","matched":9,"words":9},"large":{"start":114.048,"end":116.544,"frac":1.0,"status":"ok","matched":9,"words":9},"differ":false},{"i":19,"text":"“I REMEMBER; THOUGHT YOU COULD LEAVE MY ARMY DID YOU? HO, WE’LL SEE ABOUT THAT. I’M TAKING YOU STRAIGHT TO THE RECRUITMENT TENT.”","isAppLine":false,"small":{"start":116.928,"end":125.04,"frac":0.957,"status":"ok","matched":22,"words":23},"large":{"start":116.928,"end":125.312,"frac":0.957,"status":"ok","matched":22,"words":23},"differ":false},{"i":20,"text":"He starts to march you away, his other hand gripping the Professor’s shoulder tightly.","isAppLine":false,"small":{"start":125.696,"end":129.7,"frac":1.0,"status":"ok","matched":14,"words":14},"large":{"start":125.696,"end":129.68,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":false},{"i":21,"text":"You look at the Professor, worried, but he gives you a reassuring look.","isAppLine":false,"small":{"start":130.048,"end":133.38,"frac":1.0,"status":"ok","matched":13,"words":13},"large":{"start":130.048,"end":133.472,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false},{"i":22,"text":"“Don’t worry, we’re only in trouble if there’s a war on.”","isAppLine":false,"small":{"start":133.984,"end":136.86,"frac":1.0,"status":"ok","matched":11,"words":11},"large":{"start":133.984,"end":137.056,"frac":1.0,"status":"ok","matched":11,"words":11},"differ":false},{"i":23,"text":"“Um,” you say, “what year is it again?”","isAppLine":false,"small":{"start":138.016,"end":140.54,"frac":1.0,"status":"ok","matched":8,"words":8},"large":{"start":138.016,"end":140.64,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":false},{"i":24,"text":"“1939. Oh. Oh dear.”","isAppLine":false,"small":{"start":141.696,"end":147.4,"frac":1.0,"status":"ok","matched":4,"words":4},"large":{"start":141.696,"end":147.3,"frac":1.0,"status":"ok","matched":4,"words":4},"differ":false},{"i":25,"text":"~END~","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":1},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":1},"differ":false},{"i":26,"text":"Ouch! Bad Luck! This is the end of your adventure but you can head back to the starting point to explore a different story path, or you can try the other Story City: Adelaide adventure, Ready or Not: Hide & Seek Alien Style.","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":42},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":42},"differ":false},{"i":27,"text":"And don’t forget to upload a pic of you on your adventure to Facebook, Instagram or Twitter with the hashtags #StoryCity #TimeCaper","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":22},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":22},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/61de1b730d63a_BC9_final.jpg"}