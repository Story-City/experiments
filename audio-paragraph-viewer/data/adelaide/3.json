76,0.038,0.058,0.09,0.041,0.042,0.052,0.055,0.03,0.017,0.026,0.031,0.011,0.006,0.02,0.012,0.005,0.002,0.003,0.003,0.001,0.001,0.0],"paragraphs":[{"i":0,"text":"The newly recruited policemen who are chasing you stop suddenly, staring open-mouthed up at the four columns towering proudly above the front awning, the clock face separating the words ‘RAILWAY’ and ‘STATION’.","isAppLine":false,"small":{"start":2.752,"end":14.752,"frac":0.939,"status":"ok","matched":31,"words":33},"large":{"start":2.752,"end":14.42,"frac":0.939,"status":"ok","matched":31,"words":33},"differ":false},{"i":1,"text":"“Where did that come from?” they say, pointing.","isAppLine":false,"small":{"start":15.168,"end":17.792,"frac":0.75,"status":"ok","matched":6,"words":8},"large":{"start":15.168,"end":17.72,"frac":0.75,"status":"ok","matched":6,"words":8},"differ":false},{"i":2,"text":"The Professor looks down at the time machine.","isAppLine":false,"small":{"start":18.24,"end":20.096,"frac":1.0,"status":"ok","matched":8,"words":8},"large":{"start":18.24,"end":20.096,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":false},{"i":3,"text":"“It’s brought us all forward again! The new station wasn’t built until 1926…”","isAppLine":false,"small":{"start":20.48,"end":25.3,"frac":1.0,"status":"ok","matched":13,"words":13},"large":{"start":20.48,"end":25.06,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false},{"i":4,"text":"The policemen shake their heads as though clearing some internal doubt, and grab you by the arms. One of them yanks the time machine out of the Professor’s hands, and holds him too.","isAppLine":false,"small":{"start":25.856,"end":34.944,"frac":0.97,"status":"ok","matched":32,"words":33},"large":{"start":25.06,"end":34.944,"frac":0.97,"status":"ok","matched":32,"words":33},"differ":true},{"i":5,"text":"“Right, well, wherever we are, you’re under arrest,” says one of them.","isAppLine":false,"small":{"start":35.168,"end":39.02,"frac":1.0,"status":"ok","matched":12,"words":12},"large":{"start":35.168,"end":38.944,"frac":1.0,"status":"ok","matched":12,"words":12},"differ":false},{"i":6,"text":"“Excuse me?” says a polite voice.","isAppLine":false,"small":{"start":39.328,"end":41.42,"frac":1.0,"status":"ok","matched":6,"words":6},"large":{"start":39.328,"end":41.12,"frac":1.0,"status":"ok","matched":6,"words":6},"differ":false},{"i":7,"text":"A woman with short, curly hair and a pair of round glasses approaches you.","isAppLine":false,"small":{"start":41.42,"end":44.928,"frac":1.0,"status":"ok","matched":14,"words":14},"large":{"start":41.12,"end":44.928,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":false},{"i":8,"text":"“Why are you harassing these people?” she asks the policemen.","isAppLine":false,"small":{"start":45.248,"end":47.808,"frac":1.0,"status":"ok","matched":10,"words":10},"large":{"start":45.248,"end":47.808,"frac":1.0,"status":"ok","matched":10,"words":10},"differ":false},{"i":9,"text":"“Um, because, they look suspicious,” says one them, pointing at your clothes. “And they’re up to no good—they made this railway station appear out of nowhere!”","isAppLine":false,"small":{"start":48.032,"end":56.608,"frac":1.0,"status":"ok","matched":27,"words":27},"large":{"start":48.032,"end":56.6,"frac":1.0,"status":"ok","matched":27,"words":27},"differ":false},{"i":10,"text":"The young woman looks at them, sternly. “I’d advise you to let them go.”","isAppLine":false,"small":{"start":56.8,"end":60.64,"frac":1.0,"status":"ok","matched":14,"words":14},"large":{"start":56.8,"end":60.64,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":false},{"i":11,"text":"“Oh yeah? Says who?”","isAppLine":false,"small":{"start":60.96,"end":62.272,"frac":0.75,"status":"ok","matched":3,"words":4},"large":{"start":60.96,"end":62.272,"frac":0.75,"status":"ok","matched":3,"words":4},"differ":false},{"i":12,"text":"“Constable Fanny Kate Boadicea Cocks,” she says, adjusting her glasses.","isAppLine":false,"small":{"start":62.752,"end":67.64,"frac":0.8,"status":"ok","matched":8,"words":10},"large":{"start":62.752,"end":67.4,"frac":0.8,"status":"ok","matched":8,"words":10},"differ":false},{"i":13,"text":"The men laugh.","isAppLine":false,"small":{"start":67.64,"end":68.352,"frac":1.0,"status":"ok","matched":3,"words":3},"large":{"start":67.4,"end":68.352,"frac":1.0,"status":"ok","matched":3,"words":3},"differ":false},{"i":14,"text":"“A police woman? There’s no such thing,” they say.","isAppLine":false,"small":{"start":68.544,"end":71.648,"frac":0.667,"status":"ok","matched":6,"words":9},"large":{"start":68.544,"end":71.648,"frac":0.667,"status":"ok","matched":6,"words":9},"differ":false},{"i":15,"text":"“There is now!” she says. “Since 1915, we’re the first in the British Empire.”","isAppLine":false,"small":{"start":71.808,"end":76.384,"frac":1.0,"status":"ok","matched":14,"words":14},"large":{"start":71.808,"end":76.384,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":false},{"i":16,"text":"Several more women approach from each side of the station entrance, forming ranks behind Constable Cocks.","isAppLine":false,"small":{"start":76.64,"end":81.72,"frac":0.938,"status":"ok","matched":15,"words":16},"large":{"start":76.64,"end":81.58,"frac":0.938,"status":"ok","matched":15,"words":16},"differ":false},{"i":17,"text":"The men release your arms and approach them.","isAppLine":false,"small":{"start":81.72,"end":83.968,"frac":1.0,"status":"ok","matched":8,"words":8},"large":{"start":81.58,"end":83.968,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":false},{"i":18,"text":"“Seems like you need to learn a lesson about telling lies, little ladies,” says one, and they lunge at the women.","isAppLine":false,"small":{"start":84.128,"end":90.304,"frac":1.0,"status":"ok","matched":21,"words":21},"large":{"start":84.128,"end":90.304,"frac":1.0,"status":"ok","matched":21,"words":21},"differ":false},{"i":19,"text":"Within seconds, the men are writhing in pain on the ground, pinned down by a policewomen each. Constable Cocks sees your expression of amazement.","isAppLine":false,"small":{"start":91.488,"end":98.592,"frac":0.958,"status":"ok","matched":23,"words":24},"large":{"start":91.488,"end":98.592,"frac":0.958,"status":"ok","matched":23,"words":24},"differ":false},{"i":20,"text":"“I insist all my lady constables be trained in jiu-jitsu,” she says matter-of-factly.","isAppLine":false,"small":{"start":98.88,"end":103.008,"frac":1.0,"status":"ok","matched":16,"words":16},"large":{"start":98.88,"end":102.94,"frac":1.0,"status":"ok","matched":16,"words":16},"differ":false},{"i":21,"text":"She looks down at the moaning men, and adds, “Oh, and first aid.”","isAppLine":false,"small":{"start":103.296,"end":106.336,"frac":1.0,"status":"ok","matched":13,"words":13},"large":{"start":103.296,"end":106.336,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false},{"i":22,"text":"For the first time on your adventure, you realise no one is chasing you. The Professor takes the opportunity, at last, to pick up the time machine, and adjusts the appropriate settings. He takes a deep breath.","isAppLine":false,"small":{"start":106.72,"end":117.216,"frac":1.0,"status":"ok","matched":37,"words":37},"large":{"start":106.72,"end":117.12,"frac":1.0,"status":"ok","matched":37,"words":37},"differ":false},{"i":23,"text":"“Ready?” he says, and turns it on.","isAppLine":false,"small":{"start":117.504,"end":119.904,"frac":1.0,"status":"ok","matched":7,"words":7},"large":{"start":117.504,"end":119.904,"frac":1.0,"status":"ok","matched":7,"words":7},"differ":false},{"i":24,"text":"A loud steam train whistle blows, and when you turn around the street is full of cars.","isAppLine":false,"small":{"start":125.088,"end":129.024,"frac":1.0,"status":"ok","matched":17,"words":17},"large":{"start":125.088,"end":129.024,"frac":1.0,"status":"ok","matched":17,"words":17},"differ":false},{"i":25,"text":"You notice two police officers, a man and a woman, walking up North Terrace.","isAppLine":false,"small":{"start":129.952,"end":133.696,"frac":1.0,"status":"ok","matched":14,"words":14},"large":{"start":129.952,"end":133.696,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":false},{"i":26,"text":"“I wonder what other firsts this city might be proud of in the future?” asks the Professor. “There’s no better time than now to find out: we’re back!”","isAppLine":false,"small":{"start":134.784,"end":142.208,"frac":0.893,"status":"ok","matched":25,"words":28},"large":{"start":134.784,"end":142.208,"frac":0.929,"status":"ok","matched":26,"words":28},"differ":false},{"i":27,"text":"~END~","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":1},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":1},"differ":false},{"i":28,"text":"Congratulations! You made it back. Don’t forget to upload a pic of you on your adventure to Facebook, Instagram or Twitter with the hashtags #StoryCity #TimeCaper","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":26},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":26},"differ":false},{"i":29,"text":"This is the end of your adventure but you can head back to the starting point to explore a different story path, or you can try the other Story City: Adelaide adventure, Ready or Not: Hide & Seek Alien Style.","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":39},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":39},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/61de1b4687a0b_BC10_final.jpg"}