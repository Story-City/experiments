46,0.036,0.045,0.032,0.031,0.028,0.023,0.015,0.008,0.012,0.007,0.006,0.003,0.004,0.002,0.001,0.001,0.001,0.0,0.0,0.0,0.0],"paragraphs":[{"i":0,"text":"As you and the Professor hurry along Hindley St the buildings shrink until they are nothing more than one- and two-storey barns and brick shanties, like something out of a Wild West movie. Wherever, or, rather, whenever, you are, it must be all the way back to when Adelaide was only a few years old, maybe the 1830s? You look back over your shoulder, but the Sergeant-Major must be safely back in the future.","isAppLine":false,"small":{"start":11.2,"end":32.896,"frac":0.987,"status":"ok","matched":75,"words":76},"large":{"start":11.2,"end":32.88,"frac":0.987,"status":"ok","matched":75,"words":76},"differ":false},{"i":1,"text":"Instead of a brick building, the Princes Berkeley Hotel looks more like a small house, with a veranda, a wooden roof and picket fence. Catching your breath, you notice a sign beside the gate, which reads:","isAppLine":false,"small":{"start":33.184,"end":43.36,"frac":1.0,"status":"ok","matched":36,"words":36},"large":{"start":33.184,"end":43.26,"frac":1.0,"status":"ok","matched":36,"words":36},"differ":false},{"i":2,"text":"‘The bull is tame, so fear him not, so long as you can pay your shot. When money’s gone and credit’s bad, that’s what makes the bull go mad.’","isAppLine":false,"small":{"start":43.712,"end":51.104,"frac":0.931,"status":"ok","matched":27,"words":29},"large":{"start":43.712,"end":51.104,"frac":0.931,"status":"ok","matched":27,"words":29},"differ":false},{"i":3,"text":"“Welcome to the Buffalo’s Head!” says a cheerful voice. A man with a woolly beard lifts his top-hat as he approaches you. “You’re not from Buffalo Row, which ship did you come out on?”","isAppLine":false,"small":{"start":51.52,"end":61.824,"frac":0.886,"status":"ok","matched":31,"words":35},"large":{"start":51.52,"end":61.824,"frac":0.886,"status":"ok","matched":31,"words":35},"differ":false},{"i":4,"text":"“We didn’t come on a ship,” you say, before the Professor can stop you.","isAppLine":false,"small":{"start":62.112,"end":65.632,"frac":1.0,"status":"ok","matched":14,"words":14},"large":{"start":62.112,"end":65.632,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":false},{"i":5,"text":"The man frowns. Behind him, a group of men stand with their drinks and approach.","isAppLine":false,"small":{"start":65.984,"end":69.728,"frac":1.0,"status":"ok","matched":15,"words":15},"large":{"start":65.984,"end":69.728,"frac":1.0,"status":"ok","matched":15,"words":15},"differ":false},{"i":6,"text":"“Didn’t come from a ship?” says one of them. “How else would you get here? Everyone here is a settler!”","isAppLine":false,"small":{"start":70.08,"end":75.968,"frac":1.0,"status":"ok","matched":20,"words":20},"large":{"start":70.08,"end":75.968,"frac":1.0,"status":"ok","matched":20,"words":20},"differ":false},{"i":7,"text":"Another points at you. “Maybe they’re convicts, on the run from one of the colonies!”","isAppLine":false,"small":{"start":76.256,"end":80.544,"frac":1.0,"status":"ok","matched":15,"words":15},"large":{"start":76.256,"end":80.5,"frac":1.0,"status":"ok","matched":15,"words":15},"differ":false},{"i":8,"text":"You hold your hands up. “No, no, no, let’s not jump to conclusions. There’s no need to call the police!”","isAppLine":false,"small":{"start":80.768,"end":85.84,"frac":0.95,"status":"ok","matched":19,"words":20},"large":{"start":80.768,"end":85.96,"frac":0.95,"status":"ok","matched":19,"words":20},"differ":false},{"i":9,"text":"The first man frowns.","isAppLine":false,"small":{"start":86.432,"end":87.52,"frac":1.0,"status":"ok","matched":4,"words":4},"large":{"start":86.432,"end":87.52,"frac":1.0,"status":"ok","matched":4,"words":4},"differ":false},{"i":10,"text":"“We’re not going to call the police.”","isAppLine":false,"small":{"start":87.84,"end":89.1,"frac":0.714,"status":"ok","matched":5,"words":7},"large":{"start":87.84,"end":89.28,"frac":1.0,"status":"ok","matched":7,"words":7},"differ":false},{"i":11,"text":"You sigh with relief.","isAppLine":false,"small":{"start":89.536,"end":90.68,"frac":1.0,"status":"ok","matched":4,"words":4},"large":{"start":89.536,"end":90.72,"frac":1.0,"status":"ok","matched":4,"words":4},"differ":false},{"i":12,"text":"“We would, but there aren’t any.”","isAppLine":false,"small":{"start":91.04,"end":92.7,"frac":1.0,"status":"ok","matched":6,"words":6},"large":{"start":91.04,"end":92.832,"frac":1.0,"status":"ok","matched":6,"words":6},"differ":false},{"i":13,"text":"The Professor whispers to you, “The first police force wasn’t formed until 1838.”","isAppLine":false,"small":{"start":93.344,"end":99.04,"frac":1.0,"status":"ok","matched":13,"words":13},"large":{"start":93.344,"end":99.04,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false},{"i":14,"text":"One of the men turns to the other. “Inman, you’d make a good policeman.”","isAppLine":false,"small":{"start":99.52,"end":102.98,"frac":0.929,"status":"ok","matched":13,"words":14},"large":{"start":99.52,"end":103.16,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":false},{"i":15,"text":"The man—Henry Inman—thinks about this.","isAppLine":false,"small":{"start":103.584,"end":106.176,"frac":1.0,"status":"ok","matched":7,"words":7},"large":{"start":103.584,"end":106.176,"frac":1.0,"status":"ok","matched":7,"words":7},"differ":false},{"i":16,"text":"“We’d need horses,” he says, scratching his chin.","isAppLine":false,"small":{"start":107.168,"end":109.824,"frac":1.0,"status":"ok","matched":8,"words":8},"large":{"start":107.168,"end":109.824,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":false},{"i":17,"text":"“There’s horses out the back,” says another man, helpfully.","isAppLine":false,"small":{"start":110.144,"end":112.928,"frac":1.0,"status":"ok","matched":9,"words":9},"large":{"start":110.144,"end":112.928,"frac":1.0,"status":"ok","matched":9,"words":9},"differ":false},{"i":18,"text":"“And guns,” Inman says.","isAppLine":false,"small":{"start":113.216,"end":115.16,"frac":1.0,"status":"ok","matched":4,"words":4},"large":{"start":113.216,"end":115.02,"frac":1.0,"status":"ok","matched":4,"words":4},"differ":false},{"i":19,"text":"Several of the men pick up hunting rifles.","isAppLine":false,"small":{"start":115.16,"end":117.344,"frac":1.0,"status":"ok","matched":8,"words":8},"large":{"start":115.02,"end":117.344,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":false},{"i":20,"text":"“Well, that settles it,” says Inman. “Our first case, these runaway convicts.”","isAppLine":false,"small":{"start":117.664,"end":122.18,"frac":1.0,"status":"ok","matched":12,"words":12},"large":{"start":117.664,"end":121.94,"frac":1.0,"status":"ok","matched":12,"words":12},"differ":false},{"i":21,"text":"The Professor backs away, taking your arm nervously.","isAppLine":false,"small":{"start":122.18,"end":124.864,"frac":1.0,"status":"ok","matched":8,"words":8},"large":{"start":121.94,"end":124.864,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":false},{"i":22,"text":"“Um, I don’t think we want to stick around here much longer,” he says. “We should get out of town. The railway station’s just north of here!”","isAppLine":false,"small":{"start":125.056,"end":132.256,"frac":1.0,"status":"ok","matched":27,"words":27},"large":{"start":125.056,"end":132.24,"frac":1.0,"status":"ok","matched":27,"words":27},"differ":false},{"i":23,"text":"“There is no railway station yet!” you say, looking west up the street to bushland. “I don’t know if I trust that machine. Maybe we should make a run for it!”","isAppLine":false,"small":{"start":132.512,"end":140.224,"frac":1.0,"status":"ok","matched":31,"words":31},"large":{"start":132.512,"end":140.224,"frac":1.0,"status":"ok","matched":31,"words":31},"differ":false},{"i":24,"text":"Do you:","isAppLine":false,"small":{"start":142.112,"end":142.56,"frac":1.0,"status":"ok","matched":2,"words":2},"large":{"start":142.112,"end":142.46,"frac":1.0,"status":"ok","matched":2,"words":2},"differ":false},{"i":25,"text":"Hindley Street (Austral Stores) (1838->1855): Decide the safety of the bush is the best bet. Run west, further up Hindley Street towards the Austral Stores.","isAppLine":false,"small":{"start":143.168,"end":149.664,"frac":0.731,"status":"ok","matched":19,"words":26},"large":{"start":143.168,"end":149.664,"frac":0.769,"status":"ok","matched":20,"words":26},"differ":false},{"i":26,"text":"Or","isAppLine":false,"small":{"start":150.72,"end":151.14,"frac":1.0,"status":"ok","matched":1,"words":1},"large":{"start":150.72,"end":150.78,"frac":1.0,"status":"ok","matched":1,"words":1},"differ":false},{"i":27,"text":"Railway Station (1838->1926): Run north to North Terrace, hoping the time machine will glitch again and the Railway Station will be there by the time you arrive.","isAppLine":false,"small":{"start":151.52,"end":158.4,"frac":0.857,"status":"ok","matched":24,"words":28},"large":{"start":151.52,"end":158.4,"frac":0.857,"status":"ok","matched":24,"words":28},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/61de1a055ac67_BC5_final.jpg"}