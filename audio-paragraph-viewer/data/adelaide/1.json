0.02,0.027,0.017,0.011,0.01,0.008,0.006,0.005,0.005,0.003,0.002,0.002,0.001,0.0,0.001,0.0,0.0,0.0,0.0],"paragraphs":[{"i":0,"text":"The footsteps of the policeman fade behind you as the air crackles and sparks around your ears.","isAppLine":false,"small":{"start":0.128,"end":5.312,"frac":1.0,"status":"ok","matched":17,"words":17},"large":{"start":0.128,"end":5.312,"frac":1.0,"status":"ok","matched":17,"words":17},"differ":false},{"i":1,"text":"You’ve barely caught your breath when you find yourself skidding out of the way of a tram… but a tram with no wires. It’s being pulled by a horse!","isAppLine":false,"small":{"start":11.296,"end":18.144,"frac":0.931,"status":"ok","matched":27,"words":29},"large":{"start":11.296,"end":18.144,"frac":1.0,"status":"ok","matched":29,"words":29},"differ":false},{"i":2,"text":"“Watch where you’re walking!” snaps a voice behind you.","isAppLine":false,"small":{"start":18.464,"end":21.3,"frac":1.0,"status":"ok","matched":9,"words":9},"large":{"start":18.464,"end":21.06,"frac":1.0,"status":"ok","matched":9,"words":9},"differ":false},{"i":3,"text":"A small man in thick spectacles, probably a clerk, glares at you over the huge pile of ledgers and boxes in his arms. He jerks his head backward, to a tall, important-looking gentleman in a suit and hat behind you.","isAppLine":false,"small":{"start":21.3,"end":32.18,"frac":0.976,"status":"ok","matched":40,"words":41},"large":{"start":21.06,"end":32.224,"frac":0.976,"status":"ok","matched":40,"words":41},"differ":false},{"i":4,"text":"“You nearly ran into Mr Darling!”","isAppLine":false,"small":{"start":32.448,"end":33.84,"frac":1.0,"status":"ok","matched":6,"words":6},"large":{"start":32.448,"end":33.96,"frac":1.0,"status":"ok","matched":6,"words":6},"differ":false},{"i":5,"text":"The tall gentleman with a big bushy beard—Mr Darling—slaps the clerk on the back, nearly sending him flying.","isAppLine":false,"small":{"start":34.24,"end":39.26,"frac":0.95,"status":"ok","matched":19,"words":20},"large":{"start":34.24,"end":39.424,"frac":0.95,"status":"ok","matched":19,"words":20},"differ":false},{"i":6,"text":"“Wonderful work, Jenkins, the new building’s coming along marvelously.”","isAppLine":false,"small":{"start":39.584,"end":42.816,"frac":1.0,"status":"ok","matched":9,"words":9},"large":{"start":39.584,"end":42.816,"frac":1.0,"status":"ok","matched":9,"words":9},"differ":false},{"i":7,"text":"“John Darling Jnr,” whispers the Professor, inspecting the machine. “But that means it’s 1901, the machine’s transporting us without even me activating it! Bother!”","isAppLine":false,"small":{"start":43.296,"end":56.5,"frac":0.958,"status":"ok","matched":23,"words":24},"large":{"start":43.296,"end":56.48,"frac":0.958,"status":"ok","matched":23,"words":24},"differ":false},{"i":8,"text":"Mr Darling puts an arm around your shoulder and points up at the building. Scaffolding surrounds the top, and a man hangs from a sling, chipping away at the plasterwork with a hammer and chisel. You can just make out what looks like a bushel of wheat.","isAppLine":false,"small":{"start":57.088,"end":68.768,"frac":1.0,"status":"ok","matched":47,"words":47},"large":{"start":57.088,"end":68.768,"frac":1.0,"status":"ok","matched":47,"words":47},"differ":false},{"i":9,"text":"“Aha! And this must be the new wheat threshing machine, is it?” he says, and snatches the time machine from the Professor. As the Professor gropes to take it back, Darling turns and weighs it in his hands. He plonks it into a box on top of another box in the clerk’s overloaded ledgers, making the poor man stagger precariously.","isAppLine":false,"small":{"start":69.088,"end":86.688,"frac":0.983,"status":"ok","matched":59,"words":60},"large":{"start":69.088,"end":86.688,"frac":0.983,"status":"ok","matched":59,"words":60},"differ":false},{"i":10,"text":"“No!” you say, reaching out for it, but Darling has his arm around your shoulder again, and is dragging you up the street as a pair of horse-and-carriages clatters to a stop beside you, one fancy, the other plain.","isAppLine":false,"small":{"start":87.008,"end":98.592,"frac":1.0,"status":"ok","matched":41,"words":41},"large":{"start":87.008,"end":98.592,"frac":1.0,"status":"ok","matched":41,"words":41},"differ":false},{"i":11,"text":"“Oh, some new mining gadget from BHP is it? You’d think they’d tell the chairman these things…”","isAppLine":false,"small":{"start":98.88,"end":103.68,"frac":0.941,"status":"ok","matched":16,"words":17},"large":{"start":98.88,"end":103.66,"frac":1.0,"status":"ok","matched":17,"words":17},"differ":false},{"i":12,"text":"You struggle to wriggle free, as the clerk stumbles back and forth, evading the Professor’s arms with each awkward step.","isAppLine":false,"small":{"start":103.872,"end":110.24,"frac":1.0,"status":"ok","matched":20,"words":20},"large":{"start":103.872,"end":110.22,"frac":1.0,"status":"ok","matched":20,"words":20},"differ":false},{"i":13,"text":"“Well, whatever it is,” says Darling, grabbing a box from the clerk as he waddles past and loads it into the more ornate of the two carriages, “I didn’t become the Wheat King of Australia without being at the cutting edge of technology. Here, a hundred pounds for it, that’s more than fair.” He slaps a crisp Union Bank note into your chest.","isAppLine":false,"small":{"start":110.464,"end":127.44,"frac":0.952,"status":"ok","matched":60,"words":63},"large":{"start":110.464,"end":127.52,"frac":0.905,"status":"ok","matched":57,"words":63},"differ":false},{"i":14,"text":"In a reflex you grab it.","isAppLine":false,"small":{"start":127.872,"end":129.12,"frac":1.0,"status":"ok","matched":6,"words":6},"large":{"start":127.872,"end":129.16,"frac":1.0,"status":"ok","matched":6,"words":6},"differ":false},{"i":15,"text":"The clerk clambers into the back of the dowdier of the two carriages, and the Professor stops, looking back and forth between them.","isAppLine":false,"small":{"start":129.12,"end":135.72,"frac":0.913,"status":"ok","matched":21,"words":23},"large":{"start":129.16,"end":135.84,"frac":0.957,"status":"ok","matched":22,"words":23},"differ":false},{"i":16,"text":"“Jenkins,” says Darling as he climbs into the fancy carriage. “Go see to our business at the markets, I’m late for the theatre!”","isAppLine":false,"small":{"start":136.096,"end":143.136,"frac":1.0,"status":"ok","matched":23,"words":23},"large":{"start":136.096,"end":143.08,"frac":1.0,"status":"ok","matched":23,"words":23},"differ":false},{"i":17,"text":"The horses whinny and before you can stop them, they take off at top speed, Darling’s carriage to the north, the clerk’s to the south.","isAppLine":false,"small":{"start":143.296,"end":150.08,"frac":0.96,"status":"ok","matched":24,"words":25},"large":{"start":143.296,"end":150.08,"frac":1.0,"status":"ok","matched":25,"words":25},"differ":false},{"i":18,"text":"“Wait a minute!” says the Professor, “who had the time machine?”","isAppLine":false,"small":{"start":150.368,"end":153.92,"frac":1.0,"status":"ok","matched":11,"words":11},"large":{"start":150.368,"end":153.92,"frac":1.0,"status":"ok","matched":11,"words":11},"differ":false},{"i":19,"text":"How could you let this happen? You blame the time machine helmet on your head for making your all muddle-headed.","isAppLine":false,"small":{"start":154.4,"end":158.976,"frac":0.952,"status":"ok","matched":20,"words":21},"large":{"start":154.4,"end":158.976,"frac":0.952,"status":"ok","matched":20,"words":21},"differ":false},{"i":20,"text":"Do you:","isAppLine":false,"small":{"start":161.056,"end":161.504,"frac":1.0,"status":"ok","matched":2,"words":2},"large":{"start":161.056,"end":161.52,"frac":1.0,"status":"ok","matched":2,"words":2},"differ":false},{"i":21,"text":"Central Markets Tower (1901->1975): Believe that Mr Darling is too busy to bother with the machine, and has left it with his clerk to take care of. Then head to the Central Markets Tower on Grote Street, the one that looks like a castle tower.","isAppLine":false,"small":{"start":161.888,"end":172.608,"frac":0.87,"status":"ok","matched":40,"words":46},"large":{"start":161.888,"end":172.608,"frac":0.87,"status":"ok","matched":40,"words":46},"differ":false},{"i":22,"text":"Or","isAppLine":false,"small":{"start":173.76,"end":174.02,"frac":1.0,"status":"ok","matched":1,"words":1},"large":{"start":173.76,"end":174.26000000000002,"frac":1.0,"status":"ok","matched":1,"words":1},"differ":false},{"i":23,"text":"Queens Theatre (1901->1841): Think that Mr Darling has decided to take the machine to the theatre to show off to the other businessmen. Head north up Bentham St through Topham Mall to Currie St, then west to Gilles Arcade and the Old Queen’s Theatre.","isAppLine":false,"small":{"start":174.72,"end":186.528,"frac":0.8,"status":"ok","matched":36,"words":45},"large":{"start":174.72,"end":186.528,"frac":0.8,"status":"ok","matched":36,"words":45},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/61de1983c7cf8_BC3_final.jpg"}