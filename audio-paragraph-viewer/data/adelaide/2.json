{"story":"adelaide","order":2,"name":"[3] Reconciliation Plaza (Tarntanyangga) (1841 -> 40,000 BC)","audio":"https://sc-web-client-prod.s3-us-west-2.amazonaws.com/media/wp-content/uploads/2015/09/BC_13.mp3?_=13","audioFile":"BC_13.mp3","duration":236.088,"peaks":[0.092,0.137,0.157,0.183,0.158,0.128,0.198,0.47,0.497,0.577,0.143,0.142,0.234,0.205,0.164,0.361,0.367,0.457,0.377,0.427,0.435,0.545,0.704,0.694,0.854,0.267,0.157,0.14,0.271,0.213,0.12,0.973,0.916,0.948,0.947,0.931,0.858,0.887,0.931,0.889,0.899,0.939,0.914,0.097,0.918,0.516,0.915,0.936,0.96,0.957,0.913,0.913,0.861,0.925,0.973,0.603,0.888,0.872,0.947,0.03,0.943,0.919,0.925,0.736,0.081,0.051,0.824,0.85,0.511,0.044,0.92,0.944,0.934,0.95,0.942,0.911,0.942,0.969,0.934,0.794,0.03,0.721,0.93,0.92,0.888,0.59,0.799,0.79,0.857,0.942,0.962,0.909,0.605,0.033,0.829,0.786,0.928,0.406,0.113,0.842,0.902,0.929,0.988,0.944,0.398,0.97,0.981,0.968,0.989,0.949,0.211,0.559,0.931,0.263,0.224,0.823,0.872,0.029,0.095,0.97,1.0,0.806,0.148,0.066,0.953,0.848,0.91,0.967,0.885,0.719,0.945,0.845,0.93,0.917,0.93,0.933,0.796,0.84,0.768,0.062,0.894,0.943,0.81,0.93,0.954,0.818,0.875,0.969,0.843,0.03,0.77,0.793,0.87,0.646,0.08,0.948,0.93,0.875,1.0,0.902,0.929,0.926,0.486,0.911,0.607,0.878,0.946,0.923,0.914,0.908,0.864,0.37,0.92,0.797,0.665,0.06,0.917,0.826,0.912,0.82,0.868,0.347,0.725,0.939,0.738,0.859,0.597,0.446,0.632,0.611,0.555,0.76,0.693,0.752,0.847,0.665,0.877,0.709,0.692,0.091,0.797,0.824,0.835,0.76,0.818,0.245,0.388,0.793,0.646,0.844,0.726,0.791,0.457,0.28,0.493,0.576,0.803,0.83,0.692,0.625,0.542,0.595,0.413,0.057,0.898,0.913,0.924,0.899,0.846,0.564,0.034,0.94,0.49,0.449,0.886,0.87,0.859,0.849,0.926,0.705,0.705,0.778,0.018,0.89,0.916,0.925,0.944,0.967,0.903,0.599,0.888,0.85,0.927,0.939,0.909,0.376,0.866,0.942,0.936,0.756,0.86,0.422,0.055,0.787,0.707,0.741,0.87,0.765,0.848,0.805,0.746,0.805,0.657,0.275,0.883,0.887,0.918,0.639,0.06,0.79,0.823,0.642,0.632,0.888,0.761,0.849,0.833,0.75,0.744,0.919,0.878,0.257,0.075,0.917,0.983,0.952,0.92,0.9