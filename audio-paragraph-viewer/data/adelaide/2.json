0.191,0.078,0.146,0.147,0.043,0.114,0.1,0.038,0.086,0.045,0.042,0.053,0.026,0.028,0.032,0.008,0.019,0.012,0.005,0.003,0.004,0.001,0.0],"paragraphs":[{"i":0,"text":"You bend over to catch your breath in the centre of Tarntanyangga, which is also known as Reconciliation Plaza in Victoria Square and when you look up…","isAppLine":false,"small":{"start":7.392,"end":15.104,"frac":0.963,"status":"ok","matched":26,"words":27},"large":{"start":7.392,"end":15.08,"frac":0.963,"status":"ok","matched":26,"words":27},"differ":false},{"i":1,"text":"Uh oh. No buildings. No roads. No people. Just dry grass and gum trees in every direction. You’ve gone back, way, way back, before anyone was even here!","isAppLine":false,"small":{"start":15.808,"end":26.112,"frac":1.0,"status":"ok","matched":28,"words":28},"large":{"start":15.808,"end":26.04,"frac":1.0,"status":"ok","matched":28,"words":28},"differ":false},{"i":2,"text":"Except… wait a minute. Someone is here.","isAppLine":false,"small":{"start":26.4,"end":28.8,"frac":1.0,"status":"ok","matched":7,"words":7},"large":{"start":26.4,"end":28.864,"frac":1.0,"status":"ok","matched":7,"words":7},"differ":false},{"i":3,"text":"Through the trees, in the distance, you see a group of people running towards you.","isAppLine":false,"small":{"start":29.376,"end":32.864,"frac":1.0,"status":"ok","matched":15,"words":15},"large":{"start":29.376,"end":32.84,"frac":1.0,"status":"ok","matched":15,"words":15},"differ":false},{"i":4,"text":"“Professor?” you say, uncertainly.","isAppLine":false,"small":{"start":33.12,"end":35.2,"frac":1.0,"status":"ok","matched":4,"words":4},"large":{"start":33.12,"end":35.2,"frac":1.0,"status":"ok","matched":4,"words":4},"differ":false},{"i":5,"text":"“Oh, there you are!” he says, appearing from behind a tree. He puts the time machine down and approaches you, scratching his head.","isAppLine":false,"small":{"start":35.68,"end":41.344,"frac":1.0,"status":"ok","matched":23,"words":23},"large":{"start":35.68,"end":41.344,"frac":1.0,"status":"ok","matched":23,"words":23},"differ":false},{"i":6,"text":"“Where are we?” you say.","isAppLine":false,"small":{"start":41.568,"end":42.848,"frac":1.0,"status":"ok","matched":5,"words":5},"large":{"start":41.568,"end":42.848,"frac":1.0,"status":"ok","matched":5,"words":5},"differ":false},{"i":7,"text":"“You mean when are we? This is still Tarntanyangga. But it could be two hundred years ago, two thousand years ago… it could be twenty-thousand years ago!”","isAppLine":false,"small":{"start":43.136,"end":52.704,"frac":0.75,"status":"ok","matched":21,"words":28},"large":{"start":43.136,"end":52.68,"frac":0.75,"status":"ok","matched":21,"words":28},"differ":false},{"i":8,"text":"He sees you backing away and shields his eyes to look at the group running towards you. As they move through the trees, you realise they are barefoot, dressed only in animal skins.","isAppLine":false,"small":{"start":53.024,"end":61.92,"frac":0.97,"status":"ok","matched":32,"words":33},"large":{"start":53.024,"end":61.92,"frac":0.97,"status":"ok","matched":32,"words":33},"differ":false},{"i":9,"text":"“This must be a Kaurna tribe,” says the Professor. “After all, traditionally this is their land.” He smiles and opens his arms wide. “Hello!” he shouts.","isAppLine":false,"small":{"start":62.688,"end":73.184,"frac":0.923,"status":"ok","matched":24,"words":26},"large":{"start":62.688,"end":73.06,"frac":0.962,"status":"ok","matched":25,"words":26},"differ":false},{"i":10,"text":"There are men and women in the group, and children too. The oldest, a man with a beard, holds a wooden shield. He approaches you and looks you up and down.","isAppLine":false,"small":{"start":73.344,"end":81.568,"frac":1.0,"status":"ok","matched":31,"words":31},"large":{"start":73.344,"end":81.44,"frac":1.0,"status":"ok","matched":31,"words":31},"differ":false},{"i":11,"text":"He says something to you in a language you don’t recognise.","isAppLine":false,"small":{"start":81.76,"end":84.32,"frac":1.0,"status":"ok","matched":11,"words":11},"large":{"start":81.76,"end":84.28,"frac":1.0,"status":"ok","matched":11,"words":11},"differ":false},{"i":12,"text":"“What’s he saying?” you whisper to the Professor.","isAppLine":false,"small":{"start":84.608,"end":86.52,"frac":1.0,"status":"ok","matched":8,"words":8},"large":{"start":84.608,"end":86.46,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":false},{"i":13,"text":"“I don’t know!” he whispers back. “The early German missionaries tried to preserve the Kaurna language, but the English colonists weren’t interested, and knowledge of the language faded away. In our time there’s only fragments of the language known!”","isAppLine":false,"small":{"start":87.072,"end":102.656,"frac":0.974,"status":"ok","matched":38,"words":39},"large":{"start":87.072,"end":102.656,"frac":1.0,"status":"ok","matched":39,"words":39},"differ":false},{"i":14,"text":"The Kaurna elder talks more insistently at you, waving his shield.","isAppLine":false,"small":{"start":102.912,"end":106.336,"frac":0.909,"status":"ok","matched":10,"words":11},"large":{"start":102.912,"end":106.336,"frac":1.0,"status":"ok","matched":11,"words":11},"differ":false},{"i":15,"text":"“I think he wants us to go,” you say. You start to walk, cautiously, in the direction the group had come from.","isAppLine":false,"small":{"start":106.816,"end":111.92,"frac":1.0,"status":"ok","matched":22,"words":22},"large":{"start":106.816,"end":111.86,"frac":1.0,"status":"ok","matched":22,"words":22},"differ":false},{"i":16,"text":"But suddenly the elder grabs you by the arm, and starts talking insistently. If only you knew what he was saying!","isAppLine":false,"small":{"start":112.096,"end":117.184,"frac":1.0,"status":"ok","matched":21,"words":21},"large":{"start":112.096,"end":117.184,"frac":1.0,"status":"ok","matched":21,"words":21},"differ":false},{"i":17,"text":"“Does he want us to go, or not?” you say to the Professor. But then he lets go, and starts to run again. The group follows him, looking back over their shoulders at you.","isAppLine":false,"small":{"start":117.664,"end":125.76,"frac":1.0,"status":"ok","matched":34,"words":34},"large":{"start":117.664,"end":125.74,"frac":1.0,"status":"ok","matched":34,"words":34},"differ":false},{"i":18,"text":"Then you hear something. It’s like a low rumbling noise, and a whistling of air. You frown, squinting into the distance in the direction that the group had come from.","isAppLine":false,"small":{"start":125.984,"end":134.752,"frac":1.0,"status":"ok","matched":30,"words":30},"large":{"start":125.984,"end":134.752,"frac":1.0,"status":"ok","matched":30,"words":30},"differ":false},{"i":19,"text":"The air looks like it’s warping, twisting. Is the time machine malfunctioning again?","isAppLine":false,"small":{"start":135.2,"end":139.456,"frac":1.0,"status":"ok","matched":13,"words":13},"large":{"start":135.2,"end":139.456,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false},{"i":20,"text":"“You know,” says the Professor, frowning, “the Kaurna people were known to use a certain clever kind of farming technique. They would clear dead forest areas to make way for edible plants and animals.”","isAppLine":false,"small":{"start":139.68,"end":150.912,"frac":0.941,"status":"ok","matched":32,"words":34},"large":{"start":139.68,"end":150.912,"frac":0.941,"status":"ok","matched":32,"words":34},"differ":false},{"i":21,"text":"“How?” you ask, as you notice the air growing hotter.","isAppLine":false,"small":{"start":151.424,"end":154.688,"frac":1.0,"status":"ok","matched":10,"words":10},"large":{"start":151.424,"end":154.688,"frac":1.0,"status":"ok","matched":10,"words":10},"differ":false},{"i":22,"text":"“Fire!” shouts the Professor, and he grabs you. He pulls you towards a waterhole, drenching your clothes as he drags you into the muddy water. Now you can see the fire approaching. It roars through the grassland, turning everything in its path to black.","isAppLine":false,"small":{"start":155.136,"end":168.128,"frac":0.932,"status":"ok","matched":41,"words":44},"large":{"start":155.136,"end":168.128,"frac":0.955,"status":"ok","matched":42,"words":44},"differ":false},{"i":23,"text":"You plunge beneath the water and wait. Finally, when you can’t hold your breath any longer, you surface. The fire has swept through, leaving only the crackling embers and sparks of the bush around you. You breathe, heavily, glad to be safe.","isAppLine":false,"small":{"start":168.48,"end":184.896,"frac":0.952,"status":"ok","matched":40,"words":42},"large":{"start":168.48,"end":184.84,"frac":0.976,"status":"ok","matched":41,"words":42},"differ":false},{"i":24,"text":"Then you see the charred, melted, blackened remains of something: the time machine.","isAppLine":false,"small":{"start":185.248,"end":189.536,"frac":1.0,"status":"ok","matched":13,"words":13},"large":{"start":185.248,"end":189.536,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false},{"i":25,"text":"“Um,” says the Professor. “It looks like we might be here a while.”","isAppLine":false,"small":{"start":191.072,"end":195.616,"frac":1.0,"status":"ok","matched":13,"words":13},"large":{"start":190.624,"end":195.616,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false},{"i":26,"text":"~END~","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":1},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":1},"differ":false},{"i":27,"text":"Ouch! Bad Luck! This is the end of your adventure but you can head back to the starting point to explore a different story path, or you can try the other Story City: Adelaide adventure, Ready or Not: Hide & Seek Alien Style.","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":42},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":42},"differ":false},{"i":28,"text":"And don’t forget to upload a pic of you on your adventure to Facebook, Instagram or Twitter with the hashtags #StoryCity #TimeCaper","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":22},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":22},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/61de1b05b6fa4_BC13_final.jpg"}