0.062,0.053,0.044,0.05,0.03,0.032,0.024,0.015,0.019,0.015,0.009,0.012,0.01,0.007,0.007,0.004,0.002,0.002,0.001,0.0,0.0,0.0,0.0],"paragraphs":[{"i":0,"text":"The machine pops, squeaks and fizzes, and you find yourself leaping aside to avoid the wooden wheels of a boxy Ford Model T motor car as is trundles past you up Rundle Mall… no, wait, Rundle Street, according to the signs. The driver honks his horn.","isAppLine":false,"small":{"start":11.04,"end":25.12,"frac":0.935,"status":"ok","matched":43,"words":46},"large":{"start":11.04,"end":24.96,"frac":0.978,"status":"ok","matched":45,"words":46},"differ":false},{"i":1,"text":"“Cars!” gasps the Professor, fidgeting with the time machine. “At least it’s moving us in the right direction. Let’s see, my guess is about twenty years on, sometime in the 1920s…”","isAppLine":false,"small":{"start":26.912,"end":37.44,"frac":0.968,"status":"ok","matched":30,"words":31},"large":{"start":25.984,"end":37.38,"frac":0.935,"status":"ok","matched":29,"words":31},"differ":true},{"i":2,"text":"He points at the legs of a woman passing by, as she puffs on a cigarette in a long holder.","isAppLine":false,"small":{"start":37.664,"end":42.208,"frac":1.0,"status":"ok","matched":20,"words":20},"large":{"start":37.664,"end":42.208,"frac":1.0,"status":"ok","matched":20,"words":20},"differ":false},{"i":3,"text":"“Yes! It must be! Look, you can see her ankles!”","isAppLine":false,"small":{"start":42.496,"end":46.976,"frac":0.8,"status":"ok","matched":8,"words":10},"large":{"start":43.68,"end":46.88,"frac":1.0,"status":"ok","matched":10,"words":10},"differ":true},{"i":4,"text":"Before you can ask what this means, you’re startled by a loud shriek from the entrance to Regent Arcade.","isAppLine":false,"small":{"start":47.2,"end":52.544,"frac":0.789,"status":"ok","matched":15,"words":19},"large":{"start":47.2,"end":52.44,"frac":0.895,"status":"ok","matched":17,"words":19},"differ":false},{"i":5,"text":"A woman covered in long strings of pearls is pointing at you, her hand over her mouth.","isAppLine":false,"small":{"start":52.736,"end":57.08,"frac":1.0,"status":"ok","matched":17,"words":17},"large":{"start":52.736,"end":57.216,"frac":1.0,"status":"ok","matched":17,"words":17},"differ":false},{"i":6,"text":"“It’s you! It’s you!”","isAppLine":false,"small":{"start":57.664,"end":59.168,"frac":1.0,"status":"ok","matched":4,"words":4},"large":{"start":57.664,"end":59.06,"frac":1.0,"status":"ok","matched":4,"words":4},"differ":false},{"i":7,"text":"A gaggle of women rush to her side and stare at you, their mouths open wide, as you stare back, your mouth open even wider.","isAppLine":false,"small":{"start":59.424,"end":66.976,"frac":0.92,"status":"ok","matched":23,"words":25},"large":{"start":59.424,"end":66.86,"frac":0.92,"status":"ok","matched":23,"words":25},"differ":false},{"i":8,"text":"The Professor looks at you, confused. You stare up at the ornate front of Regent Arcade, and the archway above the entrance adorned with the words ‘100% ENTERTAINMENT ALWAYS, THEATRE MAGNIFICENT, CLASSIC BOER WAR FILMS’… wait a minute…","isAppLine":false,"small":{"start":67.168,"end":80.608,"frac":0.974,"status":"ok","matched":37,"words":38},"large":{"start":67.168,"end":80.56,"frac":1.0,"status":"ok","matched":38,"words":38},"differ":false},{"i":9,"text":"“Would you sign this?”","isAppLine":false,"small":{"start":80.96,"end":81.952,"frac":1.0,"status":"ok","matched":4,"words":4},"large":{"start":80.96,"end":81.94,"frac":1.0,"status":"ok","matched":4,"words":4},"differ":false},{"i":10,"text":"Wide-eyed women has crowd around you, proffering pens and small printed pictures. You take one and stare at it. It’s a blurry photograph, black-and-white, like a scene from a Charlie Chaplin film. It’s of a person with a look of utter confusion on their face, in front of a parade of soldiers, being grabbed by a Sergeant-Major. It’s you!","isAppLine":false,"small":{"start":82.272,"end":101.32,"frac":0.984,"status":"ok","matched":62,"words":63},"large":{"start":82.272,"end":101.472,"frac":0.984,"status":"ok","matched":62,"words":63},"differ":false},{"i":11,"text":"“Of course!” the Professor exclaims, snapping his fingers. “Its front looks the same, but it’s not Regent Arcade yet, it’s still the Regent Theatre… the grandest and most extravagant movie theatre in the whole of Australia! Movies are the biggest thing in the world right now. Remember the cinematographer? He must have been making a war film, and you…”","isAppLine":false,"small":{"start":101.952,"end":122.3,"frac":0.949,"status":"ok","matched":56,"words":59},"large":{"start":101.952,"end":122.1,"frac":1.0,"status":"ok","matched":59,"words":59},"differ":false},{"i":12,"text":"He takes one of the ladies’ pictures and holds it up, triumphant.","isAppLine":false,"small":{"start":122.3,"end":125.12,"frac":1.0,"status":"ok","matched":12,"words":12},"large":{"start":122.1,"end":125.12,"frac":1.0,"status":"ok","matched":12,"words":12},"differ":false},{"i":13,"text":"“You must be a silent movie star!”","isAppLine":false,"small":{"start":125.312,"end":127.872,"frac":1.0,"status":"ok","matched":7,"words":7},"large":{"start":125.312,"end":127.86,"frac":1.0,"status":"ok","matched":7,"words":7},"differ":false},{"i":14,"text":"You look at the expectant faces of the women around you. You swallow, nervously.","isAppLine":false,"small":{"start":128.064,"end":132.16,"frac":1.0,"status":"ok","matched":14,"words":14},"large":{"start":128.064,"end":132.16,"frac":1.0,"status":"ok","matched":14,"words":14},"differ":false},{"i":15,"text":"“Thank you?”","isAppLine":false,"small":{"start":133.472,"end":133.952,"frac":1.0,"status":"ok","matched":2,"words":2},"large":{"start":133.472,"end":133.952,"frac":1.0,"status":"ok","matched":2,"words":2},"differ":false},{"i":16,"text":"There is an awkward silence. Their faces fall. One short woman coughs.","isAppLine":false,"small":{"start":134.912,"end":139.38,"frac":1.0,"status":"ok","matched":12,"words":12},"large":{"start":134.912,"end":139.14,"frac":1.0,"status":"ok","matched":12,"words":12},"differ":false},{"i":17,"text":"Then she says, in a disappointed voice, “Is that how you really talk?”","isAppLine":false,"small":{"start":139.52,"end":143.424,"frac":0.923,"status":"ok","matched":12,"words":13},"large":{"start":139.52,"end":143.424,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false},{"i":18,"text":"A man in a suit and tie steps through the crowd.","isAppLine":false,"small":{"start":144.864,"end":147.6,"frac":1.0,"status":"ok","matched":11,"words":11},"large":{"start":144.864,"end":147.58,"frac":1.0,"status":"ok","matched":11,"words":11},"differ":false},{"i":19,"text":"“My dear friends, if I’d known we had movie stars in town I’d have welcomed you myself! Please, allow me to accompany you to Parliament House, where I’m sure the other members would be pleased to meet people of your calibre!”","isAppLine":false,"small":{"start":147.6,"end":158.96,"frac":1.0,"status":"ok","matched":41,"words":41},"large":{"start":147.58,"end":159.2,"frac":1.0,"status":"ok","matched":41,"words":41},"differ":false},{"i":20,"text":"The Professor starts to follow him.","isAppLine":false,"small":{"start":159.584,"end":160.96,"frac":1.0,"status":"ok","matched":6,"words":6},"large":{"start":159.584,"end":160.992,"frac":1.0,"status":"ok","matched":6,"words":6},"differ":false},{"i":21,"text":"“Professor!” you grab his arm. “Why do you follow every suggestion without thinking? We need to fix the machine! Shouldn’t we go somewhere where someone can help us, like… the University?”","isAppLine":false,"small":{"start":161.44,"end":172.256,"frac":1.0,"status":"ok","matched":31,"words":31},"large":{"start":161.44,"end":172.1,"frac":1.0,"status":"ok","matched":31,"words":31},"differ":false},{"i":22,"text":"The Professor gestures to the politician as he follows him towards Charles Street. “But we’re stars here! We might never have this opportunity again! Besides, I’m sure the worst of the time machine’s malfunctioning is over!”","isAppLine":false,"small":{"start":172.64,"end":184.8,"frac":1.0,"status":"ok","matched":36,"words":36},"large":{"start":172.64,"end":184.76,"frac":1.0,"status":"ok","matched":36,"words":36},"differ":false},{"i":23,"text":"You can see he won’t be persuaded, but do you think it’s safe to leave him?","isAppLine":false,"small":{"start":185.088,"end":188.48,"frac":1.0,"status":"ok","matched":16,"words":16},"large":{"start":185.088,"end":188.48,"frac":1.0,"status":"ok","matched":16,"words":16},"differ":false},{"i":24,"text":"Do you:","isAppLine":false,"small":{"start":190.496,"end":190.944,"frac":1.0,"status":"ok","matched":2,"words":2},"large":{"start":190.496,"end":190.944,"frac":1.0,"status":"ok","matched":2,"words":2},"differ":false},{"i":25,"text":"Parliament House (1925->1939) : Trust the Professor is right about the time machine settling. Then follow him and the politician to Parliament House on North Terrace.","isAppLine":false,"small":{"start":192.032,"end":198.56,"frac":0.846,"status":"ok","matched":22,"words":26},"large":{"start":192.032,"end":198.56,"frac":0.846,"status":"ok","matched":22,"words":26},"differ":false},{"i":26,"text":"Or","isAppLine":false,"small":{"start":199.392,"end":199.66,"frac":1.0,"status":"ok","matched":1,"words":1},"large":{"start":199.392,"end":199.78,"frac":1.0,"status":"ok","matched":1,"words":1},"differ":false},{"i":27,"text":"Elder Hall (1925->1908): Decide the Professor is nuts as well as unreliable. Then grab the time machine from the Professor and head towards the University on North Terrace, stopping at Elder Hall.","isAppLine":false,"small":{"start":200.256,"end":208.96,"frac":0.879,"status":"ok","matched":29,"words":33},"large":{"start":200.256,"end":208.96,"frac":0.879,"status":"ok","matched":29,"words":33},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/61de19b17bbc6_BC4_final.jpg"}