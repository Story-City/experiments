6,0.027,0.032,0.025,0.028,0.033,0.033,0.027,0.029,0.024,0.029,0.022,0.02,0.019,0.015,0.014,0.011,0.011,0.012,0.012,0.009,0.008,0.006,0.005,0.003,0.004,0.002,0.002,0.002,0.001,0.001],"paragraphs":[{"i":0,"text":"Alright, dark story it is. Let’s grab the stream’s attention!","isAppLine":false,"small":{"start":1.76,"end":6.624,"frac":1.0,"status":"ok","matched":10,"words":10},"large":{"start":1.76,"end":6.62,"frac":1.0,"status":"ok","matched":10,"words":10},"differ":false},{"i":1,"text":"\"This young woman was pursued by an entitled asshole, and when he couldn’t have her, she was shoved down a well. She got her revenge though; dragged him in with her. You’d think that’d be the end of it, but they built this place right on top of that well. She’s still here and she’s angry.\"","isAppLine":false,"small":{"start":7.232,"end":28.128,"frac":0.893,"status":"ok","matched":50,"words":56},"large":{"start":7.232,"end":28.16,"frac":1.0,"status":"ok","matched":56,"words":56},"differ":false},{"i":2,"text":"Okay I’m back!","isAppLine":false,"small":{"start":29.32,"end":31.776,"frac":1.0,"status":"ok","matched":3,"words":3},"large":{"start":31.2,"end":31.776,"frac":1.0,"status":"ok","matched":3,"words":3},"differ":true},{"i":3,"text":"That weight you’re feeling? That’s it. Channel your EP. Stir it with the emotion the chat’s feeding you. Then push it toward the window.","isAppLine":false,"small":{"start":32.384,"end":40.992,"frac":1.0,"status":"ok","matched":24,"words":24},"large":{"start":32.384,"end":40.992,"frac":1.0,"status":"ok","matched":24,"words":24},"differ":false},{"i":4,"text":"And hey, don’t forget to snap a shot of yourself in-frame with the manifest. It makes a perfect shareable moment for the channel homepage.","isAppLine":false,"small":{"start":43.168,"end":49.696,"frac":1.0,"status":"ok","matched":25,"words":25},"large":{"start":43.168,"end":49.68,"frac":1.0,"status":"ok","matched":25,"words":25},"differ":false},{"i":5,"text":"Yep that button just on the screen. Trust me, people love that combo of you + ghost.","isAppLine":false,"small":{"start":50.08,"end":54.88,"frac":0.938,"status":"ok","matched":15,"words":16},"large":{"start":50.08,"end":55.008,"frac":0.938,"status":"ok","matched":15,"words":16},"differ":false},{"i":6,"text":"That’s what I’m talking about. You see that water trail? It’s vicious . Off-kilter, heavy. You captured the rage perfectly. That’s advanced work.","isAppLine":false,"small":{"start":54.88,"end":67.24,"frac":1.0,"status":"ok","matched":23,"words":23},"large":{"start":57.408,"end":67.456,"frac":1.0,"status":"ok","matched":23,"words":23},"differ":true},{"i":7,"text":"Hold. Let the audience feel it.","isAppLine":false,"small":{"start":68.256,"end":70.98,"frac":1.0,"status":"ok","matched":6,"words":6},"large":{"start":68.256,"end":70.944,"frac":1.0,"status":"ok","matched":6,"words":6},"differ":false},{"i":8,"text":"Once you’ve got it clipped, tap the chat. Let’s see if it hit.","isAppLine":false,"small":{"start":72.0,"end":75.776,"frac":1.0,"status":"ok","matched":13,"words":13},"large":{"start":72.0,"end":75.776,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/689a6474708ed.jpg"}