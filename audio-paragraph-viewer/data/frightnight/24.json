,0.063,0.055,0.054,0.055,0.044,0.041,0.043,0.039,0.034,0.032,0.026,0.025,0.021,0.019,0.017,0.016,0.015,0.012,0.01,0.008,0.007,0.006,0.003,0.002,0.002,0.001,0.001,0.001,0.0,0.0,0.0,0.0],"paragraphs":[{"i":0,"text":"Man, transit stops, am I right rookie?","isAppLine":false,"small":{"start":0.288,"end":2.528,"frac":1.0,"status":"ok","matched":7,"words":7},"large":{"start":0.288,"end":2.52,"frac":1.0,"status":"ok","matched":7,"words":7},"differ":false},{"i":1,"text":"Boring but Spiritual Energy’s thick here. Not shocking. People rushing to get places, stress hanging in the air… perfect conditions for spiritual buildup.","isAppLine":false,"small":{"start":2.752,"end":13.14,"frac":1.0,"status":"ok","matched":23,"words":23},"large":{"start":2.752,"end":13.12,"frac":1.0,"status":"ok","matched":23,"words":23},"differ":false},{"i":2,"text":"Let me get the audience set.","isAppLine":false,"small":{"start":13.632,"end":14.688,"frac":1.0,"status":"ok","matched":6,"words":6},"large":{"start":13.632,"end":14.688,"frac":1.0,"status":"ok","matched":6,"words":6},"differ":false},{"i":3,"text":"\"Ever been at a transit stop that just felt… wrong? Reversed letters, strange amenities, security guards that walk a little too stiff? You might be in a station that isn’t ‘yours’. For me, the smell here is wrong. We can find our way back, but we’ve got to be careful—because not everything is what it seems.\"","isAppLine":false,"small":{"start":16.096,"end":38.368,"frac":1.0,"status":"ok","matched":57,"words":57},"large":{"start":16.096,"end":38.368,"frac":1.0,"status":"ok","matched":57,"words":57},"differ":false},{"i":4,"text":"Okay, you know the drill—quick vibe check, tap the screen for a quick scan of the chat.","isAppLine":false,"small":{"start":39.712,"end":44.64,"frac":1.0,"status":"ok","matched":18,"words":18},"large":{"start":39.712,"end":44.64,"frac":1.0,"status":"ok","matched":18,"words":18},"differ":false},{"i":5,"text":"Let’s see which story plays best for both.","isAppLine":false,"small":{"start":45.824,"end":47.648,"frac":1.0,"status":"ok","matched":8,"words":8},"large":{"start":45.824,"end":47.648,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/68e820da8241d_Beat%20L4_1a_v3.png"}