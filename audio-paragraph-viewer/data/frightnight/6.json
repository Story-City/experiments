002,0.003,0.003,0.003,0.002,0.002,0.002,0.001,0.001,0.002,0.001,0.002,0.002,0.002,0.001,0.001,0.001,0.002,0.001,0.001,0.001,0.001,0.001,0.001,0.001,0.001,0.001,0.001],"paragraphs":[{"i":0,"text":"Classic spooky. Solid vibe-match. Alright, here's how it’ll go when we’re live. I’ll tell the story to the audience while you channel the energy.","isAppLine":false,"small":{"start":0.448,"end":8.064,"frac":1.0,"status":"ok","matched":25,"words":25},"large":{"start":0.448,"end":7.66,"frac":1.0,"status":"ok","matched":25,"words":25},"differ":false},{"i":1,"text":"For now, let’s practice like we’re already rolling. Camera on the mural, EP at the ready.","isAppLine":false,"small":{"start":8.288,"end":13.248,"frac":1.0,"status":"ok","matched":16,"words":16},"large":{"start":8.288,"end":13.04,"frac":1.0,"status":"ok","matched":16,"words":16},"differ":false},{"i":2,"text":"\"Ahem. You might see a man standing here, staring at this mural at odd hours. They say in life, he stopped and was so captivated, he didn’t realize death had taken him while watching.\"","isAppLine":false,"small":{"start":15.744,"end":29.696,"frac":1.0,"status":"ok","matched":34,"words":34},"large":{"start":13.04,"end":29.696,"frac":0.971,"status":"ok","matched":33,"words":34},"differ":true},{"i":3,"text":"All setup. Now you!","isAppLine":false,"small":{"start":31.264,"end":33.056,"frac":0.75,"status":"ok","matched":3,"words":4},"large":{"start":31.264,"end":32.9,"frac":0.75,"status":"ok","matched":3,"words":4},"differ":false},{"i":4,"text":"Check the flow… the Spiritual Energy’s loosening… yep, right on cue. Shape it… good… ooh nice ghostly figure! And when you’ve got a grip, dismiss.","isAppLine":false,"small":{"start":33.536,"end":46.36,"frac":1.0,"status":"ok","matched":25,"words":25},"large":{"start":33.536,"end":46.28,"frac":1.0,"status":"ok","matched":25,"words":25},"differ":false},{"i":5,"text":"Boom. That’s a textbook manifest and release.","isAppLine":false,"small":{"start":47.84,"end":51.42,"frac":1.0,"status":"ok","matched":7,"words":7},"large":{"start":47.84,"end":51.14,"frac":1.0,"status":"ok","matched":7,"words":7},"differ":false},{"i":6,"text":"You did use some EP though. Without the real chat to super charge it, that happens during practice. Don’t worry, we’re not in any danger yet.","isAppLine":false,"small":{"start":51.42,"end":58.336,"frac":0.923,"status":"ok","matched":24,"words":26},"large":{"start":51.14,"end":58.12,"frac":0.923,"status":"ok","matched":24,"words":26},"differ":false},{"i":7,"text":"Just keep an eye on those energy reserves. Too many power drains on a real tour and you’re open to... nastier stuff.","isAppLine":false,"small":{"start":58.784,"end":65.856,"frac":1.0,"status":"ok","matched":22,"words":22},"large":{"start":58.784,"end":65.54,"frac":1.0,"status":"ok","matched":22,"words":22},"differ":false},{"i":8,"text":"But get enough audience energy to power up your EP at later stops and you can recoup those reserves.","isAppLine":false,"small":{"start":66.496,"end":71.008,"frac":1.0,"status":"ok","matched":19,"words":19},"large":{"start":66.496,"end":71.008,"frac":1.0,"status":"ok","matched":19,"words":19},"differ":false},{"i":9,"text":"Alright, stream countdown’s starting. Open the app and go live when you’re ready.","isAppLine":false,"small":{"start":71.936,"end":77.472,"frac":1.0,"status":"ok","matched":13,"words":13},"large":{"start":71.936,"end":77.472,"frac":1.0,"status":"ok","matched":13,"words":13},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/68ddb5c2a8691_Beat%20L1_1ee.png"}