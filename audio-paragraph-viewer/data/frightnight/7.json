35,0.032,0.027,0.034,0.034,0.028,0.016,0.021,0.014,0.016,0.015,0.012,0.012,0.017,0.015,0.014,0.01,0.008,0.005,0.005,0.006,0.006,0.005,0.004,0.003,0.002,0.002,0.003,0.002,0.002,0.001,0.001,0.001],"paragraphs":[{"i":0,"text":"Ooh, uplifting choice, love that! When we’re live, I’ll narrate the story for the audience, and you’ll do the heavy lifting with the manifestation.","isAppLine":false,"small":{"start":0.32,"end":7.904,"frac":0.958,"status":"ok","matched":23,"words":24},"large":{"start":0.32,"end":7.78,"frac":0.958,"status":"ok","matched":23,"words":24},"differ":false},{"i":1,"text":"But since this is still warm-up mode, let’s walk through like the chat’s watching. Camera up. EP ready.","isAppLine":false,"small":{"start":8.256,"end":15.072,"frac":1.0,"status":"ok","matched":19,"words":19},"large":{"start":8.256,"end":15.072,"frac":1.0,"status":"ok","matched":19,"words":19},"differ":false},{"i":2,"text":"\"They say there’s a benevolent spirit here, one that grants inspiration to those in need of guidance. Artists come here with their tools: pen, chalk, tablet; and find their hands moving as if guided by something unseen.\"","isAppLine":false,"small":{"start":15.904,"end":31.744,"frac":1.0,"status":"ok","matched":37,"words":37},"large":{"start":15.904,"end":31.32,"frac":1.0,"status":"ok","matched":37,"words":37},"differ":false},{"i":3,"text":"Your turn.","isAppLine":false,"small":{"start":33.152,"end":33.76,"frac":1.0,"status":"ok","matched":2,"words":2},"large":{"start":31.32,"end":33.48,"frac":1.0,"status":"ok","matched":2,"words":2},"differ":true},{"i":4,"text":"Now manipulate the energy with your EP. See it? It’s forming... a ghostly paintbrush. That’s good. Solid control. Lock it in, and… dismiss!","isAppLine":false,"small":{"start":34.144,"end":47.92,"frac":1.0,"status":"ok","matched":23,"words":23},"large":{"start":34.144,"end":47.76,"frac":1.0,"status":"ok","matched":23,"words":23},"differ":false},{"i":5,"text":"Done! Another clean exorcism. EP took a light hit, but that’s expected during solo practice. If the chat was live, you might’ve gotten a free ride by using their energy instead.","isAppLine":false,"small":{"start":50.144,"end":61.152,"frac":1.0,"status":"ok","matched":31,"words":31},"large":{"start":47.76,"end":61.152,"frac":1.0,"status":"ok","matched":31,"words":31},"differ":true},{"i":6,"text":"Just keep in mind: in the real deal, draining too much EP back-to-back? That’s when things can go sideways.","isAppLine":false,"small":{"start":61.696,"end":68.032,"frac":1.0,"status":"ok","matched":21,"words":21},"large":{"start":61.696,"end":68.032,"frac":1.0,"status":"ok","matched":21,"words":21},"differ":false},{"i":7,"text":"But get enough audience energy to power up your EP at later stops and you can recoup those reserves.","isAppLine":false,"small":{"start":68.512,"end":73.152,"frac":1.0,"status":"ok","matched":19,"words":19},"large":{"start":68.512,"end":73.06,"frac":1.0,"status":"ok","matched":19,"words":19},"differ":false},{"i":8,"text":"So balance is key.","isAppLine":false,"small":{"start":73.408,"end":74.56,"frac":1.0,"status":"ok","matched":4,"words":4},"large":{"start":73.408,"end":74.56,"frac":1.0,"status":"ok","matched":4,"words":4},"differ":false},{"i":9,"text":"Oop! That was the stream countdown. Open the app, and let’s go live.","isAppLine":false,"small":{"start":75.264,"end":80.992,"frac":0.923,"status":"ok","matched":12,"words":13},"large":{"start":75.264,"end":80.992,"frac":0.923,"status":"ok","matched":12,"words":13},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/68cd98188c6b2_Beat%20L1-1eee.png"}