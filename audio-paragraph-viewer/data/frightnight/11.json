04,0.042,0.04,0.038,0.045,0.035,0.033,0.034,0.034,0.028,0.021,0.014,0.012,0.013,0.011,0.008,0.004,0.003,0.003,0.003,0.003,0.003,0.002,0.002,0.001,0.0,0.0,0.0,0.0],"paragraphs":[{"i":0,"text":"Alright, a gentle soul here. I dig. I’ll set the scene for the stream, you focus on the manifest.","isAppLine":false,"small":{"start":2.752,"end":9.376,"frac":0.947,"status":"ok","matched":18,"words":19},"large":{"start":2.752,"end":9.376,"frac":0.947,"status":"ok","matched":18,"words":19},"differ":false},{"i":1,"text":"\"She just wanted a place of her own… and even in death, she kept it. Staff say she still moves things - combs, books, mirrors - back to where she liked them. Turn your back, and they vanish. Blink twice, and they appear exactly where she left them in life.\"","isAppLine":false,"small":{"start":11.264,"end":33.8,"frac":0.958,"status":"ok","matched":46,"words":48},"large":{"start":11.264,"end":33.76,"frac":0.979,"status":"ok","matched":47,"words":48},"differ":false},{"i":2,"text":"Okay I’m back.","isAppLine":false,"small":{"start":33.8,"end":36.54,"frac":1.0,"status":"ok","matched":3,"words":3},"large":{"start":36.032,"end":36.608,"frac":1.0,"status":"ok","matched":3,"words":3},"differ":true},{"i":3,"text":"Now find that warm spark inside you. That’s your EP. Pull what you can from the belief trickling in from the audience.","isAppLine":false,"small":{"start":37.088,"end":43.904,"frac":1.0,"status":"ok","matched":22,"words":22},"large":{"start":37.088,"end":43.904,"frac":1.0,"status":"ok","matched":22,"words":22},"differ":false},{"i":4,"text":"Alright, go for the manifest.","isAppLine":false,"small":{"start":44.416,"end":45.7,"frac":1.0,"status":"ok","matched":5,"words":5},"large":{"start":44.416,"end":45.94,"frac":1.0,"status":"ok","matched":5,"words":5},"differ":false},{"i":5,"text":"And remember, get a photo of yourself with it in the frame. Yep the button on your screen, hit it now. That’ll make a killer replay clip for the channel homepage.","isAppLine":false,"small":{"start":46.432,"end":54.752,"frac":0.968,"status":"ok","matched":30,"words":31},"large":{"start":46.432,"end":54.752,"frac":1.0,"status":"ok","matched":31,"words":31},"differ":false},{"i":6,"text":"Yes! That’s it. The face in the window; soft, delicate, just out of reach. That’s a beautiful read on the energy here. Really nice work.","isAppLine":false,"small":{"start":55.744,"end":64.512,"frac":1.0,"status":"ok","matched":25,"words":25},"large":{"start":55.744,"end":64.512,"frac":1.0,"status":"ok","matched":25,"words":25},"differ":false},{"i":7,"text":"Hold the shot. Let the stream drink it in.","isAppLine":false,"small":{"start":65.056,"end":67.808,"frac":1.0,"status":"ok","matched":9,"words":9},"large":{"start":65.056,"end":67.808,"frac":1.0,"status":"ok","matched":9,"words":9},"differ":false},{"i":8,"text":"Now let’s expand the chat on screen to see how it landed.","isAppLine":false,"small":{"start":71.04,"end":73.888,"frac":1.0,"status":"ok","matched":12,"words":12},"large":{"start":71.04,"end":73.888,"frac":1.0,"status":"ok","matched":12,"words":12},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/689a647407066.jpg"}