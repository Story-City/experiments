9,0.012,0.01,0.014,0.015,0.011,0.01,0.01,0.009,0.006,0.008,0.005,0.008,0.007,0.007,0.007,0.005,0.004,0.004,0.005,0.004,0.002,0.002,0.002,0.002,0.001,0.001,0.001,0.0,0.0,0.0,0.0],"paragraphs":[{"i":0,"text":"Alright rookie, we’re live and on location. This old building is packed with history and practically humming with Spiritual Energy. More active than the mural, so stay sharp.","isAppLine":false,"small":{"start":1.376,"end":12.032,"frac":1.0,"status":"ok","matched":28,"words":28},"large":{"start":1.376,"end":12.032,"frac":1.0,"status":"ok","matched":28,"words":28},"differ":false},{"i":1,"text":"This is your first chance to combine the site’s vibes and the chat’s mood. That’s the key.","isAppLine":false,"small":{"start":12.544,"end":17.984,"frac":1.0,"status":"ok","matched":17,"words":17},"large":{"start":12.544,"end":17.76,"frac":1.0,"status":"ok","matched":17,"words":17},"differ":false},{"i":2,"text":"If you want a clean exorcism without draining your EP, you’ve got to pick the story that hits both.","isAppLine":false,"small":{"start":18.208,"end":23.296,"frac":0.842,"status":"ok","matched":16,"words":19},"large":{"start":18.208,"end":23.24,"frac":1.0,"status":"ok","matched":19,"words":19},"differ":false},{"i":3,"text":"Let me just set this up with the audience real quick.","isAppLine":false,"small":{"start":23.68,"end":25.76,"frac":1.0,"status":"ok","matched":11,"words":11},"large":{"start":23.68,"end":25.76,"frac":1.0,"status":"ok","matched":11,"words":11},"differ":false},{"i":4,"text":"\"Welcome to our first location! See that window there? They say a woman can be seen from it. A classic Lady in White, who they say once owned this building.\"","isAppLine":false,"small":{"start":28.512,"end":40.96,"frac":1.0,"status":"ok","matched":30,"words":30},"large":{"start":28.512,"end":40.96,"frac":1.0,"status":"ok","matched":30,"words":30},"differ":false},{"i":5,"text":"Okay rookie, it’s your time to shine. Open up your senses, what are the location vibes? Then check the chat window on screen.","isAppLine":false,"small":{"start":44.0,"end":52.512,"frac":1.0,"status":"ok","matched":23,"words":23},"large":{"start":44.0,"end":52.5,"frac":1.0,"status":"ok","matched":23,"words":23},"differ":false},{"i":6,"text":"Use both to decide which story I should tell from the prompts on your screen too.","isAppLine":false,"small":{"start":52.928,"end":56.8,"frac":0.938,"status":"ok","matched":15,"words":16},"large":{"start":52.928,"end":56.8,"frac":0.938,"status":"ok","matched":15,"words":16},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/68e5342852c12_Fright_cover_illustration%20%281%29.png"}