0.009,0.007,0.006,0.006,0.005,0.005,0.005,0.006,0.006,0.006,0.006,0.005,0.005,0.006,0.005,0.005,0.004,0.005,0.006,0.005,0.004,0.004,0.003,0.004,0.003,0.003,0.002,0.002],"paragraphs":[{"i":0,"text":"Let’s set the record straight: ghosts don’t just appear. They’re made. From emotion, imagination, and belief. Humans dump all that energy into a place, and boom: Spiritual Energy congeals. And those creepy vibes? They make for a poltergeist buffet.","isAppLine":false,"small":{"start":0.16,"end":18.688,"frac":1.0,"status":"ok","matched":39,"words":39},"large":{"start":0.16,"end":18.6,"frac":1.0,"status":"ok","matched":39,"words":39},"differ":false},{"i":1,"text":"So what do we do? We shape the Spiritual Energy before it shapes itself. We tell stories the audience believes could be true—and that belief? It powers up your EP, Exorcist Powers, and helps you wrangle the energy before it manifests into something real, something dangerous.","isAppLine":false,"small":{"start":19.04,"end":36.992,"frac":0.979,"status":"ok","matched":46,"words":47},"large":{"start":19.04,"end":36.992,"frac":0.979,"status":"ok","matched":46,"words":47},"differ":false},{"i":2,"text":"Now here’s where your instincts kick in. At every stop, you’ll have to pick the best story to tell, and it’s your job to decide which one will hit hardest.","isAppLine":false,"small":{"start":37.44,"end":46.208,"frac":1.0,"status":"ok","matched":30,"words":30},"large":{"start":37.44,"end":46.14,"frac":1.0,"status":"ok","matched":30,"words":30},"differ":false},{"i":3,"text":"To do that, you’ll use two things:","isAppLine":false,"small":{"start":46.496,"end":48.22,"frac":1.0,"status":"ok","matched":7,"words":7},"large":{"start":46.496,"end":48.04,"frac":1.0,"status":"ok","matched":7,"words":7},"differ":false},{"i":4,"text":"one, your read on the vibes of the location itself.","isAppLine":false,"small":{"start":48.22,"end":51.1,"frac":0.9,"status":"ok","matched":9,"words":10},"large":{"start":48.04,"end":50.74,"frac":0.9,"status":"ok","matched":9,"words":10},"differ":false},{"i":5,"text":"And two, the mood of the chat .","isAppLine":false,"small":{"start":51.1,"end":53.24,"frac":1.0,"status":"ok","matched":7,"words":7},"large":{"start":50.74,"end":53.38,"frac":1.0,"status":"ok","matched":7,"words":7},"differ":false},{"i":6,"text":"Both are crucial. A spooky place with a silly chat? You’ve got to split the difference or lean one way hard.","isAppLine":false,"small":{"start":53.664,"end":61.056,"frac":1.0,"status":"ok","matched":21,"words":21},"large":{"start":53.664,"end":61.04,"frac":1.0,"status":"ok","matched":21,"words":21},"differ":false},{"i":7,"text":"For this warm-up, open your app and take a look at those prepped story prompts. Tune in to what the mural’s giving off. What matches?","isAppLine":false,"small":{"start":61.376,"end":69.504,"frac":1.0,"status":"ok","matched":26,"words":26},"large":{"start":61.376,"end":69.4,"frac":1.0,"status":"ok","matched":26,"words":26},"differ":false},{"i":8,"text":"No chat yet, but get in the habit.","isAppLine":false,"small":{"start":69.792,"end":71.648,"frac":1.0,"status":"ok","matched":8,"words":8},"large":{"start":69.792,"end":71.648,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":false},{"i":9,"text":"Every time we stop, you check both: vibe and audience .\"","isAppLine":false,"small":{"start":72.192,"end":76.576,"frac":1.0,"status":"ok","matched":10,"words":10},"large":{"start":72.192,"end":76.576,"frac":1.0,"status":"ok","matched":10,"words":10},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/68cbad80d2e98_entity%20appears.png"}