h, chef’s kiss, feeds straight into your EP reserves. That’s Exorcist Power, if you wanna sound cool.","isAppLine":false,"small":{"start":35.008,"end":45.3,"frac":0.923,"status":"ok","matched":24,"words":26},"large":{"start":35.008,"end":44.94,"frac":0.962,"status":"ok","matched":25,"words":26},"differ":false},{"i":6,"text":"Which you do.","isAppLine":false,"small":{"start":45.3,"end":46.048,"frac":1.0,"status":"ok","matched":3,"words":3},"large":{"start":44.94,"end":46.048,"frac":1.0,"status":"ok","matched":3,"words":3},"differ":false},{"i":7,"text":"Aherm. Anyway. You understand ghost explorations may be dangerous and you agree you do so at your own risk.","isAppLine":false,"small":{"start":46.464,"end":55.68,"frac":0.947,"status":"ok","matched":18,"words":19},"large":{"start":46.464,"end":55.46,"frac":0.947,"status":"ok","matched":18,"words":19},"differ":false}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/68e8200120367_disclaimer_v2.png"}