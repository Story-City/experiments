,0.012,0.012,0.012,0.012,0.012,0.014,0.014,0.013,0.011,0.012,0.013,0.013,0.013,0.013,0.013,0.012,0.011,0.011,0.011,0.012,0.011,0.01,0.01,0.009,0.009,0.008,0.008,0.006,0.007,0.007],"paragraphs":[{"i":0,"text":"Don’t panic, Rookie. Even the best ghost hunters get the occasional tech haunt. Before you assume you’ve attracted a poltergeist in your phone, try these simple exorcisms 👇","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":27},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":27},"differ":false},{"i":1,"text":"Check your Autoplay Audio settings.","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":5},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":5},"differ":false},{"i":2,"text":"Tap the three dots (top right corner) → Settings → toggle Autoplay Audio ON .","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":12},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":12},"differ":false},{"i":3,"text":"If you’d rather trigger the haunt manually, just tap the “Play” button whenever it appears on screen in the app.","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":20},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":20},"differ":false},{"i":4,"text":"Still quiet? Make sure your volume’s up . Happens to the best of us. Ghosts aren’t the only ones that can be eerily silent.","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":23},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":23},"differ":false},{"i":5,"text":"Check your Bluetooth .","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":3},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":3},"differ":false},{"i":6,"text":"Sometimes your phone connects to your car or speaker without permission (rude).","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":12},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":12},"differ":false},{"i":7,"text":"Either turn off Bluetooth or re-pair your intended device. Follow your manufacturer’s ritual… er, instructions .","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":16},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":16},"differ":false},{"i":8,"text":"This adventure is geo-locked , Rookie! That means I only unlock new story beats once you’ve reached the next haunted location or completed the on-screen action.","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":27},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":27},"differ":false},{"i":9,"text":"👉 Make sure you’ve granted the app permission to access your location.","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":11},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":11},"differ":false},{"i":10,"text":"Head to your phone’s Settings → Apps → Story City , and check your Location permissions . Set them to “While app is in use” or “Always on.”","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":24},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":24},"differ":false},{"i":11,"text":"Don’t worry, we only track your location while the app is open . Once you close it, your coordinates fade back into the digital mist. No permission, no exorcism. Even I can’t override the laws of tech sorcery.","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":37},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":37},"differ":false},{"i":12,"text":"Pro tip: plug in a portable charger or use an external speaker/headphones — it saves battery and makes it easier to hear my ghostly wisdom.","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":25},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":25},"differ":false},{"i":13,"text":"No worries — your eyes can lead where your ears can’t. Every line of dialogue is transcribed on screen , so you’ll never miss a clue or a joke, even if the spirits steal your sound.","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":34},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":34},"differ":false},{"i":14,"text":"If all else fails, take a deep breath, restart the app, and remember: sometimes, tech glitches are just ghosts trying to subscribe to your livestream.","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":25},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":25},"differ":false},{"i":15,"text":"Let's try this test again...","isAppLine":false,"small":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":5},"large":{"start":null,"end":null,"frac":0.0,"status":"unmatched","matched":0,"words":5},"differ":false}],"unassigned":{"small":[{"start":0.0,"end":3.82,"words":16,"text":"hey can you hear me tap the button on the phone if you can hear me"}],"large":[{"start":0.0,"end":3.74,"words":16,"text":"hey can you hear me tap the button on the phone if you can hear me"}]},"image":"https://creator.storycity.app/media/68e81f8b36ff2_Fright_cover_il