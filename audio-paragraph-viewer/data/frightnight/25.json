.058,0.051,0.041,0.033,0.036,0.034,0.033,0.029,0.032,0.033,0.028,0.024,0.021,0.016,0.016,0.017,0.015,0.012,0.012,0.011,0.011,0.008,0.007,0.006,0.004,0.004,0.004,0.003,0.003,0.002,0.002,0.001,0.001,0.001,0.001,0.001,0.001],"paragraphs":[{"i":0,"text":"We’re on guard duty, I like it.","isAppLine":false,"small":{"start":4.352,"end":6.1,"frac":1.0,"status":"ok","matched":7,"words":7},"large":{"start":4.352,"end":6.0,"frac":1.0,"status":"ok","matched":7,"words":7},"differ":false},{"i":1,"text":"I’ll keep the stream hooked, you manifest.","isAppLine":false,"small":{"start":6.1,"end":8.608,"frac":0.857,"status":"ok","matched":6,"words":7},"large":{"start":6.0,"end":8.608,"frac":1.0,"status":"ok","matched":7,"words":7},"differ":false},{"i":2,"text":"\"We might be approached by a security guard, and he may just be a guy. But look for the tells—a reversed name tag, off-coloured nails, maybe pointed teeth. He’ll offer to take us one way, but we go the opposite. Oh, here we go… here we go.”","isAppLine":false,"small":{"start":10.048,"end":29.632,"frac":1.0,"status":"ok","matched":49,"words":49},"large":{"start":10.048,"end":29.632,"frac":1.0,"status":"ok","matched":49,"words":49},"differ":false},{"i":3,"text":"Can you feel the Energy building behind you? Channel your EP, blend it with the audience’s buzz. Shadowy figure, and… the sound of Footsteps? Good work!","isAppLine":false,"small":{"start":31.104,"end":41.984,"frac":0.962,"status":"ok","matched":25,"words":26},"large":{"start":31.104,"end":41.984,"frac":0.962,"status":"ok","matched":25,"words":26},"differ":false},{"i":4,"text":"Turn the camera toward yourself—clip button ready.","isAppLine":false,"small":{"start":43.552,"end":45.824,"frac":1.0,"status":"ok","matched":8,"words":8},"large":{"start":43.552,"end":45.824,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":false},{"i":5,"text":"\"Hello there. Are you lost? I can escort you to wherever you need to go.\"","isAppLine":false,"small":{"start":46.88,"end":51.5,"frac":1.0,"status":"ok","matched":15,"words":15},"large":{"start":46.88,"end":51.648,"frac":1.0,"status":"ok","matched":15,"words":15},"differ":false},{"i":6,"text":"Holy shit you made him speak!? Niccee.","isAppLine":false,"small":{"start":52.288,"end":54.96,"frac":1.0,"status":"ok","matched":7,"words":7},"large":{"start":52.288,"end":54.8,"frac":1.0,"status":"ok","matched":7,"words":7},"differ":false},{"i":7,"text":"Alright, rookie—let’s see what the chat thinks.","isAppLine":false,"small":{"start":55.42,"end":58.24,"frac":1.0,"status":"ok","matched":8,"words":8},"large":{"start":54.816,"end":57.9,"frac":1.0,"status":"ok","matched":8,"words":8},"differ":true},{"i":8,"text":"Tap to expand.","isAppLine":false,"small":{"start":59.616,"end":60.544,"frac":1.0,"status":"ok","matched":3,"words":3},"large":{"start":57.9,"end":60.544,"frac":1.0,"status":"ok","matched":3,"words":3},"differ":true}],"unassigned":{"small":[],"large":[]},"image":"https://creator.storycity.app/media/68e821b88727c_Beat%20L4_2a.png"}